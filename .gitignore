# Dependencies and package manager cache
/node_modules/
/node_modules/.cache/

# Build output
/dist/
/build/

# Generated fixture artifacts. Track the BPMN XML (compiler output = "bpmn 代码") and its
# rendered PNG side-by-side so layout changes are reviewable in git. Run `bun run fixtures:sync`
# after any layout change to regenerate both. Other out-* dirs stay placeholder-only.
/out/
/out-*/
!/out-xml/
/out-xml/**
!/out-xml/*.bpmn
/out-xml/zzfuzz-*.bpmn
!/out-bpmn-png/
/out-bpmn-png/**
!/out-bpmn-png/*.png
/out-bpmn-png/zzfuzz-*.png
!/out-ai-debug/
/out-ai-debug/**
!/out-ai-debug/.keep

# layout-loop skill 的临时探针 fixture（report-only，跑完清理/升级；勿入库）
/fixtures/zzfuzz-*.json

# Local planning scratch files should stay out of the package docs.
/docs/plans/

# Local environment / credentials. Never commit.
.env
.env.*
!.env.example

# Logs and local OS/editor noise
.DS_Store
*.log
bun.lockb

# Legacy JVM/archive leftovers should not be part of the Bun/TypeScript package.
/tramito-layout/
/tramito-layout-archive/
/.gradle/
/.kotlin/
*.class
*.jar
