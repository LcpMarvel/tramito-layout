          "labels": [{ "text": "记录支付异常" }]
        },
        {
          "id": "sub_refund",
          "width": 100, "height": 80,
          "bpmn": { "type": "subProcess", "name": "退款处理", "isExpanded": true },
          "labels": [{ "text": "退款处理" }],
          "layoutOptions": {
            "elk.algorithm": "layered",
            "elk.direction": "RIGHT",
            "elk.padding": "[top=40,left=20,bottom=20,right=20]"
          },
          "children": [
            {
              "id": "refund_start",
              "width": 36, "height": 36,
              "bpmn": { "type": "startEvent", "eventDefinitionType": "none", "name": "开始退款" },
              "labels": [{ "text": "开始退款" }]
            },
            {
              "id": "refund_task_freeze",
              "width": 100, "height": 80,
              "bpmn": { "type": "serviceTask", "name": "冻结订单" },
              "labels": [{ "text": "冻结订单" }]
            },
            {
              "id": "refund_task_return",
              "width": 100, "height": 80,
              "bpmn": { "type": "serviceTask", "name": "退回已扣款项" },
              "labels": [{ "text": "退回已扣款项" }]
            },
            {
              "id": "refund_end",
              "width": 36, "height": 36,
              "bpmn": { "type": "endEvent", "eventDefinitionType": "none", "name": "退款完成" },
              "labels": [{ "text": "退款完成" }]
            }
          ],
          "edges": [
            { "id": "refund_flow_1", "sources": ["refund_start"], "targets": ["refund_task_freeze"], "bpmn": { "type": "sequenceFlow" } },
            { "id": "refund_flow_2", "sources": ["refund_task_freeze"], "targets": ["refund_task_return"], "bpmn": { "type": "sequenceFlow" } },
            { "id": "refund_flow_3", "sources": ["refund_task_return"], "targets": ["refund_end"], "bpmn": { "type": "sequenceFlow" } }
          ]
        },
        {
          "id": "task_notify_customer",
          "width": 100, "height": 80,
          "bpmn": { "type": "serviceTask", "name": "通知客户" },
          "labels": [{ "text": "通知客户" }]
        },
        {
          "id": "end_failure",
          "width": 36, "height": 36,
          "bpmn": { "type": "endEvent", "eventDefinitionType": "none", "name": "订单关闭" },
          "labels": [{ "text": "订单关闭" }]
        }
      ],
      "edges": [
        { "id": "main_flow_1", "sources": ["start_main"], "targets": ["sub_payment"], "bpmn": { "type": "sequenceFlow" } },
        { "id": "main_flow_2", "sources": ["sub_payment"], "targets": ["task_ship"], "bpmn": { "type": "sequenceFlow" } },
        { "id": "main_flow_3", "sources": ["task_ship"], "targets": ["end_main"], "bpmn": { "type": "sequenceFlow" } },
        { "id": "handler_flow_1", "sources": ["boundary_payment_error"], "targets": ["task_log_failure"], "bpmn": { "type": "sequenceFlow" } },
        { "id": "handler_flow_2", "sources": ["task_log_failure"], "targets": ["sub_refund"], "bpmn": { "type": "sequenceFlow" } },
        { "id": "handler_flow_3", "sources": ["sub_refund"], "targets": ["task_notify_customer"], "bpmn": { "type": "sequenceFlow" } },
        { "id": "handler_flow_4", "sources": ["task_notify_customer"], "targets": ["end_failure"], "bpmn": { "type": "sequenceFlow" } }
      ]
    }
  ]
}
