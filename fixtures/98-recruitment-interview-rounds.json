            { "id": "f_cand_result", "sources": ["task_attend_interview"], "targets": ["event_recv_result"], "bpmn": { "type": "sequenceFlow" } },
            { "id": "f_cand_offer", "sources": ["event_recv_result"], "targets": ["event_recv_offer"], "bpmn": { "type": "sequenceFlow" } },
            { "id": "f_cand_end", "sources": ["event_recv_offer"], "targets": ["end_candidate"], "bpmn": { "type": "sequenceFlow" } }
