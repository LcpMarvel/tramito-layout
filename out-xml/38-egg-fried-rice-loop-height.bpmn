    <bpmn:sequenceFlow id="flow_39" sourceRef="task_15" targetRef="gateway_16" />
    <bpmn:sequenceFlow id="flow_40" name="米饭太湿" sourceRef="gateway_16" targetRef="task_17">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riceTooWet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_41" sourceRef="task_17" targetRef="gateway_16" />
    <bpmn:sequenceFlow id="flow_42" name="干湿适中" sourceRef="gateway_16" targetRef="task_18" />
    <bpmn:sequenceFlow id="flow_43" sourceRef="task_18" targetRef="task_19" />
    <bpmn:sequenceFlow id="flow_44" sourceRef="task_19" targetRef="task_20" />
    <bpmn:sequenceFlow id="flow_45" sourceRef="task_20" targetRef="gateway_21" />
    <bpmn:sequenceFlow id="flow_46" name="味道不够" sourceRef="gateway_21" targetRef="task_22">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${notTasty}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_47" sourceRef="task_22" targetRef="gateway_21" />
    <bpmn:sequenceFlow id="flow_48" name="味道OK" sourceRef="gateway_21" targetRef="task_23" />
    <bpmn:sequenceFlow id="flow_49" sourceRef="task_23" targetRef="end_24" />
  </bpmn:process>
