        <bpmndi:BPMNLabel>
          <dc:Bounds x="66" y="245" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_parallel_fork_di" bpmnElement="gateway_parallel_fork">
        <dc:Bounds x="178" y="198" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="154" y="180" width="98" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receive_voc_di" bpmnElement="task_receive_voc">
        <dc:Bounds x="308" y="183" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_customer_type_di" bpmnElement="gateway_customer_type">
