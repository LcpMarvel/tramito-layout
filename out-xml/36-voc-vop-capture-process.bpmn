          <dc:Bounds x="1134" y="180" width="98" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="1288" y="205" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1292" y="245" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_quality_di" bpmnElement="lane_quality" isHorizontal="true">
        <dc:Bounds x="30" y="435" width="1314" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_quality_receive_di" bpmnElement="task_quality_receive">
        <dc:Bounds x="978" y="451" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_business_depts_di" bpmnElement="lane_business_depts" isHorizontal="true">
        <dc:Bounds x="30" y="547" width="1314" height="115" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receive_vop_di" bpmnElement="task_receive_vop">
        <dc:Bounds x="308" y="566" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_vop_fork_di" bpmnElement="gateway_vop_fork">
        <dc:Bounds x="488" y="581" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="488.5" y="563" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_process_mgmt_di" bpmnElement="lane_process_mgmt" isHorizontal="true">
        <dc:Bounds x="30" y="662" width="1314" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_vop_copy_di" bpmnElement="task_vop_copy">
        <dc:Bounds x="618" y="678" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_vop_copy_di" bpmnElement="end_vop_copy">
        <dc:Bounds x="1288" y="700" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1278" y="740" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_fork_di" bpmnElement="flow_start_to_fork">
        <di:waypoint x="98" y="223" />
        <di:waypoint x="178" y="223" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fork_to_voc_di" bpmnElement="flow_fork_to_voc">
        <di:waypoint x="228" y="223" />
        <di:waypoint x="308" y="223" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fork_to_vop_di" bpmnElement="flow_fork_to_vop">
        <di:waypoint x="203" y="248" />
        <di:waypoint x="203" y="606" />
        <di:waypoint x="308" y="606" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_voc_to_customer_type_di" bpmnElement="flow_voc_to_customer_type">
        <di:waypoint x="408" y="223" />
        <di:waypoint x="488" y="223" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_customer_type_to_export_di" bpmnElement="flow_customer_type_to_export">
        <di:waypoint x="538" y="223" />
        <di:waypoint x="651.3333333333334" y="223" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_customer_type_to_internal_di" bpmnElement="flow_customer_type_to_internal">
        <di:waypoint x="538" y="223" />
        <di:waypoint x="641.3333333333334" y="223" />
        <di:waypoint x="641.3333333333334" y="379" />
        <di:waypoint x="798" y="379" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_related_to_yes_di" bpmnElement="flow_related_to_yes">
        <di:waypoint x="701.3333333333334" y="223" />
        <di:waypoint x="831.3333333333334" y="223" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_related_to_no_di" bpmnElement="flow_related_to_no">
        <di:waypoint x="676.3333333333334" y="248" />
        <di:waypoint x="676.3333333333334" y="273" />
        <di:waypoint x="676.3333333333334" y="283" />
        <di:waypoint x="1028" y="283" />
        <di:waypoint x="1028" y="263" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_department_to_yes_di" bpmnElement="flow_department_to_yes">
        <di:waypoint x="856.3333333333334" y="248" />
        <di:waypoint x="856.3333333333334" y="329" />
        <di:waypoint x="958" y="329" />
        <di:waypoint x="958" y="491" />
        <di:waypoint x="978" y="491" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_department_no_di" bpmnElement="flow_department_no">
        <di:waypoint x="881.3333333333334" y="223" />
        <di:waypoint x="978" y="223" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_internal_to_join_di" bpmnElement="flow_internal_to_join">
        <di:waypoint x="848" y="339" />
        <di:waypoint x="848" y="293.5" />
        <di:waypoint x="1183" y="293.5" />
