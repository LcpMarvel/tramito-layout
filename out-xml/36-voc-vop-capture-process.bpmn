        <dc:Bounds x="651.3333333333334" y="198" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620.3333333333334" y="180" width="112" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_department_di" bpmnElement="gateway_department">
        <dc:Bounds x="831.3333333333334" y="198" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="781.3333333333334" y="166" width="150" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_marketing_after_sales_di" bpmnElement="task_marketing_after_sales">
        <dc:Bounds x="798" y="339" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_marketing_receive_di" bpmnElement="task_marketing_receive">
        <dc:Bounds x="978" y="183" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_parallel_join_di" bpmnElement="gateway_parallel_join">
        <dc:Bounds x="1158" y="198" width="50" height="50" />
