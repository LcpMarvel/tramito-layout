<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_unbalanced_branches" targetNamespace="http://example.com/test-unbalanced-branches" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_unbalanced" name="极不均衡分支入职流程" isExecutable="true">
    <bpmn:startEvent id="start_1" name="录用确认">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_type_div" name="用工类型" gatewayDirection="Diverging" default="flow_fulltime">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_intern</bpmn:outgoing>
      <bpmn:outgoing>flow_fulltime</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_intern" name="签实习协议">
      <bpmn:incoming>flow_intern</bpmn:incoming>
      <bpmn:outgoing>flow_intern_conv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_ft_1" name="签劳动合同">
      <bpmn:incoming>flow_fulltime</bpmn:incoming>
      <bpmn:outgoing>flow_ft_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_ft_2" name="体检报告核验">
      <bpmn:incoming>flow_ft_12</bpmn:incoming>
      <bpmn:outgoing>flow_ft_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_ft_3" name="开通办公账号">
      <bpmn:incoming>flow_ft_23</bpmn:incoming>
      <bpmn:outgoing>flow_ft_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_ft_4" name="领取办公设备">
      <bpmn:incoming>flow_ft_34</bpmn:incoming>
      <bpmn:outgoing>flow_ft_45</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_ft_5" name="社保公积金登记">
      <bpmn:incoming>flow_ft_45</bpmn:incoming>
      <bpmn:outgoing>flow_ft_56</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_ft_6" name="入职培训">
      <bpmn:incoming>flow_ft_56</bpmn:incoming>
      <bpmn:outgoing>flow_ft_67</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_ft_7" name="导师见面会">
      <bpmn:incoming>flow_ft_67</bpmn:incoming>
      <bpmn:outgoing>flow_ft_conv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_type_conv" name="入职汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_intern_conv</bpmn:incoming>
      <bpmn:incoming>flow_ft_conv</bpmn:incoming>
      <bpmn:outgoing>flow_to_report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_report" name="通知部门报到">
      <bpmn:incoming>flow_to_report</bpmn:incoming>
      <bpmn:outgoing>flow_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="入职完成">
      <bpmn:incoming>flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="gw_type_div" />
    <bpmn:sequenceFlow id="flow_intern" name="实习生" sourceRef="gw_type_div" targetRef="task_intern">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${type == 'intern'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_fulltime" name="正式员工" sourceRef="gw_type_div" targetRef="task_ft_1" />
    <bpmn:sequenceFlow id="flow_ft_12" sourceRef="task_ft_1" targetRef="task_ft_2" />
    <bpmn:sequenceFlow id="flow_ft_23" sourceRef="task_ft_2" targetRef="task_ft_3" />
    <bpmn:sequenceFlow id="flow_ft_34" sourceRef="task_ft_3" targetRef="task_ft_4" />
    <bpmn:sequenceFlow id="flow_ft_45" sourceRef="task_ft_4" targetRef="task_ft_5" />
    <bpmn:sequenceFlow id="flow_ft_56" sourceRef="task_ft_5" targetRef="task_ft_6" />
    <bpmn:sequenceFlow id="flow_ft_67" sourceRef="task_ft_6" targetRef="task_ft_7" />
    <bpmn:sequenceFlow id="flow_intern_conv" sourceRef="task_intern" targetRef="gw_type_conv" />
    <bpmn:sequenceFlow id="flow_ft_conv" sourceRef="task_ft_7" targetRef="gw_type_conv" />
    <bpmn:sequenceFlow id="flow_to_report" sourceRef="gw_type_conv" targetRef="task_report" />
    <bpmn:sequenceFlow id="flow_to_end" sourceRef="task_report" targetRef="end_1" />
  </bpmn:process>
