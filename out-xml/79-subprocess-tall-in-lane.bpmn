<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_subprocess_tall_in_lane" targetNamespace="http://example.com/test-subprocess-tall-in-lane" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_claims" name="保险理赔协作">
    <bpmn:participant id="pool_claims_center" name="理赔中心" processRef="process_claims_center" />
  </bpmn:collaboration>
  <bpmn:process id="process_claims_center" name="理赔中心" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_service" name="客服部">
        <bpmn:flowNodeRef>start_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_claims" name="理赔部">
        <bpmn:flowNodeRef>sub_investigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_assess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_finance" name="财务部">
        <bpmn:flowNodeRef>task_pay_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_claim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_report" name="接到报案">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_register" name="登记报案信息">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="sub_investigation" name="理赔调查">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:startEvent id="inv_start" name="开始调查">
        <bpmn:outgoing>inv_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="inv_gateway_fork" name="并行取证" gatewayDirection="Diverging">
        <bpmn:incoming>inv_flow_1</bpmn:incoming>
        <bpmn:outgoing>inv_flow_scene</bpmn:outgoing>
        <bpmn:outgoing>inv_flow_phone</bpmn:outgoing>
        <bpmn:outgoing>inv_flow_docs</bpmn:outgoing>
        <bpmn:outgoing>inv_flow_thirdparty</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="inv_task_scene" name="现场查勘">
        <bpmn:incoming>inv_flow_scene</bpmn:incoming>
        <bpmn:outgoing>inv_flow_join_1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="inv_task_phone" name="电话核实">
        <bpmn:incoming>inv_flow_phone</bpmn:incoming>
        <bpmn:outgoing>inv_flow_join_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="inv_task_docs" name="单证审查">
        <bpmn:incoming>inv_flow_docs</bpmn:incoming>
        <bpmn:outgoing>inv_flow_join_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="inv_task_thirdparty" name="第三方鉴定">
        <bpmn:incoming>inv_flow_thirdparty</bpmn:incoming>
        <bpmn:outgoing>inv_flow_join_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="inv_gateway_join" name="取证汇总" gatewayDirection="Converging">
        <bpmn:incoming>inv_flow_join_1</bpmn:incoming>
        <bpmn:incoming>inv_flow_join_2</bpmn:incoming>
        <bpmn:incoming>inv_flow_join_3</bpmn:incoming>
        <bpmn:incoming>inv_flow_join_4</bpmn:incoming>
        <bpmn:outgoing>inv_flow_end</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="inv_end" name="调查完成">
        <bpmn:incoming>inv_flow_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="inv_flow_1" sourceRef="inv_start" targetRef="inv_gateway_fork" />
      <bpmn:sequenceFlow id="inv_flow_scene" sourceRef="inv_gateway_fork" targetRef="inv_task_scene" />
      <bpmn:sequenceFlow id="inv_flow_phone" sourceRef="inv_gateway_fork" targetRef="inv_task_phone" />
      <bpmn:sequenceFlow id="inv_flow_docs" sourceRef="inv_gateway_fork" targetRef="inv_task_docs" />
      <bpmn:sequenceFlow id="inv_flow_thirdparty" sourceRef="inv_gateway_fork" targetRef="inv_task_thirdparty" />
      <bpmn:sequenceFlow id="inv_flow_join_1" sourceRef="inv_task_scene" targetRef="inv_gateway_join" />
      <bpmn:sequenceFlow id="inv_flow_join_2" sourceRef="inv_task_phone" targetRef="inv_gateway_join" />
      <bpmn:sequenceFlow id="inv_flow_join_3" sourceRef="inv_task_docs" targetRef="inv_gateway_join" />
      <bpmn:sequenceFlow id="inv_flow_join_4" sourceRef="inv_task_thirdparty" targetRef="inv_gateway_join" />
      <bpmn:sequenceFlow id="inv_flow_end" sourceRef="inv_gateway_join" targetRef="inv_end" />
    </bpmn:subProcess>
    <bpmn:userTask id="task_assess" name="核定赔付金额">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_pay_claim" name="支付赔款">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_claim" name="理赔结案">
      <bpmn:incoming>flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_report" targetRef="task_register" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_register" targetRef="sub_investigation" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="sub_investigation" targetRef="task_assess" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_assess" targetRef="task_pay_claim" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_pay_claim" targetRef="end_claim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_subprocess_tall_in_lane" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_subprocess_tall_in_lane" bpmnElement="collaboration_claims">
