      <bpmndi:BPMNShape id="inv_task_phone_di" bpmnElement="inv_task_phone">
        <dc:Bounds x="676" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inv_task_docs_di" bpmnElement="inv_task_docs">
        <dc:Bounds x="676" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inv_task_thirdparty_di" bpmnElement="inv_task_thirdparty">
        <dc:Bounds x="676" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inv_gateway_join_di" bpmnElement="inv_gateway_join">
        <dc:Bounds x="876" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="907" y="407" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inv_end_di" bpmnElement="inv_end">
