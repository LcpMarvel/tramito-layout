      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_handover_di" bpmnElement="task_handover">
        <dc:Bounds x="1204" y="74" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
