<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_loop_body_subprocess" targetNamespace="http://example.com/test-loop-body-subprocess" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_loop_body_sub" name="试制批次循环" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_order" name="下达试制指令">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_order_sub</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="subprocess_trial" name="试制一个批次">
      <bpmn:incoming>flow_order_sub</bpmn:incoming>
      <bpmn:incoming>flow_gw_back</bpmn:incoming>
      <bpmn:outgoing>flow_sub_gw</bpmn:outgoing>
      <bpmn:startEvent id="sub_start" name="批次开始">
        <bpmn:outgoing>sub_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="sub_task_make" name="样件制作">
        <bpmn:incoming>sub_flow_1</bpmn:incoming>
        <bpmn:outgoing>sub_flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:userTask id="sub_task_test" name="性能测试">
        <bpmn:incoming>sub_flow_2</bpmn:incoming>
        <bpmn:outgoing>sub_flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="sub_end" name="批次完成">
        <bpmn:incoming>sub_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="sub_flow_1" sourceRef="sub_start" targetRef="sub_task_make" />
      <bpmn:sequenceFlow id="sub_flow_2" sourceRef="sub_task_make" targetRef="sub_task_test" />
      <bpmn:sequenceFlow id="sub_flow_3" sourceRef="sub_task_test" targetRef="sub_end" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="gw_quality" name="质检合格">
      <bpmn:incoming>flow_sub_gw</bpmn:incoming>
      <bpmn:outgoing>flow_gw_back</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_handover" name="量产移交">
      <bpmn:incoming>flow_gw_pass</bpmn:incoming>
      <bpmn:outgoing>flow_handover_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>flow_handover_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_order" />
    <bpmn:sequenceFlow id="flow_order_sub" sourceRef="task_order" targetRef="subprocess_trial" />
    <bpmn:sequenceFlow id="flow_sub_gw" sourceRef="subprocess_trial" targetRef="gw_quality" />
    <bpmn:sequenceFlow id="flow_gw_back" name="不合格再试制" sourceRef="gw_quality" targetRef="subprocess_trial" />
    <bpmn:sequenceFlow id="flow_gw_pass" name="合格" sourceRef="gw_quality" targetRef="task_handover" />
    <bpmn:sequenceFlow id="flow_handover_end" sourceRef="task_handover" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_loop_body_subprocess" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_loop_body_subprocess" bpmnElement="process_loop_body_sub">
