<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_backedge_into_gateway" targetNamespace="http://example.com/test-backedge-into-gateway" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_backedge_gateway" name="订单分流复核回环" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_receive" name="接收订单">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_receive_split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_split" name="渠道分流">
      <bpmn:incoming>flow_receive_split</bpmn:incoming>
      <bpmn:incoming>flow_check_back</bpmn:incoming>
      <bpmn:outgoing>flow_split_online</bpmn:outgoing>
      <bpmn:outgoing>flow_split_offline</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_online" name="线上渠道处理">
      <bpmn:incoming>flow_split_online</bpmn:incoming>
      <bpmn:outgoing>flow_online_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_offline" name="线下网点处理">
      <bpmn:incoming>flow_split_offline</bpmn:incoming>
      <bpmn:outgoing>flow_offline_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_merge" name="处理汇聚">
      <bpmn:incoming>flow_online_merge</bpmn:incoming>
      <bpmn:incoming>flow_offline_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_review" name="汇总复核">
      <bpmn:incoming>flow_merge_review</bpmn:incoming>
      <bpmn:outgoing>flow_review_check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_check" name="复核通过">
      <bpmn:incoming>flow_review_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_check_back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_1" name="完成">
      <bpmn:incoming>flow_check_pass</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_receive" />
    <bpmn:sequenceFlow id="flow_receive_split" sourceRef="task_receive" targetRef="gw_split" />
    <bpmn:sequenceFlow id="flow_split_online" name="线上" sourceRef="gw_split" targetRef="task_online" />
    <bpmn:sequenceFlow id="flow_split_offline" name="线下" sourceRef="gw_split" targetRef="task_offline" />
    <bpmn:sequenceFlow id="flow_online_merge" sourceRef="task_online" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="flow_offline_merge" sourceRef="task_offline" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="flow_merge_review" sourceRef="gw_merge" targetRef="task_review" />
    <bpmn:sequenceFlow id="flow_review_check" sourceRef="task_review" targetRef="gw_check" />
    <bpmn:sequenceFlow id="flow_check_pass" name="通过" sourceRef="gw_check" targetRef="end_1" />
    <bpmn:sequenceFlow id="flow_check_back" name="重新分流" sourceRef="gw_check" targetRef="gw_split" />
  </bpmn:process>
