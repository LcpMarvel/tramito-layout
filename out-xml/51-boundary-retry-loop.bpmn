          <dc:Bounds x="351" y="134" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_save_di" bpmnElement="task_save">
        <dc:Bounds x="538" y="32" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="718" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="722" y="94" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_di" bpmnElement="flow_start">
        <di:waypoint x="98" y="72" />
        <di:waypoint x="178" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_prepare_call_di" bpmnElement="flow_prepare_call">
        <di:waypoint x="278" y="72" />
        <di:waypoint x="358" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_call_save_di" bpmnElement="flow_call_save">
        <di:waypoint x="458" y="72" />
        <di:waypoint x="538" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_end_di" bpmnElement="flow_save_end">
        <di:waypoint x="638" y="72" />
        <di:waypoint x="718" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_retry_di" bpmnElement="flow_retry">
        <di:waypoint x="378" y="130" />
        <di:waypoint x="378" y="152" />
