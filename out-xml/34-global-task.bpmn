      <bpmndi:BPMNShape id="gateway_join_di" bpmnElement="gateway_join">
        <dc:Bounds x="848" y="117" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="845" y="99" width="56" height="14" />
