<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_global_task" targetNamespace="http://example.com/test-global-task" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_using_global_tasks" name="使用全局任务的流程" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_prepare" name="准备数据">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="call_global_user_task" name="调用审批" calledElement="global_user_task_approval">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="gateway_split" name="并行分支" gatewayDirection="Diverging">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4a</bpmn:outgoing>
      <bpmn:outgoing>flow_4b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="call_global_manual_task" name="调用核验" calledElement="global_manual_task_verification">
      <bpmn:incoming>flow_4a</bpmn:incoming>
      <bpmn:outgoing>flow_5a</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="call_global_script_task" name="调用校验" calledElement="global_script_task_validation">
      <bpmn:incoming>flow_4b</bpmn:incoming>
      <bpmn:outgoing>flow_5b</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="gateway_join" name="并行汇聚" gatewayDirection="Converging">
      <bpmn:incoming>flow_5a</bpmn:incoming>
      <bpmn:incoming>flow_5b</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="call_global_business_rule" name="调用定价" calledElement="global_business_rule_task_pricing">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="task_finalize" name="完成处理">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_prepare" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_prepare" targetRef="call_global_user_task" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="call_global_user_task" targetRef="gateway_split" />
    <bpmn:sequenceFlow id="flow_4a" sourceRef="gateway_split" targetRef="call_global_manual_task" />
    <bpmn:sequenceFlow id="flow_4b" sourceRef="gateway_split" targetRef="call_global_script_task" />
    <bpmn:sequenceFlow id="flow_5a" sourceRef="call_global_manual_task" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_5b" sourceRef="call_global_script_task" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="gateway_join" targetRef="call_global_business_rule" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="call_global_business_rule" targetRef="task_finalize" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_finalize" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_global_task" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_global_task" bpmnElement="process_using_global_tasks">
