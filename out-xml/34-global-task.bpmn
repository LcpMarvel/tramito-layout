      <bpmndi:BPMNShape id="task_finalize_di" bpmnElement="task_finalize">
        <dc:Bounds x="1158" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="1338" y="124" width="36" height="36" />
