<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_cicd_parallel_rollback" targetNamespace="http://example.com/cicd-parallel-rollback" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_cicd" name="持续集成发布流水线" isExecutable="true">
    <bpmn:startEvent id="start_commit" name="代码提交">
      <bpmn:outgoing>f_commit_build</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_build" name="构建">
      <bpmn:incoming>f_commit_build</bpmn:incoming>
      <bpmn:incoming>f_check_fail</bpmn:incoming>
      <bpmn:outgoing>f_build_fork</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="gw_fork_tests" name="并行测试" gatewayDirection="Diverging">
      <bpmn:incoming>f_build_fork</bpmn:incoming>
      <bpmn:outgoing>f_fork_unit</bpmn:outgoing>
      <bpmn:outgoing>f_fork_integration</bpmn:outgoing>
      <bpmn:outgoing>f_fork_api</bpmn:outgoing>
      <bpmn:outgoing>f_fork_ui</bpmn:outgoing>
      <bpmn:outgoing>f_fork_perf</bpmn:outgoing>
      <bpmn:outgoing>f_fork_security</bpmn:outgoing>
      <bpmn:outgoing>f_fork_compat</bpmn:outgoing>
      <bpmn:outgoing>f_fork_regression</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="task_test_unit" name="单元测试">
      <bpmn:incoming>f_fork_unit</bpmn:incoming>
      <bpmn:outgoing>f_unit_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_test_integration" name="集成测试">
      <bpmn:incoming>f_fork_integration</bpmn:incoming>
      <bpmn:outgoing>f_integration_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_test_api" name="接口测试">
      <bpmn:incoming>f_fork_api</bpmn:incoming>
      <bpmn:outgoing>f_api_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_test_ui" name="界面测试">
      <bpmn:incoming>f_fork_ui</bpmn:incoming>
      <bpmn:outgoing>f_ui_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_test_perf" name="性能测试">
      <bpmn:incoming>f_fork_perf</bpmn:incoming>
      <bpmn:outgoing>f_perf_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_test_security" name="安全扫描">
      <bpmn:incoming>f_fork_security</bpmn:incoming>
      <bpmn:outgoing>f_security_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_test_compat" name="兼容性测试">
      <bpmn:incoming>f_fork_compat</bpmn:incoming>
      <bpmn:outgoing>f_compat_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_test_regression" name="回归测试">
      <bpmn:incoming>f_fork_regression</bpmn:incoming>
      <bpmn:outgoing>f_regression_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="gw_join_tests" name="测试汇合" gatewayDirection="Converging">
      <bpmn:incoming>f_unit_join</bpmn:incoming>
      <bpmn:incoming>f_integration_join</bpmn:incoming>
      <bpmn:incoming>f_api_join</bpmn:incoming>
      <bpmn:incoming>f_ui_join</bpmn:incoming>
      <bpmn:incoming>f_perf_join</bpmn:incoming>
      <bpmn:incoming>f_security_join</bpmn:incoming>
      <bpmn:incoming>f_compat_join</bpmn:incoming>
      <bpmn:incoming>f_regression_join</bpmn:incoming>
      <bpmn:outgoing>f_join_check</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gw_check_result" name="测试是否全部通过" gatewayDirection="Diverging">
      <bpmn:incoming>f_join_check</bpmn:incoming>
      <bpmn:outgoing>f_check_fail</bpmn:outgoing>
      <bpmn:outgoing>f_check_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_deploy" name="部署预发布环境">
      <bpmn:incoming>f_check_pass</bpmn:incoming>
      <bpmn:outgoing>f_deploy_release</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_released" name="发布完成">
      <bpmn:incoming>f_deploy_release</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_commit_build" sourceRef="start_commit" targetRef="task_build" />
    <bpmn:sequenceFlow id="f_build_fork" sourceRef="task_build" targetRef="gw_fork_tests" />
    <bpmn:sequenceFlow id="f_fork_unit" sourceRef="gw_fork_tests" targetRef="task_test_unit" />
    <bpmn:sequenceFlow id="f_fork_integration" sourceRef="gw_fork_tests" targetRef="task_test_integration" />
    <bpmn:sequenceFlow id="f_fork_api" sourceRef="gw_fork_tests" targetRef="task_test_api" />
    <bpmn:sequenceFlow id="f_fork_ui" sourceRef="gw_fork_tests" targetRef="task_test_ui" />
    <bpmn:sequenceFlow id="f_fork_perf" sourceRef="gw_fork_tests" targetRef="task_test_perf" />
    <bpmn:sequenceFlow id="f_fork_security" sourceRef="gw_fork_tests" targetRef="task_test_security" />
    <bpmn:sequenceFlow id="f_fork_compat" sourceRef="gw_fork_tests" targetRef="task_test_compat" />
    <bpmn:sequenceFlow id="f_fork_regression" sourceRef="gw_fork_tests" targetRef="task_test_regression" />
    <bpmn:sequenceFlow id="f_unit_join" sourceRef="task_test_unit" targetRef="gw_join_tests" />
    <bpmn:sequenceFlow id="f_integration_join" sourceRef="task_test_integration" targetRef="gw_join_tests" />
    <bpmn:sequenceFlow id="f_api_join" sourceRef="task_test_api" targetRef="gw_join_tests" />
    <bpmn:sequenceFlow id="f_ui_join" sourceRef="task_test_ui" targetRef="gw_join_tests" />
    <bpmn:sequenceFlow id="f_perf_join" sourceRef="task_test_perf" targetRef="gw_join_tests" />
    <bpmn:sequenceFlow id="f_security_join" sourceRef="task_test_security" targetRef="gw_join_tests" />
    <bpmn:sequenceFlow id="f_compat_join" sourceRef="task_test_compat" targetRef="gw_join_tests" />
    <bpmn:sequenceFlow id="f_regression_join" sourceRef="task_test_regression" targetRef="gw_join_tests" />
    <bpmn:sequenceFlow id="f_join_check" sourceRef="gw_join_tests" targetRef="gw_check_result" />
    <bpmn:sequenceFlow id="f_check_fail" name="存在失败重新构建" sourceRef="gw_check_result" targetRef="task_build" />
    <bpmn:sequenceFlow id="f_check_pass" name="全部通过" sourceRef="gw_check_result" targetRef="task_deploy" />
    <bpmn:sequenceFlow id="f_deploy_release" sourceRef="task_deploy" targetRef="end_released" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_cicd_parallel_rollback" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_cicd_parallel_rollback" bpmnElement="process_cicd">
