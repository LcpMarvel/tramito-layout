<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_gateway_chain" targetNamespace="http://example.com/test-gateway-chain" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_gateway_chain" name="网关直连链路风控筛查" isExecutable="true">
    <bpmn:startEvent id="start_1" name="交易发起">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_1_div" name="黑名单筛查" gatewayDirection="Diverging" default="flow_gw1_pass">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_gw1_hit</bpmn:outgoing>
      <bpmn:outgoing>flow_gw1_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_2_div" name="额度筛查" gatewayDirection="Diverging" default="flow_gw2_pass">
      <bpmn:incoming>flow_gw1_pass</bpmn:incoming>
      <bpmn:outgoing>flow_gw2_hit</bpmn:outgoing>
      <bpmn:outgoing>flow_gw2_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_3_div" name="异地筛查" gatewayDirection="Diverging" default="flow_gw3_pass">
      <bpmn:incoming>flow_gw2_pass</bpmn:incoming>
      <bpmn:outgoing>flow_gw3_hit</bpmn:outgoing>
      <bpmn:outgoing>flow_gw3_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_blacklist" name="人工核查身份">
      <bpmn:incoming>flow_gw1_hit</bpmn:incoming>
      <bpmn:outgoing>flow_blacklist_conv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_overlimit" name="提交超额申请">
      <bpmn:incoming>flow_gw2_hit</bpmn:incoming>
      <bpmn:outgoing>flow_overlimit_conv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_remote" name="短信二次验证">
      <bpmn:incoming>flow_gw3_hit</bpmn:incoming>
      <bpmn:outgoing>flow_remote_conv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_pass" name="直接放行">
      <bpmn:incoming>flow_gw3_pass</bpmn:incoming>
      <bpmn:outgoing>flow_pass_conv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_3_conv" name="异地汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_remote_conv</bpmn:incoming>
      <bpmn:incoming>flow_pass_conv</bpmn:incoming>
      <bpmn:outgoing>flow_gw3c_gw2c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_2_conv" name="额度汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_gw3c_gw2c</bpmn:incoming>
      <bpmn:incoming>flow_overlimit_conv</bpmn:incoming>
      <bpmn:outgoing>flow_gw2c_gw1c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_1_conv" name="筛查汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_gw2c_gw1c</bpmn:incoming>
      <bpmn:incoming>flow_blacklist_conv</bpmn:incoming>
      <bpmn:outgoing>flow_to_execute</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_execute" name="执行交易">
      <bpmn:incoming>flow_to_execute</bpmn:incoming>
      <bpmn:outgoing>flow_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="交易完成">
      <bpmn:incoming>flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="gw_1_div" />
    <bpmn:sequenceFlow id="flow_gw1_hit" name="命中黑名单" sourceRef="gw_1_div" targetRef="task_blacklist">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${blacklisted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gw1_pass" name="未命中" sourceRef="gw_1_div" targetRef="gw_2_div" />
    <bpmn:sequenceFlow id="flow_gw2_hit" name="超出额度" sourceRef="gw_2_div" targetRef="task_overlimit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; limit}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gw2_pass" name="额度内" sourceRef="gw_2_div" targetRef="gw_3_div" />
    <bpmn:sequenceFlow id="flow_gw3_hit" name="异地登录" sourceRef="gw_3_div" targetRef="task_remote">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${remoteLogin == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gw3_pass" name="本地登录" sourceRef="gw_3_div" targetRef="task_pass" />
    <bpmn:sequenceFlow id="flow_remote_conv" sourceRef="task_remote" targetRef="gw_3_conv" />
    <bpmn:sequenceFlow id="flow_pass_conv" sourceRef="task_pass" targetRef="gw_3_conv" />
    <bpmn:sequenceFlow id="flow_gw3c_gw2c" sourceRef="gw_3_conv" targetRef="gw_2_conv" />
    <bpmn:sequenceFlow id="flow_overlimit_conv" sourceRef="task_overlimit" targetRef="gw_2_conv" />
    <bpmn:sequenceFlow id="flow_gw2c_gw1c" sourceRef="gw_2_conv" targetRef="gw_1_conv" />
    <bpmn:sequenceFlow id="flow_blacklist_conv" sourceRef="task_blacklist" targetRef="gw_1_conv" />
    <bpmn:sequenceFlow id="flow_to_execute" sourceRef="gw_1_conv" targetRef="task_execute" />
    <bpmn:sequenceFlow id="flow_to_end" sourceRef="task_execute" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_gateway_chain" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_gateway_chain" bpmnElement="process_gateway_chain">
