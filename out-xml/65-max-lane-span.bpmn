<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_max_lane_span" targetNamespace="http://example.com/test-max-lane-span" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="重大事故跨八级上报">
    <bpmn:participant id="pool_factory" name="制造工厂" processRef="process_incident" />
  </bpmn:collaboration>
  <bpmn:process id="process_incident" name="制造工厂" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_1_operator" name="一线操作员">
        <bpmn:flowNodeRef>start_incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_severity</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2_shift" name="班组长">
        <bpmn:flowNodeRef>task_shift_confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3_workshop" name="车间主任">
        <bpmn:flowNodeRef>task_workshop_assess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_4_quality" name="质量部">
        <bpmn:flowNodeRef>task_quality_analyze</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_5_equipment" name="设备部">
        <bpmn:flowNodeRef>task_equipment_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_6_safety" name="安环部">
        <bpmn:flowNodeRef>task_safety_audit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_7_director" name="厂长办">
        <bpmn:flowNodeRef>task_director_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_8_emergency" name="应急指挥中心">
        <bpmn:flowNodeRef>task_emergency_launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_close_incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_incident" name="发现异常">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_report" name="上报异常">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_severity" name="重大事故?">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_direct_span</bpmn:outgoing>
      <bpmn:outgoing>flow_normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_shift_confirm" name="班组确认">
      <bpmn:incoming>flow_normal</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_workshop_assess" name="车间评估">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_quality_analyze" name="质量分析">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_equipment_check" name="设备排查">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_safety_audit" name="安全稽核">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_director_review" name="厂长审阅">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_emergency_launch" name="启动应急预案">
      <bpmn:incoming>flow_direct_span</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_close_incident" name="事故结案">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_done" name="处理完毕">
      <bpmn:incoming>flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_incident" targetRef="task_report" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_report" targetRef="gw_severity" />
    <bpmn:sequenceFlow id="flow_direct_span" name="重大，直报应急中心" sourceRef="gw_severity" targetRef="task_emergency_launch" />
    <bpmn:sequenceFlow id="flow_normal" name="一般，逐级处理" sourceRef="gw_severity" targetRef="task_shift_confirm" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_shift_confirm" targetRef="task_workshop_assess" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_workshop_assess" targetRef="task_quality_analyze" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_quality_analyze" targetRef="task_equipment_check" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_equipment_check" targetRef="task_safety_audit" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_safety_audit" targetRef="task_director_review" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_director_review" targetRef="task_close_incident" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="task_emergency_launch" targetRef="task_close_incident" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_close_incident" targetRef="end_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_max_lane_span" name="BPMNDiagram">
