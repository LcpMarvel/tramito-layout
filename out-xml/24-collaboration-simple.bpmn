      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_di" bpmnElement="task_process">
        <dc:Bounds x="326" y="206" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_supplier_di" bpmnElement="end_supplier">
        <dc:Bounds x="506" y="228" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="474" y="268" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_c1_di" bpmnElement="flow_c1">
