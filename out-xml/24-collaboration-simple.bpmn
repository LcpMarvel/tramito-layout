      <bpmndi:BPMNShape id="end_customer_di" bpmnElement="end_customer">
        <dc:Bounds x="358" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="326" y="94" width="100" height="14" />
        </bpmndi:BPMNLabel>
