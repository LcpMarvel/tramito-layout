<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_collab_simple" targetNamespace="http://example.com/test-collab-simple" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="简单协作">
    <bpmn:participant id="pool_customer" name="客户" processRef="process_customer" />
    <bpmn:participant id="pool_supplier" name="供应商" processRef="process_supplier" />
    <bpmn:messageFlow id="msgflow_order" name="订单" sourceRef="task_submit" targetRef="start_supplier" />
  </bpmn:collaboration>
  <bpmn:process id="process_customer" name="客户" isExecutable="true">
    <bpmn:startEvent id="start_customer" name="开始">
      <bpmn:outgoing>flow_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit" name="提交订单">
      <bpmn:incoming>flow_c1</bpmn:incoming>
      <bpmn:outgoing>flow_c2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_customer" name="结束">
      <bpmn:incoming>flow_c2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_c1" sourceRef="start_customer" targetRef="task_submit" />
    <bpmn:sequenceFlow id="flow_c2" sourceRef="task_submit" targetRef="end_customer" />
  </bpmn:process>
  <bpmn:process id="process_supplier" name="供应商" isExecutable="true">
    <bpmn:startEvent id="start_supplier" name="收到订单">
      <bpmn:outgoing>flow_s1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_process" name="处理订单">
      <bpmn:incoming>flow_s1</bpmn:incoming>
      <bpmn:outgoing>flow_s2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_supplier" name="结束">
      <bpmn:incoming>flow_s2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_s1" sourceRef="start_supplier" targetRef="task_process" />
    <bpmn:sequenceFlow id="flow_s2" sourceRef="task_process" targetRef="end_supplier" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_collab_simple" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_collab_simple" bpmnElement="collaboration_1">
      <bpmndi:BPMNShape id="collaboration_1_di" bpmnElement="collaboration_1">
        <dc:Bounds x="0" y="0" width="562" height="318" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_customer_di" bpmnElement="pool_customer" isHorizontal="true">
