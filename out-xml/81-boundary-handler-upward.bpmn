        <bpmndi:BPMNLabel>
          <dc:Bounds x="1075" y="60.66666666666666" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_sign_di" bpmnElement="task_sign">
        <dc:Bounds x="1208" y="63.666666666666664" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_done_di" bpmnElement="end_done">
