        <bpmndi:BPMNLabel>
          <dc:Bounds x="1356" y="125.66666666666666" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_remind_di" bpmnElement="task_remind">
        <dc:Bounds x="358" y="175.33333333333331" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_remind_di" bpmnElement="end_remind">
        <dc:Bounds x="1388" y="197.33333333333331" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1356" y="237.33333333333331" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_manual_review_di" bpmnElement="task_manual_review">
        <dc:Bounds x="718" y="57.50000000000001" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_check_di" bpmnElement="flow_start_check">
        <di:waypoint x="98" y="152.83333333333331" />
        <di:waypoint x="178" y="152.83333333333331" />
      </bpmndi:BPMNEdge>
