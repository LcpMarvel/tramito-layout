<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_data_io_specification" targetNamespace="http://example.com/test-data-io" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_data_io" name="任务IO规范测试" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_create_event" name="创建事件">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="input_feedback" name="反馈信息" />
        <bpmn:dataOutput id="output_form" name="事件表单" />
        <bpmn:inputSet id="task_create_event_inputSet_0">
          <bpmn:dataInputRefs>input_feedback</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="task_create_event_outputSet_0">
          <bpmn:dataOutputRefs>output_form</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="input_feedback_assoc">
        <bpmn:sourceRef>input_feedback</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="output_form_assoc">
        <bpmn:targetRef>output_form</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_complete" name="信息是否完整" gatewayDirection="Diverging">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3_no</bpmn:outgoing>
      <bpmn:outgoing>flow_5_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_supplement" name="补充信息">
      <bpmn:incoming>flow_3_no</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="input_original" name="原始表单" />
        <bpmn:dataInput id="input_extra" name="补充资料" />
        <bpmn:dataOutput id="output_updated" name="更新表单" />
        <bpmn:inputSet id="task_supplement_inputSet_0">
          <bpmn:dataInputRefs>input_original</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>input_extra</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="task_supplement_outputSet_0">
          <bpmn:dataOutputRefs>output_updated</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="input_original_assoc">
        <bpmn:sourceRef>input_original</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="output_updated_assoc">
        <bpmn:targetRef>output_updated</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_process" name="处理事件">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:incoming>flow_5_yes</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="input_event_form" name="事件表单" />
        <bpmn:dataOutput id="output_result" name="处理结果" />
        <bpmn:dataOutput id="output_log" name="处理日志" />
        <bpmn:inputSet id="task_process_inputSet_0">
          <bpmn:dataInputRefs>input_event_form</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="task_process_outputSet_0">
          <bpmn:dataOutputRefs>output_result</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>output_log</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="input_event_form_assoc">
        <bpmn:sourceRef>input_event_form</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="output_result_assoc">
        <bpmn:targetRef>output_result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_create_event" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_create_event" targetRef="gateway_complete" />
    <bpmn:sequenceFlow id="flow_3_no" name="否" sourceRef="gateway_complete" targetRef="task_supplement" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_supplement" targetRef="task_process" />
    <bpmn:sequenceFlow id="flow_5_yes" name="是" sourceRef="gateway_complete" targetRef="task_process" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_process" targetRef="end_1" />
  </bpmn:process>
