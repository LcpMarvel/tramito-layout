<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_mi_subprocess" targetNamespace="http://example.com/test-mi-subprocess" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_mi_subprocess" name="多实例子流程测试" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="subprocess_mi_parallel" name="并行多实例子流程">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:loopDataInputRef>departments</bpmn:loopDataInputRef>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="sub_mi_start" name="开始">
        <bpmn:outgoing>sub_mi_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="sub_mi_task" name="部门审批">
        <bpmn:incoming>sub_mi_flow_1</bpmn:incoming>
        <bpmn:outgoing>sub_mi_flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="sub_mi_end" name="结束">
        <bpmn:incoming>sub_mi_flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="sub_mi_flow_1" sourceRef="sub_mi_start" targetRef="sub_mi_task" />
      <bpmn:sequenceFlow id="sub_mi_flow_2" sourceRef="sub_mi_task" targetRef="sub_mi_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="subprocess_mi_sequential" name="顺序多实例子流程">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">3</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="sub_seq_start" name="开始">
        <bpmn:outgoing>sub_seq_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="sub_seq_task" name="顺序处理">
        <bpmn:incoming>sub_seq_flow_1</bpmn:incoming>
        <bpmn:outgoing>sub_seq_flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="sub_seq_end" name="结束">
        <bpmn:incoming>sub_seq_flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="sub_seq_flow_1" sourceRef="sub_seq_start" targetRef="sub_seq_task" />
      <bpmn:sequenceFlow id="sub_seq_flow_2" sourceRef="sub_seq_task" targetRef="sub_seq_end" />
    </bpmn:subProcess>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="subprocess_mi_parallel" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="subprocess_mi_parallel" targetRef="subprocess_mi_sequential" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="subprocess_mi_sequential" targetRef="end_1" />
  </bpmn:process>
