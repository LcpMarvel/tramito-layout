<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_terminate_mid_branch" targetNamespace="http://example.com/test-terminate-mid-branch" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_terminate_mid_branch" name="分支中途终止测试" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_prepare" name="准备合同材料">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_prepare_review</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_review" name="法务审核合同">
      <bpmn:incoming>flow_prepare_review</bpmn:incoming>
      <bpmn:incoming>flow_revise_back</bpmn:incoming>
      <bpmn:outgoing>flow_review_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_decision" name="审核结论" gatewayDirection="Diverging">
      <bpmn:incoming>flow_review_gw</bpmn:incoming>
      <bpmn:outgoing>flow_approve</bpmn:outgoing>
      <bpmn:outgoing>flow_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_rework</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_sign" name="双方签署合同">
      <bpmn:incoming>flow_approve</bpmn:incoming>
      <bpmn:outgoing>flow_sign_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_record_reject" name="记录否决原因">
      <bpmn:incoming>flow_reject</bpmn:incoming>
      <bpmn:outgoing>flow_reject_terminate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_revise" name="按意见修订条款">
      <bpmn:incoming>flow_rework</bpmn:incoming>
      <bpmn:outgoing>flow_revise_back</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_signed" name="签署完成">
      <bpmn:incoming>flow_sign_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_terminated" name="合同否决立即终止">
      <bpmn:incoming>flow_reject_terminate</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_prepare" />
    <bpmn:sequenceFlow id="flow_prepare_review" sourceRef="task_prepare" targetRef="task_review" />
    <bpmn:sequenceFlow id="flow_review_gw" sourceRef="task_review" targetRef="gateway_decision" />
    <bpmn:sequenceFlow id="flow_approve" name="审核通过" sourceRef="gateway_decision" targetRef="task_sign" />
    <bpmn:sequenceFlow id="flow_reject" name="存在重大风险" sourceRef="gateway_decision" targetRef="task_record_reject" />
    <bpmn:sequenceFlow id="flow_rework" name="需修订后重审" sourceRef="gateway_decision" targetRef="task_revise" />
    <bpmn:sequenceFlow id="flow_sign_end" sourceRef="task_sign" targetRef="end_signed" />
    <bpmn:sequenceFlow id="flow_reject_terminate" sourceRef="task_record_reject" targetRef="end_terminated" />
    <bpmn:sequenceFlow id="flow_revise_back" name="回到法务重新审核" sourceRef="task_revise" targetRef="task_review" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_terminate_mid_branch" name="BPMNDiagram">
