<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_isolated_node" targetNamespace="http://example.com/test-isolated-node" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_isolated_node" name="孤立节点测试" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_main" name="主流程任务">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_isolated" name="孤立任务（无任何连线）" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_main" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_main" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_isolated_node" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_isolated_node" bpmnElement="process_isolated_node">
      <bpmndi:BPMNShape id="process_isolated_node_di" bpmnElement="process_isolated_node">
        <dc:Bounds x="0" y="0" width="564" height="144" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="212" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="216" y="94" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_main_di" bpmnElement="task_main">
        <dc:Bounds x="328" y="32" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="508" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512" y="94" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_isolated_di" bpmnElement="task_isolated">
        <dc:Bounds x="62" y="32" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="248" y="72" />
        <di:waypoint x="328" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="428" y="72" />
        <di:waypoint x="508" y="72" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
