<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_blackbox_middle" targetNamespace="http://example.com/test-blackbox-middle" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="经清算所的双边交易">
    <bpmn:participant id="pool_buyer" name="买方券商" processRef="process_buyer" />
    <bpmn:participant id="pool_clearing" name="清算所（外部黑盒）" processRef="Process_pool_clearing" />
    <bpmn:participant id="pool_seller" name="卖方券商" processRef="process_seller" />
    <bpmn:messageFlow id="msgflow_buyer_to_clearing" name="交易申报" sourceRef="task_submit_trade" targetRef="pool_clearing" />
    <bpmn:messageFlow id="msgflow_seller_to_clearing" name="交收指令" sourceRef="task_confirm_settle" targetRef="pool_clearing" />
    <bpmn:messageFlow id="msgflow_clearing_to_seller" name="清算款项" sourceRef="pool_clearing" targetRef="task_receive_funds" />
    <bpmn:messageFlow id="msgflow_buyer_to_seller_direct" name="成交回执（直连）" sourceRef="task_send_contract" targetRef="start_seller" />
  </bpmn:collaboration>
  <bpmn:process id="process_buyer" name="买方券商" isExecutable="true">
    <bpmn:startEvent id="start_buyer" name="交易日开始">
      <bpmn:outgoing>flow_b1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="task_submit_trade" name="提交交易申报">
      <bpmn:incoming>flow_b1</bpmn:incoming>
      <bpmn:outgoing>flow_b2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="task_send_contract" name="直发成交回执">
      <bpmn:incoming>flow_b2</bpmn:incoming>
      <bpmn:outgoing>flow_b3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_buyer" name="买方完成">
      <bpmn:incoming>flow_b3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_b1" sourceRef="start_buyer" targetRef="task_submit_trade" />
    <bpmn:sequenceFlow id="flow_b2" sourceRef="task_submit_trade" targetRef="task_send_contract" />
    <bpmn:sequenceFlow id="flow_b3" sourceRef="task_send_contract" targetRef="end_buyer" />
  </bpmn:process>
  <bpmn:process id="process_seller" name="卖方券商" isExecutable="true">
    <bpmn:startEvent id="start_seller" name="收到成交回执">
      <bpmn:outgoing>flow_s1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="task_confirm_settle" name="确认交收指令">
      <bpmn:incoming>flow_s1</bpmn:incoming>
      <bpmn:outgoing>flow_s2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="task_receive_funds" name="接收清算款项">
      <bpmn:incoming>flow_s2</bpmn:incoming>
      <bpmn:outgoing>flow_s3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="end_seller" name="卖方完成">
      <bpmn:incoming>flow_s3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_s1" sourceRef="start_seller" targetRef="task_confirm_settle" />
    <bpmn:sequenceFlow id="flow_s2" sourceRef="task_confirm_settle" targetRef="task_receive_funds" />
    <bpmn:sequenceFlow id="flow_s3" sourceRef="task_receive_funds" targetRef="end_seller" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_blackbox_middle" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_blackbox_middle" bpmnElement="collaboration_1">
      <bpmndi:BPMNShape id="collaboration_1_di" bpmnElement="collaboration_1">
        <dc:Bounds x="0" y="0" width="922" height="448" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_buyer_di" bpmnElement="pool_buyer" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="594" height="144" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_buyer_di" bpmnElement="start_buyer">
        <dc:Bounds x="62" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="45" y="94" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_trade_di" bpmnElement="task_submit_trade">
