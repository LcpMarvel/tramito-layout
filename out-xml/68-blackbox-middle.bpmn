      <bpmndi:BPMNShape id="task_send_contract_di" bpmnElement="task_send_contract">
        <dc:Bounds x="358" y="32" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_buyer_di" bpmnElement="end_buyer">
        <dc:Bounds x="538" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="528" y="94" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_clearing_di" bpmnElement="pool_clearing" isHorizontal="true">
        <dc:Bounds x="0" y="174" width="594" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_seller_di" bpmnElement="pool_seller" isHorizontal="true">
        <dc:Bounds x="328" y="304" width="594" height="144" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_seller_di" bpmnElement="start_seller">
        <dc:Bounds x="390" y="358" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="366" y="398" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_confirm_settle_di" bpmnElement="task_confirm_settle">
        <dc:Bounds x="506" y="336" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receive_funds_di" bpmnElement="task_receive_funds">
        <dc:Bounds x="686" y="336" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_seller_di" bpmnElement="end_seller">
        <dc:Bounds x="866" y="358" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="856" y="398" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_b1_di" bpmnElement="flow_b1">
        <di:waypoint x="98" y="72" />
        <di:waypoint x="178" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_b2_di" bpmnElement="flow_b2">
        <di:waypoint x="278" y="72" />
        <di:waypoint x="358" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_b3_di" bpmnElement="flow_b3">
        <di:waypoint x="458" y="72" />
        <di:waypoint x="538" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_s1_di" bpmnElement="flow_s1">
        <di:waypoint x="426" y="376" />
        <di:waypoint x="506" y="376" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_s2_di" bpmnElement="flow_s2">
        <di:waypoint x="606" y="376" />
        <di:waypoint x="686" y="376" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_s3_di" bpmnElement="flow_s3">
        <di:waypoint x="786" y="376" />
        <di:waypoint x="866" y="376" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msgflow_buyer_to_seller_direct_di" bpmnElement="msgflow_buyer_to_seller_direct">
        <di:waypoint x="408" y="112" />
        <di:waypoint x="408" y="358" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="413" y="191.1" width="92" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
