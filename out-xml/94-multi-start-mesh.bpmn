<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_multi_start_mesh" targetNamespace="http://example.com/test-multi-start-mesh" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_multi_start_mesh" name="多起点网状汇合测试" isExecutable="true">
    <bpmn:startEvent id="start_web" name="网页渠道发起">
      <bpmn:outgoing>flow_web</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="start_app" name="App渠道发起">
      <bpmn:outgoing>flow_app</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="start_phone" name="电话渠道发起">
      <bpmn:outgoing>flow_phone</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="start_counter" name="柜面渠道发起">
      <bpmn:outgoing>flow_counter</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_web_check" name="网页表单校验">
      <bpmn:incoming>flow_web</bpmn:incoming>
      <bpmn:outgoing>flow_web_merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_app_check" name="App实名核验">
      <bpmn:incoming>flow_app</bpmn:incoming>
      <bpmn:outgoing>flow_app_merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_phone_record" name="电话录音登记">
      <bpmn:incoming>flow_phone</bpmn:incoming>
      <bpmn:outgoing>flow_phone_merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_online_merge" name="线上渠道汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_web_merge</bpmn:incoming>
      <bpmn:incoming>flow_app_merge</bpmn:incoming>
      <bpmn:outgoing>flow_online_process</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_offline_merge" name="线下渠道汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_counter</bpmn:incoming>
      <bpmn:incoming>flow_phone_merge</bpmn:incoming>
      <bpmn:outgoing>flow_offline_process</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_online_process" name="线上统一受理">
      <bpmn:incoming>flow_online_process</bpmn:incoming>
      <bpmn:outgoing>flow_online_route</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_offline_process" name="线下人工受理">
      <bpmn:incoming>flow_offline_process</bpmn:incoming>
      <bpmn:outgoing>flow_offline_manual</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_route" name="是否自动审批" gatewayDirection="Diverging">
      <bpmn:incoming>flow_online_route</bpmn:incoming>
      <bpmn:outgoing>flow_route_auto</bpmn:outgoing>
      <bpmn:outgoing>flow_route_manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_manual_merge" name="人工通道汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_route_manual</bpmn:incoming>
      <bpmn:incoming>flow_offline_manual</bpmn:incoming>
      <bpmn:outgoing>flow_manual_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_auto" name="自动办结">
      <bpmn:incoming>flow_route_auto</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_manual" name="人工办结">
      <bpmn:incoming>flow_manual_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_web" sourceRef="start_web" targetRef="task_web_check" />
    <bpmn:sequenceFlow id="flow_app" sourceRef="start_app" targetRef="task_app_check" />
    <bpmn:sequenceFlow id="flow_phone" sourceRef="start_phone" targetRef="task_phone_record" />
    <bpmn:sequenceFlow id="flow_counter" name="柜面直接受理" sourceRef="start_counter" targetRef="gateway_offline_merge" />
    <bpmn:sequenceFlow id="flow_web_merge" sourceRef="task_web_check" targetRef="gateway_online_merge" />
    <bpmn:sequenceFlow id="flow_app_merge" sourceRef="task_app_check" targetRef="gateway_online_merge" />
    <bpmn:sequenceFlow id="flow_phone_merge" sourceRef="task_phone_record" targetRef="gateway_offline_merge" />
    <bpmn:sequenceFlow id="flow_online_process" sourceRef="gateway_online_merge" targetRef="task_online_process" />
    <bpmn:sequenceFlow id="flow_offline_process" sourceRef="gateway_offline_merge" targetRef="task_offline_process" />
    <bpmn:sequenceFlow id="flow_online_route" sourceRef="task_online_process" targetRef="gateway_route" />
    <bpmn:sequenceFlow id="flow_route_auto" name="满足自动审批规则" sourceRef="gateway_route" targetRef="end_auto" />
    <bpmn:sequenceFlow id="flow_route_manual" name="需人工复核" sourceRef="gateway_route" targetRef="gateway_manual_merge" />
    <bpmn:sequenceFlow id="flow_offline_manual" sourceRef="task_offline_process" targetRef="gateway_manual_merge" />
    <bpmn:sequenceFlow id="flow_manual_end" sourceRef="gateway_manual_merge" targetRef="end_manual" />
  </bpmn:process>
