<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_long_chinese_labels" targetNamespace="http://example.com/test-long-chinese-labels" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_long_labels" name="超长中文标签压力测试流程" isExecutable="true">
    <bpmn:startEvent id="start_1" name="员工在企业自助门户系统中发起差旅费用报销申请并上传全部原始票据影像">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit" name="申请人逐项填写差旅明细并对每张发票的真实性与关联性作出书面承诺">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_dept_review" name="由部门负责人对提交的报销单据进行真实性与合规性双重审查确认无误">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_amount" name="根据报销金额是否超过五千元人民币的阈值判断是否需要财务总监复核" gatewayDirection="Diverging">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_large</bpmn:outgoing>
      <bpmn:outgoing>flow_small</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_cfo_review" name="财务总监结合年度预算执行进度对大额报销事项进行专项复核并签署意见">
      <bpmn:incoming>flow_large</bpmn:incoming>
      <bpmn:outgoing>flow_cfo_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_merge" name="汇聚大额复核分支与小额直通分支后统一进入财务付款处理环节" gatewayDirection="Converging">
      <bpmn:incoming>flow_small</bpmn:incoming>
      <bpmn:incoming>flow_cfo_merge</bpmn:incoming>
      <bpmn:outgoing>flow_pay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_payment" name="财务共享中心通过银企直联通道将报销款项支付至员工本人工资卡账户">
      <bpmn:incoming>flow_pay</bpmn:incoming>
      <bpmn:outgoing>flow_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="报销流程全部办结并将电子凭证归档至企业财务档案管理系统长期保存">
      <bpmn:incoming>flow_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" name="申请发起后立即进入差旅明细填写与票据承诺确认环节继续办理" sourceRef="start_1" targetRef="task_submit" />
    <bpmn:sequenceFlow id="flow_2" name="明细填写完整且票据影像清晰可辨后转交部门负责人开展双重审查" sourceRef="task_submit" targetRef="task_dept_review" />
    <bpmn:sequenceFlow id="flow_3" name="部门审查通过后依据单据合计金额自动进入分级审批路由判断节点" sourceRef="task_dept_review" targetRef="gateway_amount" />
    <bpmn:sequenceFlow id="flow_large" name="报销金额超过五千元人民币阈值必须提交财务总监进行专项复核审批" sourceRef="gateway_amount" targetRef="task_cfo_review" />
    <bpmn:sequenceFlow id="flow_small" name="报销金额未超过五千元人民币阈值可跳过专项复核直接进入付款环节" sourceRef="gateway_amount" targetRef="gateway_merge" />
    <bpmn:sequenceFlow id="flow_cfo_merge" name="财务总监签署同意意见后大额分支汇入统一付款处理主干流程继续" sourceRef="task_cfo_review" targetRef="gateway_merge" />
    <bpmn:sequenceFlow id="flow_pay" name="审批链路全部完成后系统自动生成付款指令并推送至银企直联通道" sourceRef="gateway_merge" targetRef="task_payment" />
    <bpmn:sequenceFlow id="flow_end" name="付款成功回执到达后流程办结并触发电子会计凭证自动归档动作" sourceRef="task_payment" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_long_chinese_labels" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_long_chinese_labels" bpmnElement="process_long_labels">
