<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_boundary_long_chain_merge" targetNamespace="http://example.com/test-boundary-long-chain-merge" exporter="bpmn-elk-layout" exporterVersion="1.0.0">
  <bpmn:error id="err_payment" name="扣款失败" errorCode="PAY_001" />
  <bpmn:process id="process_order_fulfillment" name="订单履约（扣款失败长链恢复）" isExecutable="true">
    <bpmn:startEvent id="start_order" name="接到订单">
      <bpmn:outgoing>flow_start_receive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_receive" name="校验订单信息">
      <bpmn:incoming>flow_start_receive</bpmn:incoming>
      <bpmn:outgoing>flow_receive_pay</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_pay" name="执行扣款">
      <bpmn:incoming>flow_receive_pay</bpmn:incoming>
      <bpmn:outgoing>flow_pay_ship</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="boundary_pay_error" name="扣款失败" attachedToRef="task_pay">
      <bpmn:outgoing>flow_bd_h1</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="err_payment" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="task_ship" name="安排发货">
      <bpmn:incoming>flow_pay_ship</bpmn:incoming>
      <bpmn:outgoing>flow_ship_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_merge" name="履约汇聚">
      <bpmn:incoming>flow_ship_merge</bpmn:incoming>
      <bpmn:incoming>flow_h6_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="task_notify_customer" name="通知客户">
      <bpmn:incoming>flow_merge_notify</bpmn:incoming>
      <bpmn:outgoing>flow_notify_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_done" name="履约完成">
      <bpmn:incoming>flow_notify_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_h1_log" name="记录扣款失败">
      <bpmn:incoming>flow_bd_h1</bpmn:incoming>
      <bpmn:outgoing>flow_h1_h2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_h2_reverse" name="冲正交易">
      <bpmn:incoming>flow_h1_h2</bpmn:incoming>
      <bpmn:outgoing>flow_h2_h3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_h3_contact" name="客服联系客户">
      <bpmn:incoming>flow_h2_h3</bpmn:incoming>
      <bpmn:outgoing>flow_h3_h4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_h4_update" name="更新支付方式">
      <bpmn:incoming>flow_h3_h4</bpmn:incoming>
      <bpmn:outgoing>flow_h4_h5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_h5_retry" name="重新发起扣款">
      <bpmn:incoming>flow_h4_h5</bpmn:incoming>
      <bpmn:outgoing>flow_h5_h6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_h6_reship" name="重排发货计划">
      <bpmn:incoming>flow_h5_h6</bpmn:incoming>
      <bpmn:outgoing>flow_h6_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_start_receive" sourceRef="start_order" targetRef="task_receive" />
    <bpmn:sequenceFlow id="flow_receive_pay" sourceRef="task_receive" targetRef="task_pay" />
    <bpmn:sequenceFlow id="flow_pay_ship" sourceRef="task_pay" targetRef="task_ship" />
    <bpmn:sequenceFlow id="flow_ship_merge" name="正常履约" sourceRef="task_ship" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="flow_merge_notify" sourceRef="gw_merge" targetRef="task_notify_customer" />
    <bpmn:sequenceFlow id="flow_notify_end" sourceRef="task_notify_customer" targetRef="end_done" />
    <bpmn:sequenceFlow id="flow_bd_h1" sourceRef="boundary_pay_error" targetRef="task_h1_log" />
    <bpmn:sequenceFlow id="flow_h1_h2" sourceRef="task_h1_log" targetRef="task_h2_reverse" />
    <bpmn:sequenceFlow id="flow_h2_h3" sourceRef="task_h2_reverse" targetRef="task_h3_contact" />
    <bpmn:sequenceFlow id="flow_h3_h4" sourceRef="task_h3_contact" targetRef="task_h4_update" />
    <bpmn:sequenceFlow id="flow_h4_h5" sourceRef="task_h4_update" targetRef="task_h5_retry" />
    <bpmn:sequenceFlow id="flow_h5_h6" sourceRef="task_h5_retry" targetRef="task_h6_reship" />
    <bpmn:sequenceFlow id="flow_h6_merge" name="恢复后回归" sourceRef="task_h6_reship" targetRef="gw_merge" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_boundary_long_chain_merge" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_boundary_long_chain_merge" bpmnElement="process_order_fulfillment">
      <bpmndi:BPMNShape id="process_order_fulfillment_di" bpmnElement="process_order_fulfillment">
        <dc:Bounds x="0" y="0" width="1984" height="284" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_order_di" bpmnElement="start_order">
        <dc:Bounds x="62" y="124" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="30" y="164" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receive_di" bpmnElement="task_receive">
        <dc:Bounds x="178" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_pay_di" bpmnElement="task_pay">
        <dc:Bounds x="358" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundary_pay_error_di" bpmnElement="boundary_pay_error">
        <dc:Bounds x="360" y="164" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="351" y="204" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ship_di" bpmnElement="task_ship">
        <dc:Bounds x="718" y="32" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_di" bpmnElement="gw_merge">
        <dc:Bounds x="1618" y="117" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1615" y="99" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_notify_customer_di" bpmnElement="task_notify_customer">
        <dc:Bounds x="1748" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_done_di" bpmnElement="end_done">
        <dc:Bounds x="1928" y="124" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1896" y="164" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_h1_log_di" bpmnElement="task_h1_log">
        <dc:Bounds x="538" y="172" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_h2_reverse_di" bpmnElement="task_h2_reverse">
        <dc:Bounds x="718" y="172" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_h3_contact_di" bpmnElement="task_h3_contact">
        <dc:Bounds x="898" y="172" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_h4_update_di" bpmnElement="task_h4_update">
        <dc:Bounds x="1078" y="172" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_h5_retry_di" bpmnElement="task_h5_retry">
        <dc:Bounds x="1258" y="172" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_h6_reship_di" bpmnElement="task_h6_reship">
        <dc:Bounds x="1438" y="172" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_receive_di" bpmnElement="flow_start_receive">
        <di:waypoint x="98" y="142" />
        <di:waypoint x="178" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_receive_pay_di" bpmnElement="flow_receive_pay">
        <di:waypoint x="278" y="142" />
        <di:waypoint x="358" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_pay_ship_di" bpmnElement="flow_pay_ship">
        <di:waypoint x="458" y="142" />
        <di:waypoint x="588" y="142" />
        <di:waypoint x="588" y="72" />
        <di:waypoint x="718" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ship_merge_di" bpmnElement="flow_ship_merge">
        <di:waypoint x="818" y="72" />
        <di:waypoint x="1218" y="72" />
        <di:waypoint x="1218" y="142" />
        <di:waypoint x="1618" y="142" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="993" y="53" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_notify_di" bpmnElement="flow_merge_notify">
        <di:waypoint x="1668" y="142" />
        <di:waypoint x="1748" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_end_di" bpmnElement="flow_notify_end">
        <di:waypoint x="1848" y="142" />
        <di:waypoint x="1928" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bd_h1_di" bpmnElement="flow_bd_h1">
        <di:waypoint x="378" y="200" />
        <di:waypoint x="378" y="222" />
        <di:waypoint x="538" y="222" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_h1_h2_di" bpmnElement="flow_h1_h2">
        <di:waypoint x="638" y="212" />
        <di:waypoint x="718" y="212" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_h2_h3_di" bpmnElement="flow_h2_h3">
        <di:waypoint x="818" y="212" />
        <di:waypoint x="898" y="212" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_h3_h4_di" bpmnElement="flow_h3_h4">
        <di:waypoint x="998" y="212" />
        <di:waypoint x="1078" y="212" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_h4_h5_di" bpmnElement="flow_h4_h5">
        <di:waypoint x="1178" y="212" />
        <di:waypoint x="1258" y="212" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_h5_h6_di" bpmnElement="flow_h5_h6">
        <di:waypoint x="1358" y="212" />
        <di:waypoint x="1438" y="212" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_h6_merge_di" bpmnElement="flow_h6_merge">
        <di:waypoint x="1538" y="212" />
        <di:waypoint x="1578" y="212" />
        <di:waypoint x="1578" y="142" />
        <di:waypoint x="1618" y="142" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1583" y="170" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
