        <di:waypoint x="456.33333333333337" y="142" />
        <di:waypoint x="504.66666666666674" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_partial_log_di" bpmnElement="flow_partial_log">
        <di:waypoint x="554.6666666666667" y="142" />
