          <dc:Bounds x="514" y="146" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tx_boundary_cancel_di" bpmnElement="tx_boundary_cancel">
        <dc:Bounds x="180" y="178" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="171" y="218" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_cancel_handler_di" bpmnElement="task_cancel_handler">
        <dc:Bounds x="694" y="101.33333333333333" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_main_di" bpmnElement="end_main">
