      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="tx_flow_1_di" bpmnElement="tx_flow_1">
        <di:waypoint x="246" y="124" />
        <di:waypoint x="346" y="124" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tx_flow_2_di" bpmnElement="tx_flow_2">
        <di:waypoint x="446" y="124" />
        <di:waypoint x="546" y="124" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="main_flow_1_di" bpmnElement="main_flow_1">
        <di:waypoint x="98" y="114" />
