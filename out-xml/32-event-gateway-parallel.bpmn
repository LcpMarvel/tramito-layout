<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_event_gateway_parallel" targetNamespace="http://example.com/test-event-gateway-parallel" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:message id="msg_order" name="订单消息" />
  <bpmn:message id="msg_payment" name="支付消息" />
  <bpmn:signal id="sig_cancel" name="取消信号" />
  <bpmn:process id="process_event_gateway_parallel" name="并行事件网关测试" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_init" name="初始化订单">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_to_parallel_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="gateway_event_parallel" name="并行事件网关" gatewayDirection="Diverging" eventGatewayType="Parallel">
      <bpmn:incoming>flow_to_parallel_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_parallel_order</bpmn:outgoing>
      <bpmn:outgoing>flow_parallel_payment</bpmn:outgoing>
      <bpmn:outgoing>flow_parallel_timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="catch_message_order" name="等待订单确认">
      <bpmn:incoming>flow_parallel_order</bpmn:incoming>
      <bpmn:outgoing>flow_order_process</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_order" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch_message_payment" name="等待支付确认">
      <bpmn:incoming>flow_parallel_payment</bpmn:incoming>
      <bpmn:outgoing>flow_payment_process</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_payment" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch_timer" name="等待超时">
      <bpmn:incoming>flow_parallel_timer</bpmn:incoming>
      <bpmn:outgoing>flow_timer_process</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_process_order" name="处理订单">
      <bpmn:incoming>flow_order_process</bpmn:incoming>
      <bpmn:outgoing>flow_order_to_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_process_payment" name="处理支付">
      <bpmn:incoming>flow_payment_process</bpmn:incoming>
      <bpmn:outgoing>flow_payment_to_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_timeout_handler" name="超时处理">
      <bpmn:incoming>flow_timer_process</bpmn:incoming>
      <bpmn:outgoing>flow_timeout_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="gateway_parallel_join" name="并行汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_order_to_join</bpmn:incoming>
      <bpmn:incoming>flow_payment_to_join</bpmn:incoming>
      <bpmn:outgoing>flow_join_to_exclusive</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="task_complete" name="完成订单">
      <bpmn:incoming>flow_continue_complete</bpmn:incoming>
      <bpmn:outgoing>flow_complete_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_success" name="成功结束">
      <bpmn:incoming>flow_complete_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_timeout" name="超时结束">
      <bpmn:incoming>flow_timeout_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="gateway_event_exclusive" name="排他事件网关" gatewayDirection="Diverging">
      <bpmn:incoming>flow_join_to_exclusive</bpmn:incoming>
      <bpmn:outgoing>flow_exclusive_cancel</bpmn:outgoing>
      <bpmn:outgoing>flow_exclusive_continue</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="catch_signal_cancel" name="等待取消">
      <bpmn:incoming>flow_exclusive_cancel</bpmn:incoming>
      <bpmn:outgoing>flow_cancel_task</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="sig_cancel" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch_timer_continue" name="等待继续">
      <bpmn:incoming>flow_exclusive_continue</bpmn:incoming>
      <bpmn:outgoing>flow_continue_complete</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_cancel" name="取消订单">
      <bpmn:incoming>flow_cancel_task</bpmn:incoming>
      <bpmn:outgoing>flow_cancel_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_cancelled" name="已取消">
      <bpmn:incoming>flow_cancel_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="gateway_instantiate" name="实例化事件网关" gatewayDirection="Diverging" instantiate="true" />
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_init" />
    <bpmn:sequenceFlow id="flow_to_parallel_gateway" sourceRef="task_init" targetRef="gateway_event_parallel" />
    <bpmn:sequenceFlow id="flow_parallel_order" sourceRef="gateway_event_parallel" targetRef="catch_message_order" />
    <bpmn:sequenceFlow id="flow_parallel_payment" sourceRef="gateway_event_parallel" targetRef="catch_message_payment" />
    <bpmn:sequenceFlow id="flow_parallel_timer" sourceRef="gateway_event_parallel" targetRef="catch_timer" />
    <bpmn:sequenceFlow id="flow_order_process" sourceRef="catch_message_order" targetRef="task_process_order" />
    <bpmn:sequenceFlow id="flow_payment_process" sourceRef="catch_message_payment" targetRef="task_process_payment" />
    <bpmn:sequenceFlow id="flow_timer_process" sourceRef="catch_timer" targetRef="task_timeout_handler" />
    <bpmn:sequenceFlow id="flow_order_to_join" sourceRef="task_process_order" targetRef="gateway_parallel_join" />
    <bpmn:sequenceFlow id="flow_payment_to_join" sourceRef="task_process_payment" targetRef="gateway_parallel_join" />
    <bpmn:sequenceFlow id="flow_join_to_exclusive" sourceRef="gateway_parallel_join" targetRef="gateway_event_exclusive" />
    <bpmn:sequenceFlow id="flow_exclusive_cancel" sourceRef="gateway_event_exclusive" targetRef="catch_signal_cancel" />
    <bpmn:sequenceFlow id="flow_exclusive_continue" sourceRef="gateway_event_exclusive" targetRef="catch_timer_continue" />
    <bpmn:sequenceFlow id="flow_continue_complete" sourceRef="catch_timer_continue" targetRef="task_complete" />
    <bpmn:sequenceFlow id="flow_complete_end" sourceRef="task_complete" targetRef="end_success" />
    <bpmn:sequenceFlow id="flow_cancel_task" sourceRef="catch_signal_cancel" targetRef="task_cancel" />
    <bpmn:sequenceFlow id="flow_cancel_end" sourceRef="task_cancel" targetRef="end_cancelled" />
    <bpmn:sequenceFlow id="flow_timeout_end" sourceRef="task_timeout_handler" targetRef="end_timeout" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_event_gateway_parallel" name="BPMNDiagram">
