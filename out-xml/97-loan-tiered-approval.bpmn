<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_loan_tiered_approval" targetNamespace="http://example.com/loan-tiered-approval" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_loan" name="贷款分档审批" isExecutable="true">
    <bpmn:startEvent id="start_loan" name="贷款申请">
      <bpmn:outgoing>f_start_intake</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_intake" name="录入申请资料">
      <bpmn:incoming>f_start_intake</bpmn:incoming>
      <bpmn:outgoing>f_intake_split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="gw_amount_split" name="按金额分档" gatewayDirection="Diverging">
      <bpmn:incoming>f_intake_split</bpmn:incoming>
      <bpmn:outgoing>f_split_small</bpmn:outgoing>
      <bpmn:outgoing>f_split_mid</bpmn:outgoing>
      <bpmn:outgoing>f_split_large</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="task_small_approve" name="小额快速审批">
      <bpmn:incoming>f_split_small</bpmn:incoming>
      <bpmn:outgoing>f_small_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_mid_first" name="中额初审">
      <bpmn:incoming>f_split_mid</bpmn:incoming>
      <bpmn:outgoing>f_mid_1_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_mid_second" name="中额复审">
      <bpmn:incoming>f_mid_1_2</bpmn:incoming>
      <bpmn:outgoing>f_mid_2_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_mid_risk" name="中额风控审核">
      <bpmn:incoming>f_mid_2_3</bpmn:incoming>
      <bpmn:outgoing>f_mid_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_large_manager" name="客户经理初审">
      <bpmn:incoming>f_split_large</bpmn:incoming>
      <bpmn:incoming>f_committee_reject</bpmn:incoming>
      <bpmn:outgoing>f_large_1_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_large_credit" name="信贷部审核">
      <bpmn:incoming>f_large_1_2</bpmn:incoming>
      <bpmn:outgoing>f_large_2_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_large_risk" name="风控评估">
      <bpmn:incoming>f_large_2_3</bpmn:incoming>
      <bpmn:outgoing>f_large_3_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_large_committee" name="贷审会审议">
      <bpmn:incoming>f_large_3_4</bpmn:incoming>
      <bpmn:outgoing>f_large_4_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_committee" name="审议结论" gatewayDirection="Diverging">
      <bpmn:incoming>f_large_4_gw</bpmn:incoming>
      <bpmn:outgoing>f_committee_reject</bpmn:outgoing>
      <bpmn:outgoing>f_committee_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_large_president" name="行长终审">
      <bpmn:incoming>f_committee_pass</bpmn:incoming>
      <bpmn:outgoing>f_large_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="gw_merge_tiers" name="汇总审批结果" gatewayDirection="Converging">
      <bpmn:incoming>f_small_merge</bpmn:incoming>
      <bpmn:incoming>f_mid_merge</bpmn:incoming>
      <bpmn:incoming>f_large_merge</bpmn:incoming>
      <bpmn:outgoing>f_merge_disburse</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="task_disburse" name="放款">
      <bpmn:incoming>f_merge_disburse</bpmn:incoming>
      <bpmn:outgoing>f_disburse_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_loan_done" name="放款完成">
      <bpmn:incoming>f_disburse_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_intake" sourceRef="start_loan" targetRef="task_intake" />
    <bpmn:sequenceFlow id="f_intake_split" sourceRef="task_intake" targetRef="gw_amount_split" />
    <bpmn:sequenceFlow id="f_split_small" name="小额" sourceRef="gw_amount_split" targetRef="task_small_approve" />
    <bpmn:sequenceFlow id="f_split_mid" name="中额" sourceRef="gw_amount_split" targetRef="task_mid_first" />
    <bpmn:sequenceFlow id="f_split_large" name="大额" sourceRef="gw_amount_split" targetRef="task_large_manager" />
    <bpmn:sequenceFlow id="f_small_merge" sourceRef="task_small_approve" targetRef="gw_merge_tiers" />
    <bpmn:sequenceFlow id="f_mid_1_2" sourceRef="task_mid_first" targetRef="task_mid_second" />
    <bpmn:sequenceFlow id="f_mid_2_3" sourceRef="task_mid_second" targetRef="task_mid_risk" />
    <bpmn:sequenceFlow id="f_mid_merge" sourceRef="task_mid_risk" targetRef="gw_merge_tiers" />
    <bpmn:sequenceFlow id="f_large_1_2" sourceRef="task_large_manager" targetRef="task_large_credit" />
    <bpmn:sequenceFlow id="f_large_2_3" sourceRef="task_large_credit" targetRef="task_large_risk" />
    <bpmn:sequenceFlow id="f_large_3_4" sourceRef="task_large_risk" targetRef="task_large_committee" />
    <bpmn:sequenceFlow id="f_large_4_gw" sourceRef="task_large_committee" targetRef="gw_committee" />
    <bpmn:sequenceFlow id="f_committee_reject" name="驳回补件" sourceRef="gw_committee" targetRef="task_large_manager" />
    <bpmn:sequenceFlow id="f_committee_pass" name="通过" sourceRef="gw_committee" targetRef="task_large_president" />
    <bpmn:sequenceFlow id="f_large_merge" sourceRef="task_large_president" targetRef="gw_merge_tiers" />
    <bpmn:sequenceFlow id="f_merge_disburse" sourceRef="gw_merge_tiers" targetRef="task_disburse" />
    <bpmn:sequenceFlow id="f_disburse_end" sourceRef="task_disburse" targetRef="end_loan_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_loan_tiered_approval" name="BPMNDiagram">
