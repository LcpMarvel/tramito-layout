  <bpmn:process id="process_root" name="流程" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_2" name="修图专员修图">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_9b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_3" name="部门经理审核">
      <bpmn:incoming>flow_9b</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_4" name="部门经理审核结果" default="flow_12">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_5" name="客户审核">
