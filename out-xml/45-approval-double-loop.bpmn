    <bpmn:sequenceFlow id="flow_14" sourceRef="gateway_6" targetRef="end_7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_9" sourceRef="gateway_6" targetRef="task_3" />
  </bpmn:process>
