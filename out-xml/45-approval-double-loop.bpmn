      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_6" name="客户审核结果" default="flow_9">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_7" name="完成">
      <bpmn:incoming>flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_8" sourceRef="start_1" targetRef="task_2" />
    <bpmn:sequenceFlow id="flow_9b" sourceRef="task_2" targetRef="task_3" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="task_3" targetRef="gateway_4" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="gateway_4" targetRef="task_5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_12" sourceRef="gateway_4" targetRef="task_2" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="task_5" targetRef="gateway_6" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="gateway_6" targetRef="end_7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_9" sourceRef="gateway_6" targetRef="task_3" />
  </bpmn:process>
