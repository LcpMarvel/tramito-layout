<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_recruitment_interview" targetNamespace="http://example.com/recruitment-interview-rounds" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:message id="msg_invite" name="面试邀约" />
  <bpmn:message id="msg_confirm" name="面试确认" />
  <bpmn:message id="msg_result" name="结果通知" />
  <bpmn:message id="msg_offer" name="Offer通知" />
  <bpmn:collaboration id="collaboration_recruit" name="招聘面试流程">
    <bpmn:participant id="pool_company" name="公司" processRef="process_company" />
    <bpmn:participant id="pool_candidate" name="候选人" processRef="process_candidate" />
    <bpmn:messageFlow id="mf_invite" sourceRef="task_send_invite" targetRef="start_candidate" messageRef="msg_invite" />
    <bpmn:messageFlow id="mf_confirm" sourceRef="task_confirm_time" targetRef="event_recv_confirm" messageRef="msg_confirm" />
    <bpmn:messageFlow id="mf_result" sourceRef="task_send_reject" targetRef="event_recv_result" messageRef="msg_result" />
    <bpmn:messageFlow id="mf_offer" sourceRef="task_send_offer" targetRef="event_recv_offer" messageRef="msg_offer" />
  </bpmn:collaboration>
  <bpmn:process id="process_company" name="公司" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_hr" name="HR">
        <bpmn:flowNodeRef>start_resume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_screen_resume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_recv_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_interviewer" name="面试官">
        <bpmn:flowNodeRef>task_interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_interview_result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_hrbp" name="HRBP">
        <bpmn:flowNodeRef>task_offer_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_hired</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_resume" name="收到简历投递">
      <bpmn:outgoing>f_resume_screen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_screen_resume" name="简历筛选">
      <bpmn:incoming>f_resume_screen</bpmn:incoming>
      <bpmn:outgoing>f_screen_invite</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="task_send_invite" name="发送面试邀约">
      <bpmn:incoming>f_screen_invite</bpmn:incoming>
      <bpmn:incoming>f_result_more</bpmn:incoming>
      <bpmn:outgoing>f_invite_confirm</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="event_recv_confirm" name="收到候选人确认">
      <bpmn:incoming>f_invite_confirm</bpmn:incoming>
      <bpmn:outgoing>f_confirm_interview</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_confirm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="task_send_reject" name="发送结果通知">
      <bpmn:incoming>f_result_fail</bpmn:incoming>
      <bpmn:outgoing>f_reject_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_rejected" name="招聘终止">
      <bpmn:incoming>f_reject_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_interview" name="面试评估">
      <bpmn:incoming>f_confirm_interview</bpmn:incoming>
      <bpmn:outgoing>f_interview_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_interview_result" name="面试结论" gatewayDirection="Diverging">
      <bpmn:incoming>f_interview_gw</bpmn:incoming>
      <bpmn:outgoing>f_result_more</bpmn:outgoing>
      <bpmn:outgoing>f_result_fail</bpmn:outgoing>
      <bpmn:outgoing>f_result_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_offer_review" name="Offer审批">
      <bpmn:incoming>f_result_pass</bpmn:incoming>
      <bpmn:outgoing>f_review_offer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="task_send_offer" name="发放Offer">
      <bpmn:incoming>f_review_offer</bpmn:incoming>
      <bpmn:outgoing>f_offer_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_hired" name="录用完成">
      <bpmn:incoming>f_offer_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_resume_screen" sourceRef="start_resume" targetRef="task_screen_resume" />
    <bpmn:sequenceFlow id="f_screen_invite" sourceRef="task_screen_resume" targetRef="task_send_invite" />
    <bpmn:sequenceFlow id="f_invite_confirm" sourceRef="task_send_invite" targetRef="event_recv_confirm" />
    <bpmn:sequenceFlow id="f_confirm_interview" sourceRef="event_recv_confirm" targetRef="task_interview" />
    <bpmn:sequenceFlow id="f_interview_gw" sourceRef="task_interview" targetRef="gw_interview_result" />
    <bpmn:sequenceFlow id="f_result_more" name="需加面" sourceRef="gw_interview_result" targetRef="task_send_invite" />
    <bpmn:sequenceFlow id="f_result_fail" name="不通过" sourceRef="gw_interview_result" targetRef="task_send_reject" />
    <bpmn:sequenceFlow id="f_reject_end" sourceRef="task_send_reject" targetRef="end_rejected" />
    <bpmn:sequenceFlow id="f_result_pass" name="通过" sourceRef="gw_interview_result" targetRef="task_offer_review" />
    <bpmn:sequenceFlow id="f_review_offer" sourceRef="task_offer_review" targetRef="task_send_offer" />
    <bpmn:sequenceFlow id="f_offer_end" sourceRef="task_send_offer" targetRef="end_hired" />
  </bpmn:process>
  <bpmn:process id="process_candidate" name="候选人" isExecutable="true">
    <bpmn:startEvent id="start_candidate" name="收到面试邀约">
      <bpmn:outgoing>f_cand_confirm</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_invite" />
    </bpmn:startEvent>
    <bpmn:sendTask id="task_confirm_time" name="确认面试时间">
      <bpmn:incoming>f_cand_confirm</bpmn:incoming>
      <bpmn:outgoing>f_cand_attend</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="task_attend_interview" name="参加面试">
      <bpmn:incoming>f_cand_attend</bpmn:incoming>
      <bpmn:outgoing>f_cand_result</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="event_recv_result" name="收到结果通知">
      <bpmn:incoming>f_cand_result</bpmn:incoming>
      <bpmn:outgoing>f_cand_offer</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_result" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="event_recv_offer" name="收到Offer">
      <bpmn:incoming>f_cand_offer</bpmn:incoming>
      <bpmn:outgoing>f_cand_end</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_offer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_candidate" name="求职结束">
      <bpmn:incoming>f_cand_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_cand_confirm" sourceRef="start_candidate" targetRef="task_confirm_time" />
    <bpmn:sequenceFlow id="f_cand_attend" sourceRef="task_confirm_time" targetRef="task_attend_interview" />
    <bpmn:sequenceFlow id="f_cand_result" sourceRef="task_attend_interview" targetRef="event_recv_result" />
    <bpmn:sequenceFlow id="f_cand_offer" sourceRef="event_recv_result" targetRef="event_recv_offer" />
    <bpmn:sequenceFlow id="f_cand_end" sourceRef="event_recv_offer" targetRef="end_candidate" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_recruitment_interview" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_recruitment_interview" bpmnElement="collaboration_recruit">
