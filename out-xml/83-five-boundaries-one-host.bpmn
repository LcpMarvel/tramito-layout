      <bpmndi:BPMNEdge id="flow_bd_error_fix_di" bpmnElement="flow_bd_error_fix">
        <di:waypoint x="238" y="253" />
        <di:waypoint x="238" y="159" />
        <di:waypoint x="488" y="159" />
        <di:waypoint x="488" y="201" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fix_abort_di" bpmnElement="flow_fix_abort">
        <di:waypoint x="538" y="241" />
        <di:waypoint x="618" y="241" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bd_msg_update_di" bpmnElement="flow_bd_msg_update">
        <di:waypoint x="278" y="369" />
        <di:waypoint x="278" y="379" />
        <di:waypoint x="428" y="379" />
        <di:waypoint x="428" y="349" />
        <di:waypoint x="428" y="321" />
        <di:waypoint x="488" y="321" />
        <di:waypoint x="488" y="341" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bd_signal_log_di" bpmnElement="flow_bd_signal_log">
        <di:waypoint x="318" y="369" />
        <di:waypoint x="318" y="437" />
        <di:waypoint x="488" y="437" />
        <di:waypoint x="488" y="481" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bd_esc_escalate_di" bpmnElement="flow_bd_esc_escalate">
        <di:waypoint x="358" y="369" />
        <di:waypoint x="358" y="519" />
        <di:waypoint x="428" y="519" />
        <di:waypoint x="428" y="601" />
        <di:waypoint x="488" y="601" />
        <di:waypoint x="488" y="621" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_escalate_end_di" bpmnElement="flow_escalate_end">
        <di:waypoint x="538" y="661" />
        <di:waypoint x="618" y="661" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
