<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_three_subprocess_siblings" targetNamespace="http://example.com/test-three-subprocess-siblings" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_procurement" name="采购全流程" isExecutable="true">
    <bpmn:startEvent id="start_main" name="采购申请">
      <bpmn:outgoing>main_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="sub_demand" name="需求确认">
      <bpmn:incoming>main_flow_1</bpmn:incoming>
      <bpmn:outgoing>main_flow_2</bpmn:outgoing>
      <bpmn:startEvent id="demand_start" name="需求受理">
        <bpmn:outgoing>demand_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="demand_task_collect" name="汇总需求清单">
        <bpmn:incoming>demand_flow_1</bpmn:incoming>
        <bpmn:outgoing>demand_flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="demand_task_confirm" name="部门确认需求">
        <bpmn:incoming>demand_flow_2</bpmn:incoming>
        <bpmn:outgoing>demand_flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="demand_end" name="需求确认完成">
        <bpmn:incoming>demand_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="demand_flow_1" sourceRef="demand_start" targetRef="demand_task_collect" />
      <bpmn:sequenceFlow id="demand_flow_2" sourceRef="demand_task_collect" targetRef="demand_task_confirm" />
      <bpmn:sequenceFlow id="demand_flow_3" sourceRef="demand_task_confirm" targetRef="demand_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="sub_bidding" name="供应商比价">
      <bpmn:incoming>main_flow_2</bpmn:incoming>
      <bpmn:outgoing>main_flow_3</bpmn:outgoing>
      <bpmn:startEvent id="bidding_start" name="发起询价">
        <bpmn:outgoing>bidding_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="bidding_task_invite" name="邀请供应商报价">
        <bpmn:incoming>bidding_flow_1</bpmn:incoming>
        <bpmn:outgoing>bidding_flow_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="bidding_task_compare" name="比价评估">
        <bpmn:incoming>bidding_flow_2</bpmn:incoming>
        <bpmn:outgoing>bidding_flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="bidding_end" name="选定供应商">
        <bpmn:incoming>bidding_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="bidding_flow_1" sourceRef="bidding_start" targetRef="bidding_task_invite" />
      <bpmn:sequenceFlow id="bidding_flow_2" sourceRef="bidding_task_invite" targetRef="bidding_task_compare" />
      <bpmn:sequenceFlow id="bidding_flow_3" sourceRef="bidding_task_compare" targetRef="bidding_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="sub_contract" name="合同签订">
      <bpmn:incoming>main_flow_3</bpmn:incoming>
      <bpmn:outgoing>main_flow_4</bpmn:outgoing>
      <bpmn:startEvent id="contract_start" name="拟定合同">
        <bpmn:outgoing>contract_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="contract_task_legal" name="法务审核合同">
        <bpmn:incoming>contract_flow_1</bpmn:incoming>
        <bpmn:outgoing>contract_flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="contract_task_sign" name="双方盖章签署">
        <bpmn:incoming>contract_flow_2</bpmn:incoming>
        <bpmn:outgoing>contract_flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="contract_end" name="合同生效">
        <bpmn:incoming>contract_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="contract_flow_1" sourceRef="contract_start" targetRef="contract_task_legal" />
      <bpmn:sequenceFlow id="contract_flow_2" sourceRef="contract_task_legal" targetRef="contract_task_sign" />
      <bpmn:sequenceFlow id="contract_flow_3" sourceRef="contract_task_sign" targetRef="contract_end" />
    </bpmn:subProcess>
    <bpmn:endEvent id="end_main" name="采购完成">
      <bpmn:incoming>main_flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="main_flow_1" sourceRef="start_main" targetRef="sub_demand" />
    <bpmn:sequenceFlow id="main_flow_2" sourceRef="sub_demand" targetRef="sub_bidding" />
    <bpmn:sequenceFlow id="main_flow_3" sourceRef="sub_bidding" targetRef="sub_contract" />
    <bpmn:sequenceFlow id="main_flow_4" sourceRef="sub_contract" targetRef="end_main" />
  </bpmn:process>
