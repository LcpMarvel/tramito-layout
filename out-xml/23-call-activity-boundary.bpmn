<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_call_activity_boundary" targetNamespace="http://example.com/test-call-activity-boundary" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:signal id="sig_cancel" name="取消信号" />
  <bpmn:error id="err_call_failure" name="调用失败" errorCode="CALL_ERR_001" />
  <bpmn:error id="err_validation" name="验证错误" errorCode="VAL_ERR_001" />
  <bpmn:escalation id="esc_timeout" name="超时升级" escalationCode="ESC_TIMEOUT" />
  <bpmn:process id="process_call_activity_boundary" name="调用活动边界事件测试" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_prepare" name="准备数据">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_to_call_order</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="call_activity_order" name="调用订单处理" calledElement="process_order_handling">
      <bpmn:incoming>flow_to_call_order</bpmn:incoming>
      <bpmn:outgoing>flow_call_order_to_payment</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="boundary_error_call_order" name="订单错误" attachedToRef="call_activity_order">
      <bpmn:outgoing>flow_order_error</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="err_call_failure" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_timer_call_order" name="订单超时" attachedToRef="call_activity_order">
      <bpmn:outgoing>flow_order_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="task_order_error_handler" name="订单错误处理">
      <bpmn:incoming>flow_order_error</bpmn:incoming>
      <bpmn:outgoing>flow_order_error_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_order_timeout_handler" name="订单超时处理">
      <bpmn:incoming>flow_order_timeout</bpmn:incoming>
      <bpmn:outgoing>flow_order_timeout_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="call_activity_payment" name="调用支付处理" calledElement="process_payment_handling">
      <bpmn:incoming>flow_call_order_to_payment</bpmn:incoming>
      <bpmn:outgoing>flow_call_payment_to_shipping</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="boundary_error_call_payment" name="支付错误" attachedToRef="call_activity_payment">
      <bpmn:outgoing>flow_payment_error</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="err_call_failure" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_escalation_call_payment" name="支付升级" cancelActivity="false" attachedToRef="call_activity_payment">
      <bpmn:outgoing>flow_payment_escalation</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="esc_timeout" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_signal_call_payment" name="取消支付" attachedToRef="call_activity_payment">
      <bpmn:outgoing>flow_payment_cancel</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="sig_cancel" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="task_payment_error_handler" name="支付错误处理">
      <bpmn:incoming>flow_payment_error</bpmn:incoming>
      <bpmn:outgoing>flow_payment_error_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_escalation_handler" name="升级处理">
      <bpmn:incoming>flow_payment_escalation</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_cancel_handler" name="取消处理">
      <bpmn:incoming>flow_payment_cancel</bpmn:incoming>
      <bpmn:outgoing>flow_cancel_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="call_activity_shipping" name="调用发货处理" calledElement="process_shipping_handling">
      <bpmn:incoming>flow_call_payment_to_shipping</bpmn:incoming>
      <bpmn:outgoing>flow_call_shipping_to_merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="boundary_message_call_shipping" name="发货消息" cancelActivity="false" attachedToRef="call_activity_shipping">
      <bpmn:outgoing>flow_shipping_status</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_conditional_call_shipping" name="库存不足" attachedToRef="call_activity_shipping">
      <bpmn:outgoing>flow_inventory</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${inventory &lt; requiredQuantity}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="task_shipping_status_handler" name="更新发货状态">
      <bpmn:incoming>flow_shipping_status</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_inventory_handler" name="库存不足处理">
      <bpmn:incoming>flow_inventory</bpmn:incoming>
      <bpmn:outgoing>flow_inventory_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_merge" name="合并" gatewayDirection="Converging">
      <bpmn:incoming>flow_call_shipping_to_merge</bpmn:incoming>
      <bpmn:incoming>flow_order_timeout_to_merge</bpmn:incoming>
      <bpmn:incoming>flow_inventory_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_finalize</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_finalize" name="最终处理">
      <bpmn:incoming>flow_merge_to_finalize</bpmn:incoming>
      <bpmn:outgoing>flow_finalize_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_success" name="成功结束">
      <bpmn:incoming>flow_finalize_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_error" name="错误结束">
      <bpmn:incoming>flow_order_error_to_end</bpmn:incoming>
      <bpmn:incoming>flow_payment_error_to_end</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="err_call_failure" />
    </bpmn:endEvent>
    <bpmn:endEvent id="end_cancelled" name="已取消">
      <bpmn:incoming>flow_cancel_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_prepare" />
    <bpmn:sequenceFlow id="flow_to_call_order" sourceRef="task_prepare" targetRef="call_activity_order" />
    <bpmn:sequenceFlow id="flow_call_order_to_payment" sourceRef="call_activity_order" targetRef="call_activity_payment" />
    <bpmn:sequenceFlow id="flow_call_payment_to_shipping" sourceRef="call_activity_payment" targetRef="call_activity_shipping" />
    <bpmn:sequenceFlow id="flow_call_shipping_to_merge" sourceRef="call_activity_shipping" targetRef="gateway_merge" />
    <bpmn:sequenceFlow id="flow_merge_to_finalize" sourceRef="gateway_merge" targetRef="task_finalize" />
    <bpmn:sequenceFlow id="flow_finalize_to_end" sourceRef="task_finalize" targetRef="end_success" />
    <bpmn:sequenceFlow id="flow_order_error" sourceRef="boundary_error_call_order" targetRef="task_order_error_handler" />
    <bpmn:sequenceFlow id="flow_order_error_to_end" sourceRef="task_order_error_handler" targetRef="end_error" />
    <bpmn:sequenceFlow id="flow_order_timeout" sourceRef="boundary_timer_call_order" targetRef="task_order_timeout_handler" />
    <bpmn:sequenceFlow id="flow_order_timeout_to_merge" sourceRef="task_order_timeout_handler" targetRef="gateway_merge" />
    <bpmn:sequenceFlow id="flow_payment_error" sourceRef="boundary_error_call_payment" targetRef="task_payment_error_handler" />
    <bpmn:sequenceFlow id="flow_payment_error_to_end" sourceRef="task_payment_error_handler" targetRef="end_error" />
    <bpmn:sequenceFlow id="flow_payment_escalation" sourceRef="boundary_escalation_call_payment" targetRef="task_escalation_handler" />
    <bpmn:sequenceFlow id="flow_payment_cancel" sourceRef="boundary_signal_call_payment" targetRef="task_cancel_handler" />
    <bpmn:sequenceFlow id="flow_cancel_to_end" sourceRef="task_cancel_handler" targetRef="end_cancelled" />
    <bpmn:sequenceFlow id="flow_shipping_status" sourceRef="boundary_message_call_shipping" targetRef="task_shipping_status_handler" />
    <bpmn:sequenceFlow id="flow_inventory" sourceRef="boundary_conditional_call_shipping" targetRef="task_inventory_handler" />
    <bpmn:sequenceFlow id="flow_inventory_to_merge" sourceRef="task_inventory_handler" targetRef="gateway_merge" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_call_activity_boundary" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_call_activity_boundary" bpmnElement="process_call_activity_boundary">
