<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_fuzz_cross_lane_dense_1" targetNamespace="http://example.com/fuzz-cross-lane-dense-1" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_fuzz1" name="跨泳道密集压测">
    <bpmn:participant id="pool_main" name="订单履行流程" processRef="process_fuzz1" />
  </bpmn:collaboration>
  <bpmn:process id="process_fuzz1" name="订单履行流程" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_customer" name="客户">
        <bpmn:flowNodeRef>start_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sales" name="销售">
        <bpmn:flowNodeRef>task_check_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_notify_ship</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_warehouse" name="仓储">
        <bpmn:flowNodeRef>task_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_pack</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_finance" name="财务">
        <bpmn:flowNodeRef>task_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_invoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_logistics" name="物流">
        <bpmn:flowNodeRef>task_handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_redeliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_order" name="提交订单">
      <bpmn:outgoing>f_start_payment</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_confirm" name="确认收货">
      <bpmn:incoming>f_notify_confirm</bpmn:incoming>
      <bpmn:outgoing>f_confirm_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_complete" name="订单完成">
      <bpmn:incoming>f_confirm_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_check_stock" name="查询库存">
      <bpmn:incoming>f_gw_check_stock</bpmn:incoming>
      <bpmn:outgoing>f_check_stock_pack</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_notify_ship" name="通知发货">
      <bpmn:incoming>f_deliver_notify</bpmn:incoming>
      <bpmn:incoming>f_redeliver_notify</bpmn:incoming>
      <bpmn:outgoing>f_notify_confirm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_pick" name="拣货">
      <bpmn:incoming>f_payment_pick</bpmn:incoming>
      <bpmn:outgoing>f_pick_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_stock" name="库存充足?">
      <bpmn:incoming>f_pick_gw</bpmn:incoming>
      <bpmn:outgoing>f_gw_check_stock</bpmn:outgoing>
      <bpmn:outgoing>f_gw_pack_direct</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_pack" name="打包">
      <bpmn:incoming>f_check_stock_pack</bpmn:incoming>
      <bpmn:incoming>f_gw_pack_direct</bpmn:incoming>
      <bpmn:outgoing>f_pack_handover</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_payment" name="收款核对">
      <bpmn:incoming>f_start_payment</bpmn:incoming>
      <bpmn:outgoing>f_payment_pick</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_invoice" name="开具发票">
      <bpmn:incoming>f_handover_invoice</bpmn:incoming>
      <bpmn:outgoing>f_invoice_gw_deliver</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_handover" name="交付快递">
      <bpmn:incoming>f_pack_handover</bpmn:incoming>
      <bpmn:outgoing>f_handover_invoice</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_deliver" name="配送成功?">
      <bpmn:incoming>f_invoice_gw_deliver</bpmn:incoming>
      <bpmn:outgoing>f_deliver_notify</bpmn:outgoing>
      <bpmn:outgoing>f_redeliver_loop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_redeliver" name="重新派送">
      <bpmn:incoming>f_redeliver_loop</bpmn:incoming>
      <bpmn:outgoing>f_redeliver_notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f_start_payment" name="付款" sourceRef="start_order" targetRef="task_payment" />
    <bpmn:sequenceFlow id="f_payment_pick" sourceRef="task_payment" targetRef="task_pick" />
    <bpmn:sequenceFlow id="f_pick_gw" sourceRef="task_pick" targetRef="gw_stock" />
    <bpmn:sequenceFlow id="f_gw_check_stock" name="不足" sourceRef="gw_stock" targetRef="task_check_stock" />
    <bpmn:sequenceFlow id="f_check_stock_pack" name="补货完成" sourceRef="task_check_stock" targetRef="task_pack" />
    <bpmn:sequenceFlow id="f_gw_pack_direct" name="充足" sourceRef="gw_stock" targetRef="task_pack" />
    <bpmn:sequenceFlow id="f_pack_handover" sourceRef="task_pack" targetRef="task_handover" />
    <bpmn:sequenceFlow id="f_handover_invoice" sourceRef="task_handover" targetRef="task_invoice" />
    <bpmn:sequenceFlow id="f_invoice_gw_deliver" sourceRef="task_invoice" targetRef="gw_deliver" />
    <bpmn:sequenceFlow id="f_deliver_notify" name="已发货" sourceRef="gw_deliver" targetRef="task_notify_ship" />
    <bpmn:sequenceFlow id="f_redeliver_loop" name="派送失败" sourceRef="gw_deliver" targetRef="task_redeliver" />
    <bpmn:sequenceFlow id="f_redeliver_notify" sourceRef="task_redeliver" targetRef="task_notify_ship" />
    <bpmn:sequenceFlow id="f_notify_confirm" sourceRef="task_notify_ship" targetRef="task_confirm" />
    <bpmn:sequenceFlow id="f_confirm_end" sourceRef="task_confirm" targetRef="end_complete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_fuzz_cross_lane_dense_1" name="BPMNDiagram">
