<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_ticket_sla_escalation" targetNamespace="http://example.com/ticket-sla-escalation" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_ticket" name="工单SLA升级流程">
    <bpmn:participant id="pool_support" name="技术支持中心" processRef="process_ticket" />
  </bpmn:collaboration>
  <bpmn:process id="process_ticket" name="技术支持中心" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_level1" name="一线支持">
        <bpmn:flowNodeRef>start_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_l1_handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>boundary_l1_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_l1_solved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_level2" name="二线支持">
        <bpmn:flowNodeRef>task_l2_handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>boundary_l2_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_l2_solved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_level3" name="三线支持">
        <bpmn:flowNodeRef>task_l3_handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>boundary_l3_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_l3_solved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_manager" name="经理">
        <bpmn:flowNodeRef>task_mgr_handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_merge_solved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_close_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_ticket" name="工单创建">
      <bpmn:outgoing>f_start_l1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_l1_handle" name="一线处理">
      <bpmn:incoming>f_start_l1</bpmn:incoming>
      <bpmn:outgoing>f_l1_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="boundary_l1_sla" name="一线SLA超时" cancelActivity="false" attachedToRef="task_l1_handle">
      <bpmn:outgoing>f_l1_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="gw_l1_solved" name="一线是否解决" gatewayDirection="Diverging">
      <bpmn:incoming>f_l1_gw</bpmn:incoming>
      <bpmn:outgoing>f_l1_solved</bpmn:outgoing>
      <bpmn:outgoing>f_l1_unsolved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_l2_handle" name="二线处理">
      <bpmn:incoming>f_l1_unsolved</bpmn:incoming>
      <bpmn:incoming>f_l1_timeout</bpmn:incoming>
      <bpmn:outgoing>f_l2_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="boundary_l2_sla" name="二线SLA超时" cancelActivity="false" attachedToRef="task_l2_handle">
      <bpmn:outgoing>f_l2_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="gw_l2_solved" name="二线是否解决" gatewayDirection="Diverging">
      <bpmn:incoming>f_l2_gw</bpmn:incoming>
      <bpmn:outgoing>f_l2_solved</bpmn:outgoing>
      <bpmn:outgoing>f_l2_unsolved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_l3_handle" name="三线处理">
      <bpmn:incoming>f_l2_unsolved</bpmn:incoming>
      <bpmn:incoming>f_l2_timeout</bpmn:incoming>
      <bpmn:outgoing>f_l3_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="boundary_l3_sla" name="三线SLA超时" cancelActivity="false" attachedToRef="task_l3_handle">
      <bpmn:outgoing>f_l3_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT8H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="gw_l3_solved" name="三线是否解决" gatewayDirection="Diverging">
      <bpmn:incoming>f_l3_gw</bpmn:incoming>
      <bpmn:outgoing>f_l3_solved</bpmn:outgoing>
      <bpmn:outgoing>f_l3_unsolved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_mgr_handle" name="经理协调处理">
      <bpmn:incoming>f_l3_unsolved</bpmn:incoming>
      <bpmn:incoming>f_l3_timeout</bpmn:incoming>
      <bpmn:outgoing>f_mgr_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_merge_solved" name="汇总解决结果" gatewayDirection="Converging">
      <bpmn:incoming>f_l1_solved</bpmn:incoming>
      <bpmn:incoming>f_l2_solved</bpmn:incoming>
      <bpmn:incoming>f_l3_solved</bpmn:incoming>
      <bpmn:incoming>f_mgr_merge</bpmn:incoming>
      <bpmn:outgoing>f_merge_close</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_close_ticket" name="关单">
      <bpmn:incoming>f_merge_close</bpmn:incoming>
      <bpmn:outgoing>f_close_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_closed" name="工单关闭">
      <bpmn:incoming>f_close_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_l1" sourceRef="start_ticket" targetRef="task_l1_handle" />
    <bpmn:sequenceFlow id="f_l1_gw" sourceRef="task_l1_handle" targetRef="gw_l1_solved" />
    <bpmn:sequenceFlow id="f_l1_solved" name="已解决" sourceRef="gw_l1_solved" targetRef="gw_merge_solved" />
    <bpmn:sequenceFlow id="f_l1_unsolved" name="未解决" sourceRef="gw_l1_solved" targetRef="task_l2_handle" />
    <bpmn:sequenceFlow id="f_l1_timeout" name="超时升级二线" sourceRef="boundary_l1_sla" targetRef="task_l2_handle" />
    <bpmn:sequenceFlow id="f_l2_gw" sourceRef="task_l2_handle" targetRef="gw_l2_solved" />
    <bpmn:sequenceFlow id="f_l2_solved" name="已解决" sourceRef="gw_l2_solved" targetRef="gw_merge_solved" />
    <bpmn:sequenceFlow id="f_l2_unsolved" name="未解决" sourceRef="gw_l2_solved" targetRef="task_l3_handle" />
    <bpmn:sequenceFlow id="f_l2_timeout" name="超时升级三线" sourceRef="boundary_l2_sla" targetRef="task_l3_handle" />
    <bpmn:sequenceFlow id="f_l3_gw" sourceRef="task_l3_handle" targetRef="gw_l3_solved" />
    <bpmn:sequenceFlow id="f_l3_solved" name="已解决" sourceRef="gw_l3_solved" targetRef="gw_merge_solved" />
    <bpmn:sequenceFlow id="f_l3_unsolved" name="未解决" sourceRef="gw_l3_solved" targetRef="task_mgr_handle" />
    <bpmn:sequenceFlow id="f_l3_timeout" name="超时升级经理" sourceRef="boundary_l3_sla" targetRef="task_mgr_handle" />
    <bpmn:sequenceFlow id="f_mgr_merge" sourceRef="task_mgr_handle" targetRef="gw_merge_solved" />
    <bpmn:sequenceFlow id="f_merge_close" sourceRef="gw_merge_solved" targetRef="task_close_ticket" />
    <bpmn:sequenceFlow id="f_close_end" sourceRef="task_close_ticket" targetRef="end_closed" />
  </bpmn:process>
