<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_mixed_cjk_latin_labels" targetNamespace="http://example.com/test-mixed-cjk-latin-labels" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:message id="msg_webhook" name="Webhook 回调消息" />
  <bpmn:process id="process_mixed_labels" name="中英混排 label 测试" isExecutable="true">
    <bpmn:startEvent id="start_1" name="收到 POST /api/v2/orders 请求">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_webhook" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_validate" name="校验 JWT token 与 X-Request-Id 幂等键">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_sync_sku" name="调用 ERP-API 同步 SKU 库存数据">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_stock" name="库存 &#62;= qty 且 status == &#39;ACTIVE&#39; ?" gatewayDirection="Diverging">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_in_stock</bpmn:outgoing>
      <bpmn:outgoing>flow_oos</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="catch_webhook" name="等待 Webhook 回调 (timeout 30s)">
      <bpmn:incoming>flow_in_stock</bpmn:incoming>
      <bpmn:outgoing>flow_webhook_mq</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_webhook" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="task_mq" name="推送 OrderCreated 事件到 Kafka topic: order.v1">
      <bpmn:incoming>flow_webhook_mq</bpmn:incoming>
      <bpmn:outgoing>flow_mq_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_fallback" name="人工介入处理 OOS（缺货）工单 via Jira">
      <bpmn:incoming>flow_oos</bpmn:incoming>
      <bpmn:outgoing>flow_fallback_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_merge" name="merge 两条分支后统一 ACK" gatewayDirection="Converging">
      <bpmn:incoming>flow_mq_merge</bpmn:incoming>
      <bpmn:incoming>flow_fallback_merge</bpmn:incoming>
      <bpmn:outgoing>flow_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_1" name="返回 HTTP 201 Created 并写入 audit_log 表">
      <bpmn:incoming>flow_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" name="payload 反序列化成功" sourceRef="start_1" targetRef="task_validate" />
    <bpmn:sequenceFlow id="flow_2" name="token 有效且未命中 idempotency cache" sourceRef="task_validate" targetRef="task_sync_sku" />
    <bpmn:sequenceFlow id="flow_3" name="ERP-API 返回 200 OK" sourceRef="task_sync_sku" targetRef="gateway_stock" />
    <bpmn:sequenceFlow id="flow_in_stock" name="有货：走 async 支付确认链路" sourceRef="gateway_stock" targetRef="catch_webhook" />
    <bpmn:sequenceFlow id="flow_oos" name="缺货 / status != &#39;ACTIVE&#39; → fallback" sourceRef="gateway_stock" targetRef="task_fallback" />
    <bpmn:sequenceFlow id="flow_webhook_mq" name="回调签名验证通过（HMAC-SHA256）" sourceRef="catch_webhook" targetRef="task_mq" />
    <bpmn:sequenceFlow id="flow_mq_merge" name="Kafka ack: all ISR 已确认" sourceRef="task_mq" targetRef="gateway_merge" />
    <bpmn:sequenceFlow id="flow_fallback_merge" name="Jira 工单 resolved 后回流" sourceRef="task_fallback" targetRef="gateway_merge" />
    <bpmn:sequenceFlow id="flow_end" name="response 序列化 + trace span 关闭" sourceRef="gateway_merge" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_mixed_cjk_latin_labels" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_mixed_cjk_latin_labels" bpmnElement="process_mixed_labels">
      <bpmndi:BPMNShape id="process_mixed_labels_di" bpmnElement="process_mixed_labels">
        <dc:Bounds x="0" y="0" width="1170" height="284" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="62" y="124" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-20" y="164" width="200" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_validate_di" bpmnElement="task_validate">
        <dc:Bounds x="178" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_sync_sku_di" bpmnElement="task_sync_sku">
        <dc:Bounds x="358" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_stock_di" bpmnElement="gateway_stock">
        <dc:Bounds x="538" y="117" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="592" y="128" width="150" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="catch_webhook_di" bpmnElement="catch_webhook">
        <dc:Bounds x="668" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="586" y="94" width="200" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_mq_di" bpmnElement="task_mq">
        <dc:Bounds x="784" y="32" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_fallback_di" bpmnElement="task_fallback">
        <dc:Bounds x="794" y="172" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_merge_di" bpmnElement="gateway_merge">
        <dc:Bounds x="984" y="117" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="934" y="85" width="150" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="1114" y="124" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1032" y="164" width="200" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="98" y="142" />
        <di:waypoint x="178" y="142" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="71" y="87" width="134" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="278" y="142" />
        <di:waypoint x="358" y="142" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="238" y="45" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="458" y="142" />
        <di:waypoint x="538" y="142" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430.5" y="87" width="135" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_in_stock_di" bpmnElement="flow_in_stock">
        <di:waypoint x="563" y="117" />
        <di:waypoint x="563" y="72" />
        <di:waypoint x="668" y="72" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="398" y="69" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_oos_di" bpmnElement="flow_oos">
        <di:waypoint x="563" y="167" />
        <di:waypoint x="563" y="212" />
        <di:waypoint x="794" y="212" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="568" y="175" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_webhook_mq_di" bpmnElement="flow_webhook_mq">
        <di:waypoint x="704" y="72" />
        <di:waypoint x="784" y="72" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="-25" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mq_merge_di" bpmnElement="flow_mq_merge">
        <di:waypoint x="904" y="72" />
        <di:waypoint x="944" y="72" />
        <di:waypoint x="944" y="142" />
        <di:waypoint x="984" y="142" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="949" y="73" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fallback_merge_di" bpmnElement="flow_fallback_merge">
        <di:waypoint x="894" y="212" />
        <di:waypoint x="939" y="212" />
        <di:waypoint x="939" y="142" />
        <di:waypoint x="984" y="142" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="944" y="183" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_end_di" bpmnElement="flow_end">
        <di:waypoint x="1034" y="142" />
        <di:waypoint x="1114" y="142" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="976" y="179" width="160" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
