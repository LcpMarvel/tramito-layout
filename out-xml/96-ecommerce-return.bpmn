      <bpmndi:BPMNShape id="lane_service_di" bpmnElement="lane_service" isHorizontal="true">
        <dc:Bounds x="30" y="132" width="1544" height="251" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_cs_review_di" bpmnElement="task_cs_review">
        <dc:Bounds x="358" y="151" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundary_cs_timeout_di" bpmnElement="boundary_cs_timeout">
        <dc:Bounds x="360" y="213" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="351" y="253" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_cs_escalate_di" bpmnElement="task_cs_escalate">
        <dc:Bounds x="538" y="287" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_cs_review_di" bpmnElement="gw_cs_review">
        <dc:Bounds x="718" y="166" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="772" y="184" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_warehouse_di" bpmnElement="lane_warehouse" isHorizontal="true">
        <dc:Bounds x="30" y="383" width="1544" height="115" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receive_goods_di" bpmnElement="task_receive_goods">
        <dc:Bounds x="848" y="402" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_quality_check_di" bpmnElement="task_quality_check">
        <dc:Bounds x="1028" y="402" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_quality_di" bpmnElement="gw_quality">
        <dc:Bounds x="1208" y="417" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1262" y="435" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_finance_di" bpmnElement="lane_finance" isHorizontal="true">
        <dc:Bounds x="30" y="498" width="1544" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_refund_di" bpmnElement="task_refund">
        <dc:Bounds x="1338" y="514" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_return_done_di" bpmnElement="end_return_done">
        <dc:Bounds x="1518" y="536" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1508" y="576" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_submit_di" bpmnElement="f_start_submit">
        <di:waypoint x="98" y="76" />
        <di:waypoint x="178" y="76" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_submit_review_di" bpmnElement="f_submit_review">
        <di:waypoint x="228" y="116" />
        <di:waypoint x="228" y="191" />
        <di:waypoint x="358" y="191" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_review_gw_di" bpmnElement="f_review_gw">
        <di:waypoint x="458" y="191" />
        <di:waypoint x="718" y="191" />
      </bpmndi:BPMNEdge>
