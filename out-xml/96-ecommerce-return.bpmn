          <dc:Bounds x="456" y="248" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_escalate_gw_di" bpmnElement="f_escalate_gw">
        <di:waypoint x="588" y="287" />
        <di:waypoint x="588" y="251.5" />
        <di:waypoint x="743" y="251.5" />
        <di:waypoint x="743" y="216" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_receive_qc_di" bpmnElement="f_receive_qc">
        <di:waypoint x="948" y="442" />
        <di:waypoint x="1028" y="442" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_qc_gw_di" bpmnElement="f_qc_gw">
        <di:waypoint x="1128" y="442" />
        <di:waypoint x="1208" y="442" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_qc_fail_di" bpmnElement="f_qc_fail">
        <di:waypoint x="1233" y="417" />
