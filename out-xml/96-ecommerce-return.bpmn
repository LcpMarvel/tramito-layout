        <di:waypoint x="408" y="392" />
        <di:waypoint x="408" y="231" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1238" y="397.5" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_qc_pass_di" bpmnElement="f_qc_pass">
        <di:waypoint x="1233" y="467" />
