<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_ecommerce_return" targetNamespace="http://example.com/ecommerce-return" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_return" name="电商退货流程">
    <bpmn:participant id="pool_ecommerce" name="电商平台" processRef="process_return" />
  </bpmn:collaboration>
  <bpmn:process id="process_return" name="电商平台" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_customer" name="客户">
        <bpmn:flowNodeRef>start_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_submit_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_service" name="客服">
        <bpmn:flowNodeRef>task_cs_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>boundary_cs_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_cs_escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_cs_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_warehouse" name="仓库">
        <bpmn:flowNodeRef>task_receive_goods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_quality_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_quality</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_finance" name="财务">
        <bpmn:flowNodeRef>task_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_return_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_return" name="发起退货">
      <bpmn:outgoing>f_start_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit_return" name="提交退货申请">
      <bpmn:incoming>f_start_submit</bpmn:incoming>
      <bpmn:incoming>f_cs_reject</bpmn:incoming>
      <bpmn:outgoing>f_submit_review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_cs_review" name="客服审核申请">
      <bpmn:incoming>f_submit_review</bpmn:incoming>
      <bpmn:incoming>f_qc_fail</bpmn:incoming>
      <bpmn:outgoing>f_review_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="boundary_cs_timeout" name="审核超时" attachedToRef="task_cs_review">
      <bpmn:outgoing>f_timeout_escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="task_cs_escalate" name="升级专员处理">
      <bpmn:incoming>f_timeout_escalate</bpmn:incoming>
      <bpmn:outgoing>f_escalate_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_cs_review" name="审核结果" gatewayDirection="Diverging">
      <bpmn:incoming>f_review_gw</bpmn:incoming>
      <bpmn:incoming>f_escalate_gw</bpmn:incoming>
      <bpmn:outgoing>f_cs_reject</bpmn:outgoing>
      <bpmn:outgoing>f_cs_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_receive_goods" name="收货登记">
      <bpmn:incoming>f_cs_pass</bpmn:incoming>
      <bpmn:outgoing>f_receive_qc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_quality_check" name="退货质检">
      <bpmn:incoming>f_receive_qc</bpmn:incoming>
      <bpmn:outgoing>f_qc_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_quality" name="质检是否合格" gatewayDirection="Diverging">
      <bpmn:incoming>f_qc_gw</bpmn:incoming>
      <bpmn:outgoing>f_qc_fail</bpmn:outgoing>
      <bpmn:outgoing>f_qc_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_refund" name="执行退款">
      <bpmn:incoming>f_qc_pass</bpmn:incoming>
      <bpmn:outgoing>f_refund_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_return_done" name="退货完成">
      <bpmn:incoming>f_refund_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_submit" sourceRef="start_return" targetRef="task_submit_return" />
    <bpmn:sequenceFlow id="f_submit_review" sourceRef="task_submit_return" targetRef="task_cs_review" />
    <bpmn:sequenceFlow id="f_review_gw" sourceRef="task_cs_review" targetRef="gw_cs_review" />
    <bpmn:sequenceFlow id="f_cs_reject" name="驳回" sourceRef="gw_cs_review" targetRef="task_submit_return" />
    <bpmn:sequenceFlow id="f_cs_pass" name="通过" sourceRef="gw_cs_review" targetRef="task_receive_goods" />
    <bpmn:sequenceFlow id="f_timeout_escalate" name="超时升级" sourceRef="boundary_cs_timeout" targetRef="task_cs_escalate" />
    <bpmn:sequenceFlow id="f_escalate_gw" sourceRef="task_cs_escalate" targetRef="gw_cs_review" />
    <bpmn:sequenceFlow id="f_receive_qc" sourceRef="task_receive_goods" targetRef="task_quality_check" />
    <bpmn:sequenceFlow id="f_qc_gw" sourceRef="task_quality_check" targetRef="gw_quality" />
    <bpmn:sequenceFlow id="f_qc_fail" name="不合格" sourceRef="gw_quality" targetRef="task_cs_review" />
    <bpmn:sequenceFlow id="f_qc_pass" name="合格" sourceRef="gw_quality" targetRef="task_refund" />
    <bpmn:sequenceFlow id="f_refund_end" sourceRef="task_refund" targetRef="end_return_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_ecommerce_return" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_ecommerce_return" bpmnElement="collaboration_return">
      <bpmndi:BPMNShape id="collaboration_return_di" bpmnElement="collaboration_return">
        <dc:Bounds x="0" y="0" width="1574" height="630" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_ecommerce_di" bpmnElement="pool_ecommerce" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1574" height="630" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_customer_di" bpmnElement="lane_customer" isHorizontal="true">
        <dc:Bounds x="30" y="20" width="1544" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_return_di" bpmnElement="start_return">
