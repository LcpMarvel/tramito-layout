<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_loop_around_subprocess" targetNamespace="http://example.com/test-loop-around-subprocess" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_loop_around_sub" name="证照办理绕子流程回环" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_prepare_docs" name="整理申报材料">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:incoming>flow_gw_back</bpmn:incoming>
      <bpmn:outgoing>flow_prepare_sub</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="subprocess_audit" name="材料联合审查">
      <bpmn:incoming>flow_prepare_sub</bpmn:incoming>
      <bpmn:outgoing>flow_sub_gw</bpmn:outgoing>
      <bpmn:startEvent id="sub_start" name="开始审查">
        <bpmn:outgoing>sub_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="sub_task_review" name="窗口初审">
        <bpmn:incoming>sub_flow_1</bpmn:incoming>
        <bpmn:outgoing>sub_flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="sub_end" name="审查完毕">
        <bpmn:incoming>sub_flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="sub_flow_1" sourceRef="sub_start" targetRef="sub_task_review" />
      <bpmn:sequenceFlow id="sub_flow_2" sourceRef="sub_task_review" targetRef="sub_end" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="gw_audit_result" name="审查通过">
      <bpmn:incoming>flow_sub_gw</bpmn:incoming>
      <bpmn:outgoing>flow_gw_back</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_issue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_issue" name="发放证照">
      <bpmn:incoming>flow_gw_issue</bpmn:incoming>
      <bpmn:outgoing>flow_issue_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="办结">
      <bpmn:incoming>flow_issue_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_prepare_docs" />
    <bpmn:sequenceFlow id="flow_prepare_sub" sourceRef="task_prepare_docs" targetRef="subprocess_audit" />
    <bpmn:sequenceFlow id="flow_sub_gw" sourceRef="subprocess_audit" targetRef="gw_audit_result" />
    <bpmn:sequenceFlow id="flow_gw_back" name="补正材料" sourceRef="gw_audit_result" targetRef="task_prepare_docs" />
    <bpmn:sequenceFlow id="flow_gw_issue" name="通过" sourceRef="gw_audit_result" targetRef="task_issue" />
    <bpmn:sequenceFlow id="flow_issue_end" sourceRef="task_issue" targetRef="end_1" />
  </bpmn:process>
