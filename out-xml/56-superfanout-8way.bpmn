<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_superfanout_8way" targetNamespace="http://example.com/test-superfanout-8way" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_superfanout" name="报销金额八路分级审批" isExecutable="true">
    <bpmn:startEvent id="start_1" name="提交报销">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_prepare" name="填写报销单">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_amount_div" name="金额分级" gatewayDirection="Diverging" default="flow_tier_8">
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_tier_1</bpmn:outgoing>
      <bpmn:outgoing>flow_tier_2</bpmn:outgoing>
      <bpmn:outgoing>flow_tier_3</bpmn:outgoing>
      <bpmn:outgoing>flow_tier_4</bpmn:outgoing>
      <bpmn:outgoing>flow_tier_5</bpmn:outgoing>
      <bpmn:outgoing>flow_tier_6</bpmn:outgoing>
      <bpmn:outgoing>flow_tier_7</bpmn:outgoing>
      <bpmn:outgoing>flow_tier_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_tier1" name="自动报销">
      <bpmn:incoming>flow_tier_1</bpmn:incoming>
      <bpmn:outgoing>flow_conv_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_tier2" name="组长审批">
      <bpmn:incoming>flow_tier_2</bpmn:incoming>
      <bpmn:outgoing>flow_conv_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier3" name="经理审批">
      <bpmn:incoming>flow_tier_3</bpmn:incoming>
      <bpmn:outgoing>flow_conv_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier4_a" name="经理初审">
      <bpmn:incoming>flow_tier_4</bpmn:incoming>
      <bpmn:outgoing>flow_tier4_chain</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier4_b" name="总监复审">
      <bpmn:incoming>flow_tier4_chain</bpmn:incoming>
      <bpmn:outgoing>flow_conv_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier5" name="总监审批">
      <bpmn:incoming>flow_tier_5</bpmn:incoming>
      <bpmn:outgoing>flow_conv_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier6_a" name="总监初审">
      <bpmn:incoming>flow_tier_6</bpmn:incoming>
      <bpmn:outgoing>flow_tier6_chain</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier6_b" name="副总裁复审">
      <bpmn:incoming>flow_tier6_chain</bpmn:incoming>
      <bpmn:outgoing>flow_conv_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier7" name="总裁审批">
      <bpmn:incoming>flow_tier_7</bpmn:incoming>
      <bpmn:outgoing>flow_conv_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier8_a" name="董事会预审">
      <bpmn:incoming>flow_tier_8</bpmn:incoming>
      <bpmn:outgoing>flow_tier8_chain</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_tier8_b" name="董事会决议">
      <bpmn:incoming>flow_tier8_chain</bpmn:incoming>
      <bpmn:outgoing>flow_conv_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_amount_conv" name="审批汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_conv_1</bpmn:incoming>
      <bpmn:incoming>flow_conv_2</bpmn:incoming>
      <bpmn:incoming>flow_conv_3</bpmn:incoming>
      <bpmn:incoming>flow_conv_4</bpmn:incoming>
      <bpmn:incoming>flow_conv_5</bpmn:incoming>
      <bpmn:incoming>flow_conv_6</bpmn:incoming>
      <bpmn:incoming>flow_conv_7</bpmn:incoming>
      <bpmn:incoming>flow_conv_8</bpmn:incoming>
      <bpmn:outgoing>flow_to_payout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_payout" name="财务打款">
      <bpmn:incoming>flow_to_payout</bpmn:incoming>
      <bpmn:outgoing>flow_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="报销完成">
      <bpmn:incoming>flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_prepare" />
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="task_prepare" targetRef="gw_amount_div" />
    <bpmn:sequenceFlow id="flow_tier_1" name="金额&#60;1千" sourceRef="gw_amount_div" targetRef="task_tier1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &lt; 1000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_tier_2" name="1千-5千" sourceRef="gw_amount_div" targetRef="task_tier2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt;= 1000 &amp;&amp; amount &lt; 5000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_tier_3" name="5千-1万" sourceRef="gw_amount_div" targetRef="task_tier3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt;= 5000 &amp;&amp; amount &lt; 10000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_tier_4" name="1万-5万" sourceRef="gw_amount_div" targetRef="task_tier4_a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt;= 10000 &amp;&amp; amount &lt; 50000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_tier_5" name="5万-10万" sourceRef="gw_amount_div" targetRef="task_tier5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt;= 50000 &amp;&amp; amount &lt; 100000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_tier_6" name="10万-50万" sourceRef="gw_amount_div" targetRef="task_tier6_a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt;= 100000 &amp;&amp; amount &lt; 500000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_tier_7" name="50万-100万" sourceRef="gw_amount_div" targetRef="task_tier7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt;= 500000 &amp;&amp; amount &lt; 1000000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_tier_8" name="100万以上" sourceRef="gw_amount_div" targetRef="task_tier8_a" />
    <bpmn:sequenceFlow id="flow_tier4_chain" sourceRef="task_tier4_a" targetRef="task_tier4_b" />
    <bpmn:sequenceFlow id="flow_tier6_chain" sourceRef="task_tier6_a" targetRef="task_tier6_b" />
    <bpmn:sequenceFlow id="flow_tier8_chain" sourceRef="task_tier8_a" targetRef="task_tier8_b" />
    <bpmn:sequenceFlow id="flow_conv_1" sourceRef="task_tier1" targetRef="gw_amount_conv" />
    <bpmn:sequenceFlow id="flow_conv_2" sourceRef="task_tier2" targetRef="gw_amount_conv" />
    <bpmn:sequenceFlow id="flow_conv_3" sourceRef="task_tier3" targetRef="gw_amount_conv" />
    <bpmn:sequenceFlow id="flow_conv_4" sourceRef="task_tier4_b" targetRef="gw_amount_conv" />
    <bpmn:sequenceFlow id="flow_conv_5" sourceRef="task_tier5" targetRef="gw_amount_conv" />
    <bpmn:sequenceFlow id="flow_conv_6" sourceRef="task_tier6_b" targetRef="gw_amount_conv" />
    <bpmn:sequenceFlow id="flow_conv_7" sourceRef="task_tier7" targetRef="gw_amount_conv" />
    <bpmn:sequenceFlow id="flow_conv_8" sourceRef="task_tier8_b" targetRef="gw_amount_conv" />
    <bpmn:sequenceFlow id="flow_to_payout" sourceRef="gw_amount_conv" targetRef="task_payout" />
    <bpmn:sequenceFlow id="flow_to_end" sourceRef="task_payout" targetRef="end_1" />
  </bpmn:process>
