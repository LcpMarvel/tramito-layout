<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_embedded_subprocess" targetNamespace="http://example.com/test-embedded-subprocess" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_embedded" name="嵌入式子流程测试" isExecutable="true">
    <bpmn:startEvent id="start_main" name="开始">
      <bpmn:outgoing>main_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="subprocess_embedded" name="嵌入式子流程">
      <bpmn:incoming>main_flow_1</bpmn:incoming>
      <bpmn:outgoing>main_flow_2</bpmn:outgoing>
      <bpmn:startEvent id="sub_start" name="子开始">
        <bpmn:outgoing>sub_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="sub_task_1" name="子任务1">
        <bpmn:incoming>sub_flow_1</bpmn:incoming>
        <bpmn:outgoing>sub_flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="sub_task_2" name="子任务2">
        <bpmn:incoming>sub_flow_2</bpmn:incoming>
        <bpmn:outgoing>sub_flow_3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="sub_end" name="子结束">
        <bpmn:incoming>sub_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="sub_flow_1" sourceRef="sub_start" targetRef="sub_task_1" />
      <bpmn:sequenceFlow id="sub_flow_2" sourceRef="sub_task_1" targetRef="sub_task_2" />
      <bpmn:sequenceFlow id="sub_flow_3" sourceRef="sub_task_2" targetRef="sub_end" />
    </bpmn:subProcess>
    <bpmn:task id="task_after" name="后续任务">
      <bpmn:incoming>main_flow_2</bpmn:incoming>
      <bpmn:outgoing>main_flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_main" name="结束">
      <bpmn:incoming>main_flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="main_flow_1" sourceRef="start_main" targetRef="subprocess_embedded" />
    <bpmn:sequenceFlow id="main_flow_2" sourceRef="subprocess_embedded" targetRef="task_after" />
    <bpmn:sequenceFlow id="main_flow_3" sourceRef="task_after" targetRef="end_main" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_embedded_subprocess" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_embedded_subprocess" bpmnElement="process_embedded">
