      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_after_di" bpmnElement="task_after">
        <dc:Bounds x="894" y="74" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_main_di" bpmnElement="end_main">
        <dc:Bounds x="1074" y="96" width="36" height="36" />
