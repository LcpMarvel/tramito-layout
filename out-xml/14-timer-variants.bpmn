<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_timer_variants" targetNamespace="http://example.com/test-timer-variants" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_timer_variants" name="定时器变体测试" isExecutable="true">
    <bpmn:startEvent id="start_timer_date" name="指定日期启动">
      <bpmn:outgoing>flow_date_start</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2025-01-15T09:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="start_timer_cycle" name="周期启动">
      <bpmn:outgoing>flow_cycle_start</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R5/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="start_timer_duration" name="延迟启动">
      <bpmn:outgoing>flow_duration_start</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gateway_merge_starts" name="合并启动" gatewayDirection="Converging">
      <bpmn:incoming>flow_date_start</bpmn:incoming>
      <bpmn:incoming>flow_cycle_start</bpmn:incoming>
      <bpmn:incoming>flow_duration_start</bpmn:incoming>
      <bpmn:incoming>flow_cron_start</bpmn:incoming>
      <bpmn:outgoing>flow_to_init</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_init" name="初始化任务">
      <bpmn:incoming>flow_to_init</bpmn:incoming>
      <bpmn:outgoing>flow_init_to_date</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="catch_timer_date" name="等待到指定时间">
      <bpmn:incoming>flow_init_to_date</bpmn:incoming>
      <bpmn:outgoing>flow_date_to_task</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2025-06-01T12:00:00+08:00</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_after_date" name="日期后任务">
      <bpmn:incoming>flow_date_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_date_task_to_duration</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="catch_timer_duration" name="等待一段时间">
      <bpmn:incoming>flow_date_task_to_duration</bpmn:incoming>
      <bpmn:outgoing>flow_duration_to_task</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1DT2H30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_after_duration" name="延时后任务">
      <bpmn:incoming>flow_duration_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_duration_task_to_cycle</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="catch_timer_cycle" name="周期等待">
      <bpmn:incoming>flow_duration_task_to_cycle</bpmn:incoming>
      <bpmn:outgoing>flow_cycle_to_task</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R3/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_after_cycle" name="周期任务">
      <bpmn:incoming>flow_cycle_to_task</bpmn:incoming>
      <bpmn:outgoing>flow_cycle_task_to_main</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_main_with_boundary" name="主任务">
      <bpmn:incoming>flow_cycle_task_to_main</bpmn:incoming>
      <bpmn:outgoing>flow_main_to_iso</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="boundary_timer_date" name="截止日期" attachedToRef="task_main_with_boundary">
      <bpmn:outgoing>flow_deadline_boundary</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2025-12-31T23:59:59Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_timer_duration" name="超时" attachedToRef="task_main_with_boundary">
      <bpmn:outgoing>flow_timeout_boundary</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_timer_cycle_non_int" name="周期提醒" cancelActivity="false" attachedToRef="task_main_with_boundary">
      <bpmn:outgoing>flow_reminder_boundary</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="task_deadline_handler" name="截止处理">
      <bpmn:incoming>flow_deadline_boundary</bpmn:incoming>
      <bpmn:outgoing>flow_deadline_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_timeout_handler" name="超时处理">
      <bpmn:incoming>flow_timeout_boundary</bpmn:incoming>
      <bpmn:outgoing>flow_timeout_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="task_reminder" name="发送提醒">
      <bpmn:incoming>flow_reminder_boundary</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="gateway_final" name="最终合并" gatewayDirection="Converging">
      <bpmn:incoming>flow_monthly_to_final</bpmn:incoming>
      <bpmn:outgoing>flow_final_to_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_normal" name="正常结束">
      <bpmn:incoming>flow_final_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_deadline" name="截止结束">
      <bpmn:incoming>flow_deadline_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_timeout" name="超时结束">
      <bpmn:incoming>flow_timeout_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_timer_cron" name="Cron表达式启动">
      <bpmn:outgoing>flow_cron_start</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 9 * * MON-FRI</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="catch_timer_iso_interval" name="ISO间隔">
      <bpmn:incoming>flow_main_to_iso</bpmn:incoming>
      <bpmn:outgoing>flow_iso_to_monthly</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R10/2025-01-01T00:00:00Z/P1M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_monthly" name="月度任务">
      <bpmn:incoming>flow_iso_to_monthly</bpmn:incoming>
      <bpmn:outgoing>flow_monthly_to_final</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_date_start" sourceRef="start_timer_date" targetRef="gateway_merge_starts" />
    <bpmn:sequenceFlow id="flow_cycle_start" sourceRef="start_timer_cycle" targetRef="gateway_merge_starts" />
    <bpmn:sequenceFlow id="flow_duration_start" sourceRef="start_timer_duration" targetRef="gateway_merge_starts" />
    <bpmn:sequenceFlow id="flow_cron_start" sourceRef="start_timer_cron" targetRef="gateway_merge_starts" />
    <bpmn:sequenceFlow id="flow_to_init" sourceRef="gateway_merge_starts" targetRef="task_init" />
    <bpmn:sequenceFlow id="flow_init_to_date" sourceRef="task_init" targetRef="catch_timer_date" />
    <bpmn:sequenceFlow id="flow_date_to_task" sourceRef="catch_timer_date" targetRef="task_after_date" />
    <bpmn:sequenceFlow id="flow_date_task_to_duration" sourceRef="task_after_date" targetRef="catch_timer_duration" />
    <bpmn:sequenceFlow id="flow_duration_to_task" sourceRef="catch_timer_duration" targetRef="task_after_duration" />
    <bpmn:sequenceFlow id="flow_duration_task_to_cycle" sourceRef="task_after_duration" targetRef="catch_timer_cycle" />
    <bpmn:sequenceFlow id="flow_cycle_to_task" sourceRef="catch_timer_cycle" targetRef="task_after_cycle" />
    <bpmn:sequenceFlow id="flow_cycle_task_to_main" sourceRef="task_after_cycle" targetRef="task_main_with_boundary" />
    <bpmn:sequenceFlow id="flow_main_to_iso" sourceRef="task_main_with_boundary" targetRef="catch_timer_iso_interval" />
    <bpmn:sequenceFlow id="flow_iso_to_monthly" sourceRef="catch_timer_iso_interval" targetRef="task_monthly" />
    <bpmn:sequenceFlow id="flow_monthly_to_final" sourceRef="task_monthly" targetRef="gateway_final" />
    <bpmn:sequenceFlow id="flow_final_to_end" sourceRef="gateway_final" targetRef="end_normal" />
    <bpmn:sequenceFlow id="flow_deadline_boundary" sourceRef="boundary_timer_date" targetRef="task_deadline_handler" />
    <bpmn:sequenceFlow id="flow_deadline_to_end" sourceRef="task_deadline_handler" targetRef="end_deadline" />
    <bpmn:sequenceFlow id="flow_timeout_boundary" sourceRef="boundary_timer_duration" targetRef="task_timeout_handler" />
    <bpmn:sequenceFlow id="flow_timeout_to_end" sourceRef="task_timeout_handler" targetRef="end_timeout" />
    <bpmn:sequenceFlow id="flow_reminder_boundary" sourceRef="boundary_timer_cycle_non_int" targetRef="task_reminder" />
  </bpmn:process>
