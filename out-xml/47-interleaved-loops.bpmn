<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_interleaved_loops" targetNamespace="http://example.com/test-interleaved-loops" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_interleaved" name="数据流水线交错返工" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_collect" name="数据采集">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:incoming>flow_sample_back</bpmn:incoming>
      <bpmn:outgoing>flow_collect_clean</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_clean" name="数据清洗">
      <bpmn:incoming>flow_collect_clean</bpmn:incoming>
      <bpmn:incoming>flow_model_back</bpmn:incoming>
      <bpmn:outgoing>flow_clean_check</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_sample_check" name="质量抽检">
      <bpmn:incoming>flow_clean_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_sample" name="抽检合格">
      <bpmn:incoming>flow_check_gw</bpmn:incoming>
      <bpmn:outgoing>flow_sample_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_sample_back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_model" name="建模分析">
      <bpmn:incoming>flow_sample_pass</bpmn:incoming>
      <bpmn:outgoing>flow_model_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_model" name="模型达标">
      <bpmn:incoming>flow_model_gw</bpmn:incoming>
      <bpmn:outgoing>flow_model_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_model_back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>flow_model_pass</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_collect" />
    <bpmn:sequenceFlow id="flow_collect_clean" sourceRef="task_collect" targetRef="task_clean" />
    <bpmn:sequenceFlow id="flow_clean_check" sourceRef="task_clean" targetRef="task_sample_check" />
    <bpmn:sequenceFlow id="flow_check_gw" sourceRef="task_sample_check" targetRef="gw_sample" />
    <bpmn:sequenceFlow id="flow_sample_pass" name="合格" sourceRef="gw_sample" targetRef="task_model" />
    <bpmn:sequenceFlow id="flow_sample_back" name="重新采集" sourceRef="gw_sample" targetRef="task_collect" />
    <bpmn:sequenceFlow id="flow_model_gw" sourceRef="task_model" targetRef="gw_model" />
    <bpmn:sequenceFlow id="flow_model_pass" name="达标" sourceRef="gw_model" targetRef="end_1" />
    <bpmn:sequenceFlow id="flow_model_back" name="重新清洗" sourceRef="gw_model" targetRef="task_clean" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_interleaved_loops" name="BPMNDiagram">
