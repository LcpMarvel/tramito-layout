<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_diamond_nested_3" targetNamespace="http://example.com/test-diamond-nested-3" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_diamond_nested" name="三层嵌套菱形贷款审批" isExecutable="true">
    <bpmn:startEvent id="start_1" name="贷款申请">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_l1_div" name="客户类型" gatewayDirection="Diverging" default="flow_l1_personal">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_l1_personal</bpmn:outgoing>
      <bpmn:outgoing>flow_l1_corp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_personal" name="个人资质审核">
      <bpmn:incoming>flow_l1_personal</bpmn:incoming>
      <bpmn:outgoing>flow_personal_to_l1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_l2_div" name="企业规模" gatewayDirection="Diverging" default="flow_l2_small">
      <bpmn:incoming>flow_l1_corp</bpmn:incoming>
      <bpmn:outgoing>flow_l2_small</bpmn:outgoing>
      <bpmn:outgoing>flow_l2_large</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_small_biz" name="小微企业评估">
      <bpmn:incoming>flow_l2_small</bpmn:incoming>
      <bpmn:outgoing>flow_small_to_l2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_l3_div" name="授信额度" gatewayDirection="Diverging" default="flow_l3_normal">
      <bpmn:incoming>flow_l2_large</bpmn:incoming>
      <bpmn:outgoing>flow_l3_high</bpmn:outgoing>
      <bpmn:outgoing>flow_l3_normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_high_credit" name="风控部尽调">
      <bpmn:incoming>flow_l3_high</bpmn:incoming>
      <bpmn:outgoing>flow_l3_high_conv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_normal_credit" name="系统自动评级">
      <bpmn:incoming>flow_l3_normal</bpmn:incoming>
      <bpmn:outgoing>flow_l3_normal_conv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_l3_conv" name="额度汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_l3_high_conv</bpmn:incoming>
      <bpmn:incoming>flow_l3_normal_conv</bpmn:incoming>
      <bpmn:outgoing>flow_l3_to_l2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_l2_conv" name="规模汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_l3_to_l2</bpmn:incoming>
      <bpmn:incoming>flow_small_to_l2</bpmn:incoming>
      <bpmn:outgoing>flow_l2_to_l1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_l1_conv" name="类型汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_l2_to_l1</bpmn:incoming>
      <bpmn:incoming>flow_personal_to_l1</bpmn:incoming>
      <bpmn:outgoing>flow_to_sign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_sign" name="签署合同">
      <bpmn:incoming>flow_to_sign</bpmn:incoming>
      <bpmn:outgoing>flow_to_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_1" name="放款完成">
      <bpmn:incoming>flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="gw_l1_div" />
    <bpmn:sequenceFlow id="flow_l1_personal" name="个人客户" sourceRef="gw_l1_div" targetRef="task_personal" />
    <bpmn:sequenceFlow id="flow_l1_corp" name="企业客户" sourceRef="gw_l1_div" targetRef="gw_l2_div">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerType == 'corp'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_l2_small" name="小微企业" sourceRef="gw_l2_div" targetRef="task_small_biz" />
    <bpmn:sequenceFlow id="flow_l2_large" name="规模以上" sourceRef="gw_l2_div" targetRef="gw_l3_div">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${scale == 'large'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_l3_high" name="超500万" sourceRef="gw_l3_div" targetRef="task_high_credit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${credit &gt; 5000000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_l3_normal" name="500万以内" sourceRef="gw_l3_div" targetRef="task_normal_credit" />
    <bpmn:sequenceFlow id="flow_l3_high_conv" sourceRef="task_high_credit" targetRef="gw_l3_conv" />
    <bpmn:sequenceFlow id="flow_l3_normal_conv" sourceRef="task_normal_credit" targetRef="gw_l3_conv" />
    <bpmn:sequenceFlow id="flow_l3_to_l2" sourceRef="gw_l3_conv" targetRef="gw_l2_conv" />
    <bpmn:sequenceFlow id="flow_small_to_l2" sourceRef="task_small_biz" targetRef="gw_l2_conv" />
    <bpmn:sequenceFlow id="flow_l2_to_l1" sourceRef="gw_l2_conv" targetRef="gw_l1_conv" />
    <bpmn:sequenceFlow id="flow_personal_to_l1" sourceRef="task_personal" targetRef="gw_l1_conv" />
    <bpmn:sequenceFlow id="flow_to_sign" sourceRef="gw_l1_conv" targetRef="task_sign" />
    <bpmn:sequenceFlow id="flow_to_end" sourceRef="task_sign" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_diamond_nested_3" name="BPMNDiagram">
