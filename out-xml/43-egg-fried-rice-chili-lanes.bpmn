<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-elk-layout" exporterVersion="1.0.0">
  <bpmn:collaboration id="collaboration_2" name="蛋炒饭流程">
    <bpmn:participant id="pool_3" name="厨房" processRef="process_4" />
  </bpmn:collaboration>
  <bpmn:process id="process_4" name="厨房" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_5" name="帮厨">
        <bpmn:flowNodeRef>start_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_6" name="主厨">
        <bpmn:flowNodeRef>task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_3" name="开始">
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_4" name="打鸡蛋">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_13" name="备米饭">
      <bpmn:incoming>flow_21</bpmn:incoming>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_14" name="切葱花">
      <bpmn:incoming>flow_22</bpmn:incoming>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_15" name="备调料">
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_9" name="出锅装盘">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_10" name="结束">
      <bpmn:incoming>flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_5" name="热锅倒油">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_6" name="炒鸡蛋">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_7" name="炒米饭">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_11" name="加辣椒？" default="flow_18">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_12" name="加入辣椒">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_8" name="混合调味">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_11" sourceRef="start_3" targetRef="task_4" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="task_4" targetRef="task_13" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="task_13" targetRef="task_14" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="task_14" targetRef="task_15" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="task_15" targetRef="task_5" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="task_5" targetRef="task_6" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="task_6" targetRef="task_7" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="task_7" targetRef="gateway_11" />
    <bpmn:sequenceFlow id="flow_16" name="加辣" sourceRef="gateway_11" targetRef="task_12">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${addChili}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_17" sourceRef="task_12" targetRef="task_8" />
    <bpmn:sequenceFlow id="flow_18" name="不加辣" sourceRef="gateway_11" targetRef="task_8" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="task_8" targetRef="task_9" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="task_9" targetRef="end_10" />
  </bpmn:process>
