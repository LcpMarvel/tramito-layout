<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_manufacturing_rework" targetNamespace="http://example.com/manufacturing-rework-nested" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_manufacturing" name="制造返工流程" isExecutable="true">
    <bpmn:startEvent id="start_order" name="生产工单下达">
      <bpmn:outgoing>f_start_prepare</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_prepare_material" name="备料">
      <bpmn:incoming>f_start_prepare</bpmn:incoming>
      <bpmn:incoming>f_quality_rework</bpmn:incoming>
      <bpmn:outgoing>f_prepare_assembly</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="subprocess_assembly" name="装配工序">
      <bpmn:incoming>f_prepare_assembly</bpmn:incoming>
      <bpmn:outgoing>f_assembly_inspect</bpmn:outgoing>
      <bpmn:startEvent id="sub_start_assembly" name="开始装配">
        <bpmn:outgoing>sub_f_start_parts</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="sub_task_parts" name="部件装配">
        <bpmn:incoming>sub_f_start_parts</bpmn:incoming>
        <bpmn:incoming>sub_f_check_rework</bpmn:incoming>
        <bpmn:outgoing>sub_f_parts_whole</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="sub_task_whole" name="整机组装">
        <bpmn:incoming>sub_f_parts_whole</bpmn:incoming>
        <bpmn:outgoing>sub_f_whole_check</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="sub_gw_selfcheck" name="自检是否合格" gatewayDirection="Diverging">
        <bpmn:incoming>sub_f_whole_check</bpmn:incoming>
        <bpmn:outgoing>sub_f_check_rework</bpmn:outgoing>
        <bpmn:outgoing>sub_f_check_done</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="sub_end_assembly" name="装配完成">
        <bpmn:incoming>sub_f_check_done</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="sub_f_start_parts" sourceRef="sub_start_assembly" targetRef="sub_task_parts" />
      <bpmn:sequenceFlow id="sub_f_parts_whole" sourceRef="sub_task_parts" targetRef="sub_task_whole" />
      <bpmn:sequenceFlow id="sub_f_whole_check" sourceRef="sub_task_whole" targetRef="sub_gw_selfcheck" />
      <bpmn:sequenceFlow id="sub_f_check_rework" name="不合格返工" sourceRef="sub_gw_selfcheck" targetRef="sub_task_parts" />
      <bpmn:sequenceFlow id="sub_f_check_done" name="合格" sourceRef="sub_gw_selfcheck" targetRef="sub_end_assembly" />
    </bpmn:subProcess>
    <bpmn:userTask id="task_quality_inspect" name="成品质检">
      <bpmn:incoming>f_assembly_inspect</bpmn:incoming>
      <bpmn:outgoing>f_inspect_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_quality_result" name="质检是否合格" gatewayDirection="Diverging">
      <bpmn:incoming>f_inspect_gw</bpmn:incoming>
      <bpmn:outgoing>f_quality_rework</bpmn:outgoing>
      <bpmn:outgoing>f_quality_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_package_store" name="包装入库">
      <bpmn:incoming>f_quality_pass</bpmn:incoming>
      <bpmn:outgoing>f_package_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_produced" name="生产完成">
      <bpmn:incoming>f_package_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_prepare" sourceRef="start_order" targetRef="task_prepare_material" />
    <bpmn:sequenceFlow id="f_prepare_assembly" sourceRef="task_prepare_material" targetRef="subprocess_assembly" />
    <bpmn:sequenceFlow id="f_assembly_inspect" sourceRef="subprocess_assembly" targetRef="task_quality_inspect" />
    <bpmn:sequenceFlow id="f_inspect_gw" sourceRef="task_quality_inspect" targetRef="gw_quality_result" />
    <bpmn:sequenceFlow id="f_quality_rework" name="不合格重新备料" sourceRef="gw_quality_result" targetRef="task_prepare_material" />
    <bpmn:sequenceFlow id="f_quality_pass" name="合格" sourceRef="gw_quality_result" targetRef="task_package_store" />
    <bpmn:sequenceFlow id="f_package_end" sourceRef="task_package_store" targetRef="end_produced" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_manufacturing_rework" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_manufacturing_rework" bpmnElement="process_manufacturing">
      <bpmndi:BPMNShape id="process_manufacturing_di" bpmnElement="process_manufacturing">
        <dc:Bounds x="0" y="0" width="1344" height="412" />
