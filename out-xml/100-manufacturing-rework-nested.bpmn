      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prepare_material_di" bpmnElement="task_prepare_material">
        <dc:Bounds x="178" y="86.5" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subprocess_assembly_di" bpmnElement="subprocess_assembly" isExpanded="true">
        <dc:Bounds x="358" y="32" width="786" height="189" />
