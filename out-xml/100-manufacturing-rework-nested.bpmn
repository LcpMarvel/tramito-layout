      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_task_whole_di" bpmnElement="sub_task_whole">
        <dc:Bounds x="726" y="84" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_gw_selfcheck_di" bpmnElement="sub_gw_selfcheck">
        <dc:Bounds x="926" y="124" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="909" y="178" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_end_assembly_di" bpmnElement="sub_end_assembly">
        <dc:Bounds x="1076" y="131" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1066" y="171" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_quality_inspect_di" bpmnElement="task_quality_inspect">
        <dc:Bounds x="1224" y="86.5" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_quality_result_di" bpmnElement="gw_quality_result">
        <dc:Bounds x="62" y="327" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="45" y="381" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_package_store_di" bpmnElement="task_package_store">
        <dc:Bounds x="192" y="312" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_produced_di" bpmnElement="end_produced">
        <dc:Bounds x="372" y="334" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="362" y="374" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sub_f_start_parts_di" bpmnElement="sub_f_start_parts">
        <di:waypoint x="426" y="149" />
        <di:waypoint x="526" y="149" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sub_f_parts_whole_di" bpmnElement="sub_f_parts_whole">
        <di:waypoint x="626" y="149" />
        <di:waypoint x="676" y="149" />
