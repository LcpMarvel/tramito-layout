<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_triple_nested_loops" targetNamespace="http://example.com/test-triple-nested-loops" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_triple_nested" name="研发三重返工环" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_requirement" name="需求分析">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:incoming>flow_acceptance_back</bpmn:incoming>
      <bpmn:outgoing>flow_req_design</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_design" name="方案设计">
      <bpmn:incoming>flow_req_design</bpmn:incoming>
      <bpmn:incoming>flow_review_back</bpmn:incoming>
      <bpmn:outgoing>flow_design_coding</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_coding" name="编码实现">
      <bpmn:incoming>flow_design_coding</bpmn:incoming>
      <bpmn:incoming>flow_selftest_back</bpmn:incoming>
      <bpmn:outgoing>flow_coding_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_selftest" name="自测通过">
      <bpmn:incoming>flow_coding_gw</bpmn:incoming>
      <bpmn:outgoing>flow_selftest_back</bpmn:outgoing>
      <bpmn:outgoing>flow_selftest_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_codereview" name="代码评审">
      <bpmn:incoming>flow_selftest_pass</bpmn:incoming>
      <bpmn:outgoing>flow_review_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_review" name="评审通过">
      <bpmn:incoming>flow_review_gw</bpmn:incoming>
      <bpmn:outgoing>flow_review_back</bpmn:outgoing>
      <bpmn:outgoing>flow_review_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_acceptance" name="验收测试">
      <bpmn:incoming>flow_review_pass</bpmn:incoming>
      <bpmn:outgoing>flow_acceptance_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_acceptance" name="验收通过">
      <bpmn:incoming>flow_acceptance_gw</bpmn:incoming>
      <bpmn:outgoing>flow_acceptance_back</bpmn:outgoing>
      <bpmn:outgoing>flow_acceptance_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_1" name="发布">
      <bpmn:incoming>flow_acceptance_pass</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_requirement" />
    <bpmn:sequenceFlow id="flow_req_design" sourceRef="task_requirement" targetRef="task_design" />
    <bpmn:sequenceFlow id="flow_design_coding" sourceRef="task_design" targetRef="task_coding" />
    <bpmn:sequenceFlow id="flow_coding_gw" sourceRef="task_coding" targetRef="gw_selftest" />
    <bpmn:sequenceFlow id="flow_selftest_back" name="修复缺陷" sourceRef="gw_selftest" targetRef="task_coding" />
    <bpmn:sequenceFlow id="flow_selftest_pass" name="通过" sourceRef="gw_selftest" targetRef="task_codereview" />
    <bpmn:sequenceFlow id="flow_review_gw" sourceRef="task_codereview" targetRef="gw_review" />
    <bpmn:sequenceFlow id="flow_review_back" name="返工设计" sourceRef="gw_review" targetRef="task_design" />
    <bpmn:sequenceFlow id="flow_review_pass" name="通过" sourceRef="gw_review" targetRef="task_acceptance" />
    <bpmn:sequenceFlow id="flow_acceptance_gw" sourceRef="task_acceptance" targetRef="gw_acceptance" />
    <bpmn:sequenceFlow id="flow_acceptance_back" name="需求变更" sourceRef="gw_acceptance" targetRef="task_requirement" />
    <bpmn:sequenceFlow id="flow_acceptance_pass" name="通过" sourceRef="gw_acceptance" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_triple_nested_loops" name="BPMNDiagram">
