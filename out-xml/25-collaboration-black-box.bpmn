<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_collab_blackbox" targetNamespace="http://example.com/test-collab-blackbox" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="黑盒池交互">
    <bpmn:participant id="pool_internal" name="内部系统" processRef="process_internal" />
    <bpmn:participant id="pool_external" name="外部服务" processRef="Process_pool_external" />
    <bpmn:messageFlow id="msgflow_req" name="API请求" sourceRef="task_call_api" targetRef="pool_external" />
    <bpmn:messageFlow id="msgflow_resp" name="API响应" sourceRef="pool_external" targetRef="task_receive" />
  </bpmn:collaboration>
  <bpmn:process id="process_internal" name="内部系统" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="task_call_api" name="调用外部API">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="task_receive" name="接收结果">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_call_api" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_call_api" targetRef="task_receive" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_receive" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_collab_blackbox" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_collab_blackbox" bpmnElement="collaboration_1">
      <bpmndi:BPMNShape id="collaboration_1_di" bpmnElement="collaboration_1">
        <dc:Bounds x="0" y="0" width="594" height="274" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_internal_di" bpmnElement="pool_internal" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="594" height="144" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="62" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="66" y="94" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_call_api_di" bpmnElement="task_call_api">
        <dc:Bounds x="178" y="32" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receive_di" bpmnElement="task_receive">
        <dc:Bounds x="358" y="32" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="538" y="54" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="542" y="94" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_external_di" bpmnElement="pool_external" isHorizontal="true">
        <dc:Bounds x="0" y="174" width="594" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="98" y="72" />
        <di:waypoint x="178" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="278" y="72" />
        <di:waypoint x="358" y="72" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="458" y="72" />
        <di:waypoint x="538" y="72" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
