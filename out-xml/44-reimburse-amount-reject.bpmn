<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_reimburse_amount_reject" targetNamespace="http://example.com/reimburse-amount-reject" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="公司报销流程">
    <bpmn:participant id="pool_company" name="公司内部" processRef="process_company" />
  </bpmn:collaboration>
  <bpmn:process id="process_company" name="公司内部" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_staff" name="员工">
        <bpmn:flowNodeRef>start_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_dept" name="部门经理">
        <bpmn:flowNodeRef>gw_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_mgr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_director" name="总监">
        <bpmn:flowNodeRef>task_director</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_finance" name="财务">
        <bpmn:flowNodeRef>task_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_apply" name="发起报销">
      <bpmn:outgoing>f_start_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit" name="提交报销单">
      <bpmn:incoming>f_start_submit</bpmn:incoming>
      <bpmn:incoming>f_mgr_reject</bpmn:incoming>
      <bpmn:incoming>f_director_reject</bpmn:incoming>
      <bpmn:outgoing>f_submit_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_amount" name="金额判断" default="f_lt5000">
      <bpmn:incoming>f_submit_gw</bpmn:incoming>
      <bpmn:outgoing>f_ge5000</bpmn:outgoing>
      <bpmn:outgoing>f_lt5000</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_mgr" name="经理审批">
      <bpmn:incoming>f_ge5000</bpmn:incoming>
      <bpmn:outgoing>f_mgr_pass</bpmn:outgoing>
      <bpmn:outgoing>f_mgr_reject</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_director" name="总监审批">
      <bpmn:incoming>f_lt5000</bpmn:incoming>
      <bpmn:incoming>f_mgr_pass</bpmn:incoming>
      <bpmn:outgoing>f_director_pass</bpmn:outgoing>
      <bpmn:outgoing>f_director_reject</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_pay" name="财务打款">
      <bpmn:incoming>f_director_pass</bpmn:incoming>
      <bpmn:outgoing>f_pay_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_done" name="报销完成">
      <bpmn:incoming>f_pay_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_submit" sourceRef="start_apply" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_submit_gw" sourceRef="task_submit" targetRef="gw_amount" />
    <bpmn:sequenceFlow id="f_ge5000" name="金额≥5000" sourceRef="gw_amount" targetRef="task_mgr" />
    <bpmn:sequenceFlow id="f_lt5000" name="金额＜5000" sourceRef="gw_amount" targetRef="task_director" />
    <bpmn:sequenceFlow id="f_mgr_pass" name="通过" sourceRef="task_mgr" targetRef="task_director" />
    <bpmn:sequenceFlow id="f_mgr_reject" name="驳回" sourceRef="task_mgr" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_director_pass" name="通过" sourceRef="task_director" targetRef="task_pay" />
    <bpmn:sequenceFlow id="f_director_reject" name="驳回" sourceRef="task_director" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_pay_end" sourceRef="task_pay" targetRef="end_done" />
  </bpmn:process>
