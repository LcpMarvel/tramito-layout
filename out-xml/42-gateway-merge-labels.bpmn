<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_gateway_spine_1" targetNamespace="http://example.com/fuzz-gateway-spine-1" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_spine_1" name="多级分叉合并主干压测" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>f_start_xor</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_xor_div" name="排他分叉" gatewayDirection="Diverging" default="flow_xor_c">
      <bpmn:incoming>f_start_xor</bpmn:incoming>
      <bpmn:outgoing>flow_xor_a</bpmn:outgoing>
      <bpmn:outgoing>flow_xor_b</bpmn:outgoing>
      <bpmn:outgoing>flow_xor_c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_xor_a1" name="信用评估">
      <bpmn:incoming>flow_xor_a</bpmn:incoming>
      <bpmn:outgoing>f_xor_a1_conv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_xor_b1" name="自动审批">
      <bpmn:incoming>flow_xor_b</bpmn:incoming>
      <bpmn:outgoing>f_xor_b1_conv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="task_xor_c1" name="人工复核">
      <bpmn:incoming>flow_xor_c</bpmn:incoming>
      <bpmn:outgoing>f_xor_c1_conv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_xor_conv" name="排他合并" gatewayDirection="Converging">
      <bpmn:incoming>f_xor_a1_conv</bpmn:incoming>
      <bpmn:incoming>f_xor_b1_conv</bpmn:incoming>
      <bpmn:incoming>f_xor_c1_conv</bpmn:incoming>
      <bpmn:outgoing>f_xor_conv_par</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_par_div" name="并行分叉" gatewayDirection="Diverging">
      <bpmn:incoming>f_xor_conv_par</bpmn:incoming>
      <bpmn:outgoing>f_par_1</bpmn:outgoing>
      <bpmn:outgoing>f_par_2</bpmn:outgoing>
      <bpmn:outgoing>f_par_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="task_par_1a" name="发送邮件通知">
      <bpmn:incoming>f_par_1</bpmn:incoming>
      <bpmn:outgoing>f_par_1_conv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_par_2a" name="更新数据库">
      <bpmn:incoming>f_par_2</bpmn:incoming>
      <bpmn:outgoing>f_par_2_conv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_par_3a" name="线下签署协议">
      <bpmn:incoming>f_par_3</bpmn:incoming>
      <bpmn:outgoing>f_par_3_conv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gw_par_conv" name="并行合并" gatewayDirection="Converging">
      <bpmn:incoming>f_par_1_conv</bpmn:incoming>
      <bpmn:incoming>f_par_2_conv</bpmn:incoming>
      <bpmn:incoming>f_par_3_conv</bpmn:incoming>
      <bpmn:outgoing>f_par_conv_inc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:inclusiveGateway id="gw_inc_div" name="包容分叉" gatewayDirection="Diverging" default="flow_inc_standard">
      <bpmn:incoming>f_par_conv_inc</bpmn:incoming>
      <bpmn:outgoing>flow_inc_vip</bpmn:outgoing>
      <bpmn:outgoing>flow_inc_standard</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="task_inc_vip" name="VIP专属服务">
      <bpmn:incoming>flow_inc_vip</bpmn:incoming>
      <bpmn:outgoing>f_inc_vip_conv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="task_inc_standard" name="标准服务流程">
      <bpmn:incoming>flow_inc_standard</bpmn:incoming>
      <bpmn:outgoing>f_inc_std_conv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="gw_inc_conv" name="包容合并" gatewayDirection="Converging">
      <bpmn:incoming>f_inc_vip_conv</bpmn:incoming>
      <bpmn:incoming>f_inc_std_conv</bpmn:incoming>
      <bpmn:outgoing>f_inc_conv_fin</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="task_finalize" name="归档结案">
      <bpmn:incoming>f_inc_conv_fin</bpmn:incoming>
      <bpmn:outgoing>f_fin_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>f_fin_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_xor" sourceRef="start_1" targetRef="gw_xor_div" />
    <bpmn:sequenceFlow id="flow_xor_a" name="高风险" sourceRef="gw_xor_div" targetRef="task_xor_a1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${risk == 'high'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_xor_b" name="低风险" sourceRef="gw_xor_div" targetRef="task_xor_b1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${risk == 'low'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_xor_c" name="默认" sourceRef="gw_xor_div" targetRef="task_xor_c1" />
    <bpmn:sequenceFlow id="f_xor_a1_conv" sourceRef="task_xor_a1" targetRef="gw_xor_conv" />
    <bpmn:sequenceFlow id="f_xor_b1_conv" sourceRef="task_xor_b1" targetRef="gw_xor_conv" />
    <bpmn:sequenceFlow id="f_xor_c1_conv" sourceRef="task_xor_c1" targetRef="gw_xor_conv" />
    <bpmn:sequenceFlow id="f_xor_conv_par" sourceRef="gw_xor_conv" targetRef="gw_par_div" />
    <bpmn:sequenceFlow id="f_par_1" sourceRef="gw_par_div" targetRef="task_par_1a" />
    <bpmn:sequenceFlow id="f_par_2" sourceRef="gw_par_div" targetRef="task_par_2a" />
    <bpmn:sequenceFlow id="f_par_3" sourceRef="gw_par_div" targetRef="task_par_3a" />
    <bpmn:sequenceFlow id="f_par_1_conv" sourceRef="task_par_1a" targetRef="gw_par_conv" />
    <bpmn:sequenceFlow id="f_par_2_conv" sourceRef="task_par_2a" targetRef="gw_par_conv" />
    <bpmn:sequenceFlow id="f_par_3_conv" sourceRef="task_par_3a" targetRef="gw_par_conv" />
    <bpmn:sequenceFlow id="f_par_conv_inc" sourceRef="gw_par_conv" targetRef="gw_inc_div" />
    <bpmn:sequenceFlow id="flow_inc_vip" name="VIP客户" sourceRef="gw_inc_div" targetRef="task_inc_vip">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isVip == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_inc_standard" name="标准" sourceRef="gw_inc_div" targetRef="task_inc_standard" />
    <bpmn:sequenceFlow id="f_inc_vip_conv" sourceRef="task_inc_vip" targetRef="gw_inc_conv" />
    <bpmn:sequenceFlow id="f_inc_std_conv" sourceRef="task_inc_standard" targetRef="gw_inc_conv" />
    <bpmn:sequenceFlow id="f_inc_conv_fin" sourceRef="gw_inc_conv" targetRef="task_finalize" />
    <bpmn:sequenceFlow id="f_fin_end" sourceRef="task_finalize" targetRef="end_1" />
  </bpmn:process>
