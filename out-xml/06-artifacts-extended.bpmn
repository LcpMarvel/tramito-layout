<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_artifacts_extended" targetNamespace="http://example.com/test-artifacts-extended" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_artifacts_extended" name="扩展工件测试" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开始">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="task_receive_data" name="接收数据">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:dataInputAssociation id="data_assoc_raw_to_receive">
        <bpmn:sourceRef>data_input_raw</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="task_process_data" name="处理数据">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="data_assoc_process_to_output">
        <bpmn:targetRef>data_output_processed</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="data_assoc_process_to_store">
        <bpmn:targetRef>data_store_main</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="task_validate" name="验证规则">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:dataInputAssociation id="data_assoc_output_to_validate">
        <bpmn:sourceRef>data_output_processed</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="task_approve" name="人工审批">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="task_send_result" name="发送结果">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="data_assoc_send_to_archive">
        <bpmn:targetRef>data_store_archive</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_1" name="结束">
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:group id="group_data_handling" name="数据处理阶段" />
    <bpmn:group id="group_approval" name="审批阶段" />
    <bpmn:dataObjectReference id="data_input_raw" name="原始数据" />
    <bpmn:dataObjectReference id="data_output_processed" name="处理后数据" />
    <bpmn:dataStoreReference id="data_store_main" name="主数据库" />
    <bpmn:dataStoreReference id="data_store_archive" name="归档数据库" />
    <bpmn:textAnnotation id="annotation_data_format">
      <bpmn:text>数据格式必须符合JSON Schema v1.2规范</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="annotation_sla">
      <bpmn:text>SLA: 24小时内完成审批</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="annotation_bidirectional">
      <bpmn:text>双向数据同步</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_receive_data" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_receive_data" targetRef="task_process_data" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_process_data" targetRef="task_validate" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_validate" targetRef="task_approve" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_approve" targetRef="task_send_result" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_send_result" targetRef="end_1" />
    <bpmn:association id="assoc_annotation_format_none" associationDirection="None" sourceRef="annotation_data_format" targetRef="task_receive_data" />
    <bpmn:association id="assoc_annotation_sla_one" associationDirection="One" sourceRef="annotation_sla" targetRef="task_approve" />
    <bpmn:association id="assoc_stores_both" associationDirection="Both" sourceRef="data_store_main" targetRef="data_store_archive" />
    <bpmn:association id="assoc_annotation_bidirectional" associationDirection="One" sourceRef="annotation_bidirectional" targetRef="data_store_main" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_artifacts_extended" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_artifacts_extended" bpmnElement="process_artifacts_extended">
      <bpmndi:BPMNShape id="process_artifacts_extended_di" bpmnElement="process_artifacts_extended">
        <dc:Bounds x="0" y="0" width="658" height="620" />
