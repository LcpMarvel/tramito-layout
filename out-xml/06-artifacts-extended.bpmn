      <bpmndi:BPMNShape id="task_receive_data_di" bpmnElement="task_receive_data">
        <dc:Bounds x="178" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_data_di" bpmnElement="task_process_data">
        <dc:Bounds x="358" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_validate_di" bpmnElement="task_validate">
        <dc:Bounds x="538" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_di" bpmnElement="task_approve">
        <dc:Bounds x="62" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_result_di" bpmnElement="task_send_result">
        <dc:Bounds x="242" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="422" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="426" y="472" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_input_raw_di" bpmnElement="data_input_raw">
        <dc:Bounds x="140" y="40" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_output_processed_di" bpmnElement="data_output_processed">
        <dc:Bounds x="570" y="40" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_store_main_di" bpmnElement="data_store_main">
        <dc:Bounds x="323" y="250" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_store_archive_di" bpmnElement="data_store_archive">
        <dc:Bounds x="267" y="530" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="annotation_data_format_di" bpmnElement="annotation_data_format">
        <dc:Bounds x="196" y="40" width="120" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="annotation_sla_di" bpmnElement="annotation_sla">
        <dc:Bounds x="62" y="330" width="100" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="annotation_bidirectional_di" bpmnElement="annotation_bidirectional">
        <dc:Bounds x="393" y="250" width="100" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="98" y="170" />
        <di:waypoint x="178" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="278" y="170" />
        <di:waypoint x="358" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="458" y="170" />
        <di:waypoint x="538" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="588" y="210" />
        <di:waypoint x="588" y="310" />
        <di:waypoint x="52" y="310" />
        <di:waypoint x="52" y="390" />
        <di:waypoint x="112" y="390" />
        <di:waypoint x="112" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="162" y="450" />
        <di:waypoint x="242" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="342" y="450" />
        <di:waypoint x="422" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="data_assoc_raw_to_receive_di" bpmnElement="data_assoc_raw_to_receive">
