<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_long_backedge" targetNamespace="http://example.com/test-long-backedge" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_long_backedge" name="生产线终检长回边" isExecutable="true">
    <bpmn:startEvent id="start_1" name="开工">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_material" name="原料准备">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:incoming>flow_reject</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_rough" name="粗加工">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_fine" name="精加工">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_assemble" name="部件组装">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_debug" name="整机调试">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_paint" name="表面喷涂">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_pack" name="包装">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_finalcheck" name="终检">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_final" name="终检合格">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_1" name="入库">
      <bpmn:incoming>flow_pass</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="task_material" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="task_material" targetRef="task_rough" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_rough" targetRef="task_fine" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_fine" targetRef="task_assemble" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_assemble" targetRef="task_debug" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_debug" targetRef="task_paint" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_paint" targetRef="task_pack" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_pack" targetRef="task_finalcheck" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="task_finalcheck" targetRef="gw_final" />
    <bpmn:sequenceFlow id="flow_pass" name="合格" sourceRef="gw_final" targetRef="end_1" />
    <bpmn:sequenceFlow id="flow_reject" name="整批返工" sourceRef="gw_final" targetRef="task_material" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_long_backedge" name="BPMNDiagram">
