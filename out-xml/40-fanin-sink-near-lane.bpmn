<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_fuzz_fan_in_common_sink_1" targetNamespace="http://example.com/fuzz-fan-in-common-sink-1" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="多级驳回归一压测">
    <bpmn:participant id="pool_main" name="费用报销流程" processRef="process_main" />
  </bpmn:collaboration>
  <bpmn:process id="process_main" name="费用报销流程" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_applicant" name="申请人">
        <bpmn:flowNodeRef>start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_dept" name="部门主管">
        <bpmn:flowNodeRef>task_dept_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_dept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_finance" name="财务专员">
        <bpmn:flowNodeRef>task_fin_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_manager" name="财务经理">
        <bpmn:flowNodeRef>task_mgr_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_mgr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_cfo" name="CFO">
        <bpmn:flowNodeRef>task_cfo_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_cfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_1" name="发起报销">
      <bpmn:outgoing>f_start_revise</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_revise" name="修改申请单">
      <bpmn:incoming>f_start_revise</bpmn:incoming>
      <bpmn:incoming>f_dept_reject</bpmn:incoming>
      <bpmn:incoming>f_fin_reject</bpmn:incoming>
      <bpmn:incoming>f_mgr_reject</bpmn:incoming>
      <bpmn:incoming>f_cfo_reject</bpmn:incoming>
      <bpmn:outgoing>f_revise_submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_submit" name="提交申请单">
      <bpmn:incoming>f_revise_submit</bpmn:incoming>
      <bpmn:outgoing>f_submit_dept</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_dept_review" name="部门审核">
      <bpmn:incoming>f_submit_dept</bpmn:incoming>
      <bpmn:outgoing>f_dept_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_dept" name="部门通过?">
      <bpmn:incoming>f_dept_gw</bpmn:incoming>
      <bpmn:outgoing>f_dept_pass</bpmn:outgoing>
      <bpmn:outgoing>f_dept_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_fin_check" name="财务初审">
      <bpmn:incoming>f_dept_pass</bpmn:incoming>
      <bpmn:outgoing>f_fin_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_fin" name="初审通过?">
      <bpmn:incoming>f_fin_gw</bpmn:incoming>
      <bpmn:outgoing>f_fin_pass</bpmn:outgoing>
      <bpmn:outgoing>f_fin_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_mgr_review" name="经理复核">
      <bpmn:incoming>f_fin_pass</bpmn:incoming>
      <bpmn:outgoing>f_mgr_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_mgr" name="复核通过?">
      <bpmn:incoming>f_mgr_gw</bpmn:incoming>
      <bpmn:outgoing>f_mgr_pass</bpmn:outgoing>
      <bpmn:outgoing>f_mgr_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_cfo_approve" name="CFO 最终审批">
      <bpmn:incoming>f_mgr_pass</bpmn:incoming>
      <bpmn:outgoing>f_cfo_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_cfo" name="CFO 通过?">
      <bpmn:incoming>f_cfo_gw</bpmn:incoming>
      <bpmn:outgoing>f_cfo_pass</bpmn:outgoing>
      <bpmn:outgoing>f_cfo_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_pay" name="付款处理">
      <bpmn:incoming>f_cfo_pass</bpmn:incoming>
      <bpmn:outgoing>f_pay_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="报销完成">
      <bpmn:incoming>f_pay_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_revise" sourceRef="start_1" targetRef="task_revise" />
    <bpmn:sequenceFlow id="f_revise_submit" sourceRef="task_revise" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_submit_dept" sourceRef="task_submit" targetRef="task_dept_review" />
    <bpmn:sequenceFlow id="f_dept_gw" sourceRef="task_dept_review" targetRef="gw_dept" />
    <bpmn:sequenceFlow id="f_dept_pass" name="通过" sourceRef="gw_dept" targetRef="task_fin_check" />
    <bpmn:sequenceFlow id="f_dept_reject" name="驳回" sourceRef="gw_dept" targetRef="task_revise" />
    <bpmn:sequenceFlow id="f_fin_gw" sourceRef="task_fin_check" targetRef="gw_fin" />
    <bpmn:sequenceFlow id="f_fin_pass" name="通过" sourceRef="gw_fin" targetRef="task_mgr_review" />
    <bpmn:sequenceFlow id="f_fin_reject" name="驳回" sourceRef="gw_fin" targetRef="task_revise" />
    <bpmn:sequenceFlow id="f_mgr_gw" sourceRef="task_mgr_review" targetRef="gw_mgr" />
    <bpmn:sequenceFlow id="f_mgr_pass" name="通过" sourceRef="gw_mgr" targetRef="task_cfo_approve" />
    <bpmn:sequenceFlow id="f_mgr_reject" name="驳回" sourceRef="gw_mgr" targetRef="task_revise" />
    <bpmn:sequenceFlow id="f_cfo_gw" sourceRef="task_cfo_approve" targetRef="gw_cfo" />
    <bpmn:sequenceFlow id="f_cfo_pass" name="通过" sourceRef="gw_cfo" targetRef="task_pay" />
    <bpmn:sequenceFlow id="f_cfo_reject" name="驳回" sourceRef="gw_cfo" targetRef="task_revise" />
    <bpmn:sequenceFlow id="f_pay_end" sourceRef="task_pay" targetRef="end_1" />
  </bpmn:process>
