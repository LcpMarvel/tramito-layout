<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_cross_lane_updown" targetNamespace="http://example.com/test-cross-lane-updown-backedges" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_updown" name="跨泳道双向回边">
    <bpmn:participant id="pool_service" name="业务办理中心" processRef="process_service" />
  </bpmn:collaboration>
  <bpmn:process id="process_service" name="业务办理中心" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_customer" name="客户">
        <bpmn:flowNodeRef>start_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_agent" name="客服专员">
        <bpmn:flowNodeRef>task_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_auditor" name="审核员">
        <bpmn:flowNodeRef>task_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_audit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_system" name="业务系统">
        <bpmn:flowNodeRef>task_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_req" name="发起办理">
      <bpmn:outgoing>f_start_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit" name="提交申请材料">
      <bpmn:incoming>f_start_submit</bpmn:incoming>
      <bpmn:incoming>f_audit_back_submit</bpmn:incoming>
      <bpmn:outgoing>f_submit_register</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_accept" name="客服受理">
      <bpmn:incoming>f_register_accept</bpmn:incoming>
      <bpmn:outgoing>f_accept_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_complete" name="登记无误">
      <bpmn:incoming>f_accept_gw</bpmn:incoming>
      <bpmn:outgoing>f_complete_audit</bpmn:outgoing>
      <bpmn:outgoing>f_complete_back_register</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_audit" name="资格审核">
      <bpmn:incoming>f_complete_audit</bpmn:incoming>
      <bpmn:outgoing>f_audit_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_audit" name="审核通过">
      <bpmn:incoming>f_audit_gw</bpmn:incoming>
      <bpmn:outgoing>f_audit_pass</bpmn:outgoing>
      <bpmn:outgoing>f_audit_back_submit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_register" name="系统预登记">
      <bpmn:incoming>f_submit_register</bpmn:incoming>
      <bpmn:incoming>f_complete_back_register</bpmn:incoming>
      <bpmn:outgoing>f_register_accept</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_archive" name="系统归档">
      <bpmn:incoming>f_audit_pass</bpmn:incoming>
      <bpmn:outgoing>f_archive_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_done" name="办结">
      <bpmn:incoming>f_archive_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_submit" sourceRef="start_req" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_submit_register" sourceRef="task_submit" targetRef="task_register" />
    <bpmn:sequenceFlow id="f_register_accept" sourceRef="task_register" targetRef="task_accept" />
    <bpmn:sequenceFlow id="f_accept_gw" sourceRef="task_accept" targetRef="gw_complete" />
    <bpmn:sequenceFlow id="f_complete_audit" name="无误" sourceRef="gw_complete" targetRef="task_audit" />
    <bpmn:sequenceFlow id="f_complete_back_register" name="登记有误" sourceRef="gw_complete" targetRef="task_register" />
    <bpmn:sequenceFlow id="f_audit_gw" sourceRef="task_audit" targetRef="gw_audit" />
    <bpmn:sequenceFlow id="f_audit_pass" name="通过" sourceRef="gw_audit" targetRef="task_archive" />
    <bpmn:sequenceFlow id="f_audit_back_submit" name="材料不符" sourceRef="gw_audit" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_archive_end" sourceRef="task_archive" targetRef="end_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_cross_lane_updown" name="BPMNDiagram">
