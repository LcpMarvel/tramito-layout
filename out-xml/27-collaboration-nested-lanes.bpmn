<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_collab_nested_lanes" targetNamespace="http://example.com/test-collab-nested-lanes" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="嵌套泳道示例">
    <bpmn:participant id="pool_org" name="组织" processRef="process_org" />
  </bpmn:collaboration>
  <bpmn:process id="process_org" name="组织" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_management" name="管理层">
        <bpmn:flowNodeRef>start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_execution" name="执行层">
        <bpmn:childLaneSet id="LaneSet_2">
          <bpmn:lane id="lane_team_a" name="A组">
            <bpmn:flowNodeRef>task_exec_a</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="lane_team_b" name="B组">
            <bpmn:flowNodeRef>task_exec_b</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>end_1</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_1" name="发起">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_assign" name="分配任务">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="task_exec_a" name="A组执行">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_exec_b" name="B组执行">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_1" name="完成">
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_assign" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_assign" targetRef="task_exec_a" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="task_exec_a" targetRef="task_exec_b" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_exec_b" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_collab_nested_lanes" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_collab_nested_lanes" bpmnElement="collaboration_1">
      <bpmndi:BPMNShape id="collaboration_1_di" bpmnElement="collaboration_1">
        <dc:Bounds x="0" y="0" width="774" height="376" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_org_di" bpmnElement="pool_org" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="774" height="376" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_management_di" bpmnElement="lane_management" isHorizontal="true">
        <dc:Bounds x="30" y="20" width="744" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="62" y="58" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="30" y="98" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assign_di" bpmnElement="task_assign">
        <dc:Bounds x="178" y="36" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_execution_di" bpmnElement="lane_execution" isHorizontal="true">
        <dc:Bounds x="30" y="132" width="744" height="224" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_team_a_di" bpmnElement="lane_team_a" isHorizontal="true">
        <dc:Bounds x="60" y="132" width="714" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_exec_a_di" bpmnElement="task_exec_a">
        <dc:Bounds x="358" y="148" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_team_b_di" bpmnElement="lane_team_b" isHorizontal="true">
        <dc:Bounds x="60" y="244" width="714" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_exec_b_di" bpmnElement="task_exec_b">
        <dc:Bounds x="538" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="718" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="686" y="322" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="98" y="76" />
        <di:waypoint x="178" y="76" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="228" y="116" />
        <di:waypoint x="228" y="188" />
        <di:waypoint x="358" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="408" y="228" />
        <di:waypoint x="408" y="300" />
        <di:waypoint x="538" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="638" y="300" />
        <di:waypoint x="718" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
