      <bpmndi:BPMNShape id="lane_dev_dept_di" bpmnElement="lane_dev_dept" isHorizontal="true">
        <dc:Bounds x="60" y="380" width="1074" height="224" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_backend_team_di" bpmnElement="lane_backend_team" isHorizontal="true">
        <dc:Bounds x="90" y="380" width="1044" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_backend_estimate_di" bpmnElement="task_backend_estimate">
        <dc:Bounds x="538" y="396" width="100" height="80" />
