      <bpmndi:BPMNShape id="start_expense_di" bpmnElement="start_expense">
        <dc:Bounds x="62" y="58" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="30" y="98" width="100" height="14" />
