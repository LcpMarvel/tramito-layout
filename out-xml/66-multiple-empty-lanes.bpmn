      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_2_reserved_audit_di" bpmnElement="lane_2_reserved_audit" isHorizontal="true">
        <dc:Bounds x="30" y="268" width="924" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_3_manager_di" bpmnElement="lane_3_manager" isHorizontal="true">
        <dc:Bounds x="30" y="368" width="924" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_manager_approve_di" bpmnElement="task_manager_approve">
        <dc:Bounds x="358" y="384" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_4_reserved_legal_di" bpmnElement="lane_4_reserved_legal" isHorizontal="true">
        <dc:Bounds x="30" y="480" width="924" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_5_reserved_tax_di" bpmnElement="lane_5_reserved_tax" isHorizontal="true">
        <dc:Bounds x="30" y="580" width="924" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_6_cashier_di" bpmnElement="lane_6_cashier" isHorizontal="true">
        <dc:Bounds x="30" y="680" width="924" height="112" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_pay_di" bpmnElement="task_pay">
        <dc:Bounds x="538" y="696" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="98" y="76" />
        <di:waypoint x="178" y="76" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="228" y="116" />
        <di:waypoint x="228" y="424" />
        <di:waypoint x="358" y="424" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="408" y="464" />
        <di:waypoint x="408" y="736" />
        <di:waypoint x="538" y="736" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="588" y="696" />
        <di:waypoint x="588" y="212" />
        <di:waypoint x="718" y="212" />
