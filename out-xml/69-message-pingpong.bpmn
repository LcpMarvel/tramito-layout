<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_message_pingpong" targetNamespace="http://example.com/test-message-pingpong" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:message id="msg_inquiry" name="询价单" />
  <bpmn:message id="msg_quote" name="报价单" />
  <bpmn:message id="msg_order" name="采购订单" />
  <bpmn:message id="msg_confirm" name="订单确认" />
  <bpmn:message id="msg_payment" name="付款凭证" />
  <bpmn:message id="msg_receipt" name="收款收据" />
  <bpmn:collaboration id="collaboration_1" name="采购六轮消息乒乓">
    <bpmn:participant id="pool_purchaser" name="采购方" processRef="process_purchaser" />
    <bpmn:participant id="pool_supplier" name="供应商" processRef="process_supplier" />
    <bpmn:messageFlow id="msgflow_1_inquiry" sourceRef="task_a_inquiry" targetRef="start_b" messageRef="msg_inquiry" />
    <bpmn:messageFlow id="msgflow_2_quote" sourceRef="task_b_quote" targetRef="catch_a_quote" messageRef="msg_quote" />
    <bpmn:messageFlow id="msgflow_3_order" sourceRef="task_a_order" targetRef="catch_b_order" messageRef="msg_order" />
    <bpmn:messageFlow id="msgflow_4_confirm" sourceRef="task_b_confirm" targetRef="catch_a_confirm" messageRef="msg_confirm" />
    <bpmn:messageFlow id="msgflow_5_payment" sourceRef="task_a_pay" targetRef="catch_b_payment" messageRef="msg_payment" />
    <bpmn:messageFlow id="msgflow_6_receipt" sourceRef="task_b_receipt" targetRef="catch_a_receipt" messageRef="msg_receipt" />
  </bpmn:collaboration>
  <bpmn:process id="process_purchaser" name="采购方" isExecutable="true">
    <bpmn:startEvent id="start_a" name="采购启动">
      <bpmn:outgoing>flow_a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="task_a_inquiry" name="发送询价">
      <bpmn:incoming>flow_a1</bpmn:incoming>
      <bpmn:outgoing>flow_a2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="catch_a_quote" name="等待报价">
      <bpmn:incoming>flow_a2</bpmn:incoming>
      <bpmn:outgoing>flow_a3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_quote" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="task_a_order" name="发送订单">
      <bpmn:incoming>flow_a3</bpmn:incoming>
      <bpmn:outgoing>flow_a4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="catch_a_confirm" name="等待确认">
      <bpmn:incoming>flow_a4</bpmn:incoming>
      <bpmn:outgoing>flow_a5</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_confirm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="task_a_pay" name="支付货款">
      <bpmn:incoming>flow_a5</bpmn:incoming>
      <bpmn:outgoing>flow_a6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="catch_a_receipt" name="等待收据">
      <bpmn:incoming>flow_a6</bpmn:incoming>
      <bpmn:outgoing>flow_a7</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_receipt" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_a" name="采购完成">
      <bpmn:incoming>flow_a7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_a1" sourceRef="start_a" targetRef="task_a_inquiry" />
    <bpmn:sequenceFlow id="flow_a2" sourceRef="task_a_inquiry" targetRef="catch_a_quote" />
    <bpmn:sequenceFlow id="flow_a3" sourceRef="catch_a_quote" targetRef="task_a_order" />
    <bpmn:sequenceFlow id="flow_a4" sourceRef="task_a_order" targetRef="catch_a_confirm" />
    <bpmn:sequenceFlow id="flow_a5" sourceRef="catch_a_confirm" targetRef="task_a_pay" />
    <bpmn:sequenceFlow id="flow_a6" sourceRef="task_a_pay" targetRef="catch_a_receipt" />
    <bpmn:sequenceFlow id="flow_a7" sourceRef="catch_a_receipt" targetRef="end_a" />
  </bpmn:process>
  <bpmn:process id="process_supplier" name="供应商" isExecutable="true">
    <bpmn:startEvent id="start_b" name="收到询价">
      <bpmn:outgoing>flow_b1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_inquiry" />
    </bpmn:startEvent>
    <bpmn:sendTask id="task_b_quote" name="回复报价">
      <bpmn:incoming>flow_b1</bpmn:incoming>
      <bpmn:outgoing>flow_b2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="catch_b_order" name="等待订单">
      <bpmn:incoming>flow_b2</bpmn:incoming>
      <bpmn:outgoing>flow_b3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_order" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="task_b_confirm" name="确认订单">
      <bpmn:incoming>flow_b3</bpmn:incoming>
      <bpmn:outgoing>flow_b4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="catch_b_payment" name="等待付款">
      <bpmn:incoming>flow_b4</bpmn:incoming>
      <bpmn:outgoing>flow_b5</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_payment" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="task_b_receipt" name="开具收据">
      <bpmn:incoming>flow_b5</bpmn:incoming>
      <bpmn:outgoing>flow_b6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_b" name="销售完成">
      <bpmn:incoming>flow_b6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_b1" sourceRef="start_b" targetRef="task_b_quote" />
    <bpmn:sequenceFlow id="flow_b2" sourceRef="task_b_quote" targetRef="catch_b_order" />
    <bpmn:sequenceFlow id="flow_b3" sourceRef="catch_b_order" targetRef="task_b_confirm" />
    <bpmn:sequenceFlow id="flow_b4" sourceRef="task_b_confirm" targetRef="catch_b_payment" />
    <bpmn:sequenceFlow id="flow_b5" sourceRef="catch_b_payment" targetRef="task_b_receipt" />
    <bpmn:sequenceFlow id="flow_b6" sourceRef="task_b_receipt" targetRef="end_b" />
  </bpmn:process>
