<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_cross_pool_patterns" targetNamespace="http://example.com/test-cross-pool-patterns" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:message id="msg_order_request" name="订单请求" />
  <bpmn:message id="msg_order_response" name="订单响应" />
  <bpmn:message id="msg_payment_request" name="支付请求" />
  <bpmn:message id="msg_payment_confirmation" name="支付确认" />
  <bpmn:message id="msg_shipping_request" name="发货请求" />
  <bpmn:message id="msg_shipping_status" name="发货状态" />
  <bpmn:message id="msg_notification" name="通知消息" />
  <bpmn:collaboration id="collaboration_cross_pool" name="跨池通信模式">
    <bpmn:participant id="participant_customer" name="客户" processRef="process_customer" />
    <bpmn:participant id="participant_order_system" name="订单系统" processRef="process_order_system" />
    <bpmn:participant id="participant_payment_system" name="支付系统" processRef="process_payment_system" />
    <bpmn:participant id="participant_shipping_system" name="物流系统" processRef="process_shipping_system" />
    <bpmn:participant id="participant_blackbox_external" name="外部系统 (黑盒)" processRef="Process_participant_blackbox_external" />
    <bpmn:messageFlow id="msgflow_order_request" sourceRef="customer_send_order" targetRef="order_start" messageRef="msg_order_request" />
    <bpmn:messageFlow id="msgflow_order_response" sourceRef="order_send_confirmation" targetRef="customer_wait_confirmation" messageRef="msg_order_response" />
    <bpmn:messageFlow id="msgflow_payment_to_order" sourceRef="customer_send_payment" targetRef="order_wait_payment" messageRef="msg_payment_request" />
    <bpmn:messageFlow id="msgflow_order_to_payment" sourceRef="order_send_to_payment" targetRef="payment_start" messageRef="msg_payment_request" />
    <bpmn:messageFlow id="msgflow_payment_confirmation" sourceRef="payment_send_confirmation" targetRef="order_wait_payment_result" messageRef="msg_payment_confirmation" />
    <bpmn:messageFlow id="msgflow_payment_to_customer" sourceRef="order_send_payment_confirm" targetRef="customer_wait_payment_confirm" messageRef="msg_payment_confirmation" />
    <bpmn:messageFlow id="msgflow_shipping_request" sourceRef="order_send_shipping_request" targetRef="shipping_start" messageRef="msg_shipping_request" />
    <bpmn:messageFlow id="msgflow_shipping_status" sourceRef="shipping_send_status" targetRef="order_wait_shipping" messageRef="msg_shipping_status" />
    <bpmn:messageFlow id="msgflow_shipping_to_customer" sourceRef="order_notify_customer" targetRef="customer_wait_shipping" messageRef="msg_shipping_status" />
    <bpmn:messageFlow id="msgflow_to_external" name="外部验证" sourceRef="order_validate" targetRef="participant_blackbox_external" />
    <bpmn:messageFlow id="msgflow_from_external" name="验证结果" sourceRef="participant_blackbox_external" targetRef="order_validate" />
  </bpmn:collaboration>
  <bpmn:process id="process_customer" name="客户" isExecutable="true">
    <bpmn:startEvent id="customer_start" name="开始购物">
      <bpmn:outgoing>customer_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="customer_send_order" name="发送订单" messageRef="msg_order_request">
      <bpmn:incoming>customer_flow_1</bpmn:incoming>
      <bpmn:outgoing>customer_flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="customer_wait_confirmation" name="等待订单确认">
      <bpmn:incoming>customer_flow_2</bpmn:incoming>
      <bpmn:outgoing>customer_flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_order_response" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="customer_send_payment" name="发送支付" messageRef="msg_payment_request">
      <bpmn:incoming>customer_flow_3</bpmn:incoming>
      <bpmn:outgoing>customer_flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="customer_wait_payment_confirm" name="等待支付确认">
      <bpmn:incoming>customer_flow_4</bpmn:incoming>
      <bpmn:outgoing>customer_flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_payment_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="customer_wait_shipping" name="等待发货通知">
      <bpmn:incoming>customer_flow_5</bpmn:incoming>
      <bpmn:outgoing>customer_flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_shipping_status" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="customer_end" name="购物完成">
      <bpmn:incoming>customer_flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="customer_flow_1" sourceRef="customer_start" targetRef="customer_send_order" />
    <bpmn:sequenceFlow id="customer_flow_2" sourceRef="customer_send_order" targetRef="customer_wait_confirmation" />
    <bpmn:sequenceFlow id="customer_flow_3" sourceRef="customer_wait_confirmation" targetRef="customer_send_payment" />
    <bpmn:sequenceFlow id="customer_flow_4" sourceRef="customer_send_payment" targetRef="customer_wait_payment_confirm" />
    <bpmn:sequenceFlow id="customer_flow_5" sourceRef="customer_wait_payment_confirm" targetRef="customer_wait_shipping" />
    <bpmn:sequenceFlow id="customer_flow_6" sourceRef="customer_wait_shipping" targetRef="customer_end" />
  </bpmn:process>
  <bpmn:process id="process_order_system" name="订单系统" isExecutable="true">
    <bpmn:startEvent id="order_start" name="收到订单">
      <bpmn:outgoing>order_flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_order_request" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="order_validate" name="验证订单">
      <bpmn:incoming>order_flow_1</bpmn:incoming>
      <bpmn:outgoing>order_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="order_send_confirmation" name="发送确认" messageRef="msg_order_response">
      <bpmn:incoming>order_flow_2</bpmn:incoming>
      <bpmn:outgoing>order_flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="order_wait_payment" name="等待支付">
      <bpmn:incoming>order_flow_3</bpmn:incoming>
      <bpmn:outgoing>order_flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_payment_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="order_send_to_payment" name="转发支付" messageRef="msg_payment_request">
      <bpmn:incoming>order_flow_4</bpmn:incoming>
      <bpmn:outgoing>order_flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="order_wait_payment_result" name="等待支付结果">
      <bpmn:incoming>order_flow_5</bpmn:incoming>
      <bpmn:outgoing>order_flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_payment_confirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="order_send_payment_confirm" name="确认支付" messageRef="msg_payment_confirmation">
      <bpmn:incoming>order_flow_6</bpmn:incoming>
      <bpmn:outgoing>order_flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="order_send_shipping_request" name="请求发货" messageRef="msg_shipping_request">
      <bpmn:incoming>order_flow_7</bpmn:incoming>
      <bpmn:outgoing>order_flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="order_wait_shipping" name="等待发货状态">
      <bpmn:incoming>order_flow_8</bpmn:incoming>
      <bpmn:outgoing>order_flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_shipping_status" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="order_notify_customer" name="通知客户" messageRef="msg_shipping_status">
      <bpmn:incoming>order_flow_9</bpmn:incoming>
      <bpmn:outgoing>order_flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="order_end" name="订单完成">
      <bpmn:incoming>order_flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="order_flow_1" sourceRef="order_start" targetRef="order_validate" />
    <bpmn:sequenceFlow id="order_flow_2" sourceRef="order_validate" targetRef="order_send_confirmation" />
    <bpmn:sequenceFlow id="order_flow_3" sourceRef="order_send_confirmation" targetRef="order_wait_payment" />
    <bpmn:sequenceFlow id="order_flow_4" sourceRef="order_wait_payment" targetRef="order_send_to_payment" />
    <bpmn:sequenceFlow id="order_flow_5" sourceRef="order_send_to_payment" targetRef="order_wait_payment_result" />
    <bpmn:sequenceFlow id="order_flow_6" sourceRef="order_wait_payment_result" targetRef="order_send_payment_confirm" />
    <bpmn:sequenceFlow id="order_flow_7" sourceRef="order_send_payment_confirm" targetRef="order_send_shipping_request" />
    <bpmn:sequenceFlow id="order_flow_8" sourceRef="order_send_shipping_request" targetRef="order_wait_shipping" />
    <bpmn:sequenceFlow id="order_flow_9" sourceRef="order_wait_shipping" targetRef="order_notify_customer" />
    <bpmn:sequenceFlow id="order_flow_10" sourceRef="order_notify_customer" targetRef="order_end" />
  </bpmn:process>
  <bpmn:process id="process_payment_system" name="支付系统" isExecutable="true">
    <bpmn:startEvent id="payment_start" name="收到支付">
      <bpmn:outgoing>payment_flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_payment_request" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="payment_process" name="处理支付">
      <bpmn:incoming>payment_flow_1</bpmn:incoming>
      <bpmn:outgoing>payment_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="payment_send_confirmation" name="发送确认" messageRef="msg_payment_confirmation">
      <bpmn:incoming>payment_flow_2</bpmn:incoming>
      <bpmn:outgoing>payment_flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="payment_end" name="支付完成">
      <bpmn:incoming>payment_flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="payment_flow_1" sourceRef="payment_start" targetRef="payment_process" />
    <bpmn:sequenceFlow id="payment_flow_2" sourceRef="payment_process" targetRef="payment_send_confirmation" />
    <bpmn:sequenceFlow id="payment_flow_3" sourceRef="payment_send_confirmation" targetRef="payment_end" />
  </bpmn:process>
  <bpmn:process id="process_shipping_system" name="物流系统" isExecutable="true">
    <bpmn:startEvent id="shipping_start" name="收到发货请求">
      <bpmn:outgoing>shipping_flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="msg_shipping_request" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="shipping_process" name="处理发货">
      <bpmn:incoming>shipping_flow_1</bpmn:incoming>
      <bpmn:outgoing>shipping_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="shipping_send_status" name="发送状态" messageRef="msg_shipping_status">
      <bpmn:incoming>shipping_flow_2</bpmn:incoming>
      <bpmn:outgoing>shipping_flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="shipping_end" name="发货完成">
      <bpmn:incoming>shipping_flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="shipping_flow_1" sourceRef="shipping_start" targetRef="shipping_process" />
    <bpmn:sequenceFlow id="shipping_flow_2" sourceRef="shipping_process" targetRef="shipping_send_status" />
    <bpmn:sequenceFlow id="shipping_flow_3" sourceRef="shipping_send_status" targetRef="shipping_end" />
  </bpmn:process>
  <bpmn:process id="Process_participant_blackbox_external" name="外部系统 (黑盒)" isExecutable="true" />
