<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_crm_voc" targetNamespace="http://example.com/crm-voc-process" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_crm" name="CRM客户VOC处理流程">
    <bpmn:participant id="pool_crm" name="CRM系统" processRef="process_crm" />
  </bpmn:collaboration>
  <bpmn:process id="process_crm" name="CRM系统" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_sales_support" name="销售支持">
        <bpmn:flowNodeRef>start_voc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_create_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_info_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_supplement_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_split_create_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_auto_relate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_classify_level</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_approval_confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sales_director" name="销售主管">
        <bpmn:flowNodeRef>gateway_review_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_receive_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_match_person</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_dispatch_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_merge_director</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_fast_solution</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sales_manager" name="销售经理">
        <bpmn:flowNodeRef>gateway_approve_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_after_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_notify_ceo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_voc" name="接收到VOC诉求">
      <bpmn:outgoing>flow_start_to_create</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_create_event" name="创建事件">
      <bpmn:incoming>flow_start_to_create</bpmn:incoming>
      <bpmn:incoming>flow_review_reject</bpmn:incoming>
      <bpmn:outgoing>flow_create_to_gateway</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="do_feedback_info" name="反馈信息" />
        <bpmn:dataOutput id="do_event_form_1" name="事件表单" />
        <bpmn:outputSet id="os_create_event">
          <bpmn:dataOutputRefs>do_feedback_info</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>do_event_form_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="do_feedback_info_assoc">
        <bpmn:targetRef>do_feedback_info</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_info_complete" name="关键信息是否完整" gatewayDirection="Diverging">
      <bpmn:incoming>flow_create_to_gateway</bpmn:incoming>
      <bpmn:incoming>flow_supplement_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_no</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_supplement_info" name="补充事件信息">
      <bpmn:incoming>flow_gateway_no</bpmn:incoming>
      <bpmn:outgoing>flow_supplement_to_gateway</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="do_supplement_info" name="补充信息" />
        <bpmn:dataOutput id="do_event_form_2" name="事件表单" />
        <bpmn:outputSet id="os_supplement">
          <bpmn:dataOutputRefs>do_supplement_info</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>do_event_form_2</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="do_supplement_info_assoc">
        <bpmn:targetRef>do_supplement_info</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_split_create_issue" name="拆分事件创建问题工单">
      <bpmn:incoming>flow_gateway_yes</bpmn:incoming>
      <bpmn:outgoing>flow_split_to_relate</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="di_event_form" name="事件表单" />
        <bpmn:dataOutput id="do_issue_ticket_1" name="问题工单" />
        <bpmn:dataOutput id="do_related_info" name="关联信息" />
        <bpmn:dataOutput id="do_issue_ticket_2" name="问题工单" />
        <bpmn:inputSet id="is_split">
          <bpmn:dataInputRefs>di_event_form</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="os_split">
          <bpmn:dataOutputRefs>do_issue_ticket_1</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>do_related_info</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>do_issue_ticket_2</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="di_event_form_assoc">
        <bpmn:sourceRef>di_event_form</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="do_issue_ticket_1_assoc">
        <bpmn:targetRef>do_issue_ticket_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_auto_relate" name="问题工单自动关联相关信息">
      <bpmn:incoming>flow_split_to_relate</bpmn:incoming>
      <bpmn:outgoing>flow_relate_to_classify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_classify_level" name="问题分类定级">
      <bpmn:incoming>flow_relate_to_classify</bpmn:incoming>
      <bpmn:outgoing>flow_classify_to_approval</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="do_issue_ticket_3" name="问题工单" />
        <bpmn:dataOutput id="do_initial_conclusion" name="初判结论" />
        <bpmn:outputSet id="os_classify">
          <bpmn:dataOutputRefs>do_issue_ticket_3</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>do_initial_conclusion</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="do_issue_ticket_3_assoc">
        <bpmn:targetRef>do_issue_ticket_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_approval_confirm" name="审批确认">
      <bpmn:incoming>flow_classify_to_approval</bpmn:incoming>
      <bpmn:outgoing>flow_approval_to_review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_review_issue" name="审核问题工单" gatewayDirection="Diverging">
      <bpmn:incoming>flow_approval_to_review</bpmn:incoming>
      <bpmn:incoming>flow_approve_reject</bpmn:incoming>
      <bpmn:outgoing>flow_review_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_review_approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="event_receive_approval" name="收到销售经理批准的信息">
      <bpmn:incoming>flow_notify_to_receive</bpmn:incoming>
      <bpmn:outgoing>flow_receive_to_match</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="task_match_person" name="匹配人员">
      <bpmn:incoming>flow_receive_to_match</bpmn:incoming>
      <bpmn:outgoing>flow_match_to_dispatch</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="di_skill_matrix" name="技能矩阵" />
        <bpmn:dataOutput id="do_match_result" name="人员匹配结果" />
        <bpmn:inputSet id="is_match">
          <bpmn:dataInputRefs>di_skill_matrix</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="os_match">
          <bpmn:dataOutputRefs>do_match_result</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="di_skill_matrix_assoc">
        <bpmn:sourceRef>di_skill_matrix</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="do_match_result_assoc">
        <bpmn:targetRef>do_match_result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_dispatch_ticket" name="分派工单">
      <bpmn:incoming>flow_match_to_dispatch</bpmn:incoming>
      <bpmn:outgoing>flow_dispatch_to_merge</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="do_dispatch_notice" name="分派通知" />
        <bpmn:outputSet id="os_dispatch">
          <bpmn:dataOutputRefs>do_dispatch_notice</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="do_dispatch_notice_assoc">
        <bpmn:targetRef>do_dispatch_notice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_merge_director" gatewayDirection="Converging">
      <bpmn:incoming>flow_dispatch_to_merge</bpmn:incoming>
      <bpmn:outgoing>flow_merge_to_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_fast_solution" name="执行快速解决方案">
      <bpmn:incoming>flow_merge_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gateway_approve_issue" name="审批问题工单" gatewayDirection="Diverging">
      <bpmn:incoming>flow_review_approve</bpmn:incoming>
      <bpmn:outgoing>flow_approve_reject</bpmn:outgoing>
      <bpmn:outgoing>flow_approve_pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="event_after_approval">
      <bpmn:incoming>flow_approve_pass</bpmn:incoming>
      <bpmn:outgoing>flow_after_to_notify</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="task_notify_ceo" name="重要紧急问题抄送品管和CEO">
      <bpmn:incoming>flow_after_to_notify</bpmn:incoming>
      <bpmn:outgoing>flow_notify_to_receive</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="do_email" name="邮件" />
        <bpmn:outputSet id="os_notify">
          <bpmn:dataOutputRefs>do_email</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="do_email_assoc">
        <bpmn:targetRef>do_email</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="flow_start_to_create" sourceRef="start_voc" targetRef="task_create_event" />
    <bpmn:sequenceFlow id="flow_create_to_gateway" sourceRef="task_create_event" targetRef="gateway_info_complete" />
    <bpmn:sequenceFlow id="flow_gateway_no" name="否" sourceRef="gateway_info_complete" targetRef="task_supplement_info" />
    <bpmn:sequenceFlow id="flow_supplement_to_gateway" sourceRef="task_supplement_info" targetRef="gateway_info_complete" />
    <bpmn:sequenceFlow id="flow_gateway_yes" name="是" sourceRef="gateway_info_complete" targetRef="task_split_create_issue" />
    <bpmn:sequenceFlow id="flow_split_to_relate" sourceRef="task_split_create_issue" targetRef="task_auto_relate" />
    <bpmn:sequenceFlow id="flow_relate_to_classify" sourceRef="task_auto_relate" targetRef="task_classify_level" />
    <bpmn:sequenceFlow id="flow_classify_to_approval" sourceRef="task_classify_level" targetRef="task_approval_confirm" />
    <bpmn:sequenceFlow id="flow_approval_to_review" sourceRef="task_approval_confirm" targetRef="gateway_review_issue" />
    <bpmn:sequenceFlow id="flow_review_reject" name="拒绝" sourceRef="gateway_review_issue" targetRef="task_create_event" />
    <bpmn:sequenceFlow id="flow_review_approve" name="批准" sourceRef="gateway_review_issue" targetRef="gateway_approve_issue" />
    <bpmn:sequenceFlow id="flow_approve_reject" name="拒绝" sourceRef="gateway_approve_issue" targetRef="gateway_review_issue" />
    <bpmn:sequenceFlow id="flow_approve_pass" name="批准" sourceRef="gateway_approve_issue" targetRef="event_after_approval" />
    <bpmn:sequenceFlow id="flow_after_to_notify" sourceRef="event_after_approval" targetRef="task_notify_ceo" />
    <bpmn:sequenceFlow id="flow_notify_to_receive" sourceRef="task_notify_ceo" targetRef="event_receive_approval" />
    <bpmn:sequenceFlow id="flow_receive_to_match" sourceRef="event_receive_approval" targetRef="task_match_person" />
    <bpmn:sequenceFlow id="flow_match_to_dispatch" sourceRef="task_match_person" targetRef="task_dispatch_ticket" />
    <bpmn:sequenceFlow id="flow_dispatch_to_merge" sourceRef="task_dispatch_ticket" targetRef="gateway_merge_director" />
    <bpmn:sequenceFlow id="flow_merge_to_end" sourceRef="gateway_merge_director" targetRef="end_fast_solution" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_crm_voc" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_crm_voc" bpmnElement="collaboration_crm">
      <bpmndi:BPMNShape id="collaboration_crm_di" bpmnElement="collaboration_crm">
        <dc:Bounds x="0" y="0" width="2310" height="1595" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_crm_di" bpmnElement="pool_crm" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2310" height="1595" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_sales_support_di" bpmnElement="lane_sales_support" isHorizontal="true">
        <dc:Bounds x="30" y="166" width="2280" height="663" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_voc_di" bpmnElement="start_voc">
        <dc:Bounds x="62" y="204" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="30" y="244" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
