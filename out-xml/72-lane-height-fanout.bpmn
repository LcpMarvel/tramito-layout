<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_lane_height_fanout" targetNamespace="http://example.com/test-lane-height-fanout" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="年度审计六路并行">
    <bpmn:participant id="pool_audit" name="审计事务所" processRef="process_audit" />
  </bpmn:collaboration>
  <bpmn:process id="process_audit" name="审计事务所" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_partner" name="项目合伙人">
        <bpmn:flowNodeRef>start_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_field_team" name="现场审计组">
        <bpmn:flowNodeRef>gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_cash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_receivable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_fixed_asset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_revenue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_expense</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_quality" name="质控复核">
        <bpmn:flowNodeRef>task_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_audit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_audit" name="审计立项">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_plan" name="制定审计计划">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gw_split" name="分组并行">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_fan_1</bpmn:outgoing>
      <bpmn:outgoing>flow_fan_2</bpmn:outgoing>
      <bpmn:outgoing>flow_fan_3</bpmn:outgoing>
      <bpmn:outgoing>flow_fan_4</bpmn:outgoing>
      <bpmn:outgoing>flow_fan_5</bpmn:outgoing>
      <bpmn:outgoing>flow_fan_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="task_cash" name="货币资金盘点">
      <bpmn:incoming>flow_fan_1</bpmn:incoming>
      <bpmn:outgoing>flow_join_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_receivable" name="应收账款函证">
      <bpmn:incoming>flow_fan_2</bpmn:incoming>
      <bpmn:outgoing>flow_join_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_inventory" name="存货监盘">
      <bpmn:incoming>flow_fan_3</bpmn:incoming>
      <bpmn:outgoing>flow_join_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_fixed_asset" name="固定资产抽查">
      <bpmn:incoming>flow_fan_4</bpmn:incoming>
      <bpmn:outgoing>flow_join_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_revenue" name="收入截止测试">
      <bpmn:incoming>flow_fan_5</bpmn:incoming>
      <bpmn:outgoing>flow_join_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_expense" name="费用凭证抽凭">
      <bpmn:incoming>flow_fan_6</bpmn:incoming>
      <bpmn:outgoing>flow_join_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gw_join" name="汇总底稿">
      <bpmn:incoming>flow_join_1</bpmn:incoming>
      <bpmn:incoming>flow_join_2</bpmn:incoming>
      <bpmn:incoming>flow_join_3</bpmn:incoming>
      <bpmn:incoming>flow_join_4</bpmn:incoming>
      <bpmn:incoming>flow_join_5</bpmn:incoming>
      <bpmn:incoming>flow_join_6</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="task_review" name="质控复核底稿">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_audit" name="出具报告">
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_audit" targetRef="task_plan" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_plan" targetRef="gw_split" />
    <bpmn:sequenceFlow id="flow_fan_1" sourceRef="gw_split" targetRef="task_cash" />
    <bpmn:sequenceFlow id="flow_fan_2" sourceRef="gw_split" targetRef="task_receivable" />
    <bpmn:sequenceFlow id="flow_fan_3" sourceRef="gw_split" targetRef="task_inventory" />
    <bpmn:sequenceFlow id="flow_fan_4" sourceRef="gw_split" targetRef="task_fixed_asset" />
    <bpmn:sequenceFlow id="flow_fan_5" sourceRef="gw_split" targetRef="task_revenue" />
    <bpmn:sequenceFlow id="flow_fan_6" sourceRef="gw_split" targetRef="task_expense" />
    <bpmn:sequenceFlow id="flow_join_1" sourceRef="task_cash" targetRef="gw_join" />
    <bpmn:sequenceFlow id="flow_join_2" sourceRef="task_receivable" targetRef="gw_join" />
    <bpmn:sequenceFlow id="flow_join_3" sourceRef="task_inventory" targetRef="gw_join" />
    <bpmn:sequenceFlow id="flow_join_4" sourceRef="task_fixed_asset" targetRef="gw_join" />
    <bpmn:sequenceFlow id="flow_join_5" sourceRef="task_revenue" targetRef="gw_join" />
    <bpmn:sequenceFlow id="flow_join_6" sourceRef="task_expense" targetRef="gw_join" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="gw_join" targetRef="task_review" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="task_review" targetRef="end_audit" />
  </bpmn:process>
