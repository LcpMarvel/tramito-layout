<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_default_flows_dense" targetNamespace="http://example.com/test-default-flows-dense" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_default_dense" name="密集默认流工单分派" isExecutable="true">
    <bpmn:startEvent id="start_1" name="工单创建">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_urgent" name="紧急程度" gatewayDirection="Diverging" default="flow_urgent_default">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_urgent_hit</bpmn:outgoing>
      <bpmn:outgoing>flow_urgent_default</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_urgent" name="紧急通道处理">
      <bpmn:incoming>flow_urgent_hit</bpmn:incoming>
      <bpmn:outgoing>flow_urgent_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_vip" name="客户等级" gatewayDirection="Diverging" default="flow_vip_default">
      <bpmn:incoming>flow_urgent_default</bpmn:incoming>
      <bpmn:outgoing>flow_vip_hit</bpmn:outgoing>
      <bpmn:outgoing>flow_vip_default</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_vip" name="VIP专员跟进">
      <bpmn:incoming>flow_vip_hit</bpmn:incoming>
      <bpmn:outgoing>flow_vip_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_category" name="问题类别" gatewayDirection="Diverging" default="flow_category_default">
      <bpmn:incoming>flow_vip_default</bpmn:incoming>
      <bpmn:outgoing>flow_category_tech</bpmn:outgoing>
      <bpmn:outgoing>flow_category_default</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_tech" name="技术组处理">
      <bpmn:incoming>flow_category_tech</bpmn:incoming>
      <bpmn:outgoing>flow_tech_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_general" name="普通客服处理">
      <bpmn:incoming>flow_category_default</bpmn:incoming>
      <bpmn:outgoing>flow_general_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_merge" name="处理汇合" gatewayDirection="Converging">
      <bpmn:incoming>flow_urgent_merge</bpmn:incoming>
      <bpmn:incoming>flow_vip_merge</bpmn:incoming>
      <bpmn:incoming>flow_tech_merge</bpmn:incoming>
      <bpmn:incoming>flow_general_merge</bpmn:incoming>
      <bpmn:outgoing>flow_to_feedback</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_feedback" name="回访满意度">
      <bpmn:incoming>flow_to_feedback</bpmn:incoming>
      <bpmn:outgoing>flow_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_1" name="工单关闭">
      <bpmn:incoming>flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_1" targetRef="gw_urgent" />
    <bpmn:sequenceFlow id="flow_urgent_hit" name="特急工单" sourceRef="gw_urgent" targetRef="task_urgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${priority == 'urgent'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_urgent_default" name="常规优先级" sourceRef="gw_urgent" targetRef="gw_vip" />
    <bpmn:sequenceFlow id="flow_vip_hit" name="VIP客户" sourceRef="gw_vip" targetRef="task_vip">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${level == 'vip'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_vip_default" name="普通客户" sourceRef="gw_vip" targetRef="gw_category" />
    <bpmn:sequenceFlow id="flow_category_tech" name="技术问题" sourceRef="gw_category" targetRef="task_tech">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${category == 'tech'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_category_default" name="其他问题" sourceRef="gw_category" targetRef="task_general" />
    <bpmn:sequenceFlow id="flow_urgent_merge" sourceRef="task_urgent" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="flow_vip_merge" sourceRef="task_vip" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="flow_tech_merge" sourceRef="task_tech" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="flow_general_merge" sourceRef="task_general" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="flow_to_feedback" sourceRef="gw_merge" targetRef="task_feedback" />
    <bpmn:sequenceFlow id="flow_to_end" sourceRef="task_feedback" targetRef="end_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_default_flows_dense" name="BPMNDiagram">
