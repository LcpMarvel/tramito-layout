      <bpmndi:BPMNShape id="payment_end_di" bpmnElement="payment_end">
        <dc:Bounds x="746" y="106" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="714" y="146" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundary_payment_error_di" bpmnElement="boundary_payment_error">
        <dc:Bounds x="180" y="178" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="171" y="218" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ship_di" bpmnElement="task_ship">
        <dc:Bounds x="894" y="74" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_main_di" bpmnElement="end_main">
        <dc:Bounds x="1074" y="96" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1042" y="136" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_log_failure_di" bpmnElement="task_log_failure">
        <dc:Bounds x="-90" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_refund_di" bpmnElement="sub_refund" isExpanded="true">
        <dc:Bounds x="110" y="308" width="636" height="164" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_notify_customer_di" bpmnElement="task_notify_customer">
        <dc:Bounds x="846" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_failure_di" bpmnElement="end_failure">
        <dc:Bounds x="1046" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1014" y="412" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="payment_flow_1_di" bpmnElement="payment_flow_1">
        <di:waypoint x="246" y="124" />
        <di:waypoint x="346" y="124" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="payment_flow_2_di" bpmnElement="payment_flow_2">
        <di:waypoint x="446" y="124" />
        <di:waypoint x="546" y="124" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="payment_flow_3_di" bpmnElement="payment_flow_3">
