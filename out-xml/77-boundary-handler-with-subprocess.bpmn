<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_boundary_handler_with_subprocess" targetNamespace="http://example.com/test-boundary-handler-with-subprocess" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:error id="err_payment" name="支付失败" errorCode="PAY_ERR_001" />
  <bpmn:process id="process_order_payment" name="订单支付（边界处理链含子流程）" isExecutable="true">
    <bpmn:startEvent id="start_main" name="提交订单">
      <bpmn:outgoing>main_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="sub_payment" name="支付处理">
      <bpmn:incoming>main_flow_1</bpmn:incoming>
      <bpmn:outgoing>main_flow_2</bpmn:outgoing>
      <bpmn:startEvent id="payment_start" name="开始支付">
        <bpmn:outgoing>payment_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="payment_task_deduct" name="调用支付网关">
        <bpmn:incoming>payment_flow_1</bpmn:incoming>
        <bpmn:outgoing>payment_flow_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="payment_task_verify" name="核验支付结果">
        <bpmn:incoming>payment_flow_2</bpmn:incoming>
        <bpmn:outgoing>payment_flow_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="payment_end" name="支付成功">
        <bpmn:incoming>payment_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="payment_flow_1" sourceRef="payment_start" targetRef="payment_task_deduct" />
      <bpmn:sequenceFlow id="payment_flow_2" sourceRef="payment_task_deduct" targetRef="payment_task_verify" />
      <bpmn:sequenceFlow id="payment_flow_3" sourceRef="payment_task_verify" targetRef="payment_end" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="boundary_payment_error" name="支付失败" attachedToRef="sub_payment">
      <bpmn:outgoing>handler_flow_1</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="err_payment" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="task_ship" name="安排发货">
      <bpmn:incoming>main_flow_2</bpmn:incoming>
      <bpmn:outgoing>main_flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_main" name="订单完成">
      <bpmn:incoming>main_flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_log_failure" name="记录支付异常">
      <bpmn:incoming>handler_flow_1</bpmn:incoming>
      <bpmn:outgoing>handler_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="sub_refund" name="退款处理">
      <bpmn:incoming>handler_flow_2</bpmn:incoming>
      <bpmn:outgoing>handler_flow_3</bpmn:outgoing>
      <bpmn:startEvent id="refund_start" name="开始退款">
        <bpmn:outgoing>refund_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="refund_task_freeze" name="冻结订单">
        <bpmn:incoming>refund_flow_1</bpmn:incoming>
        <bpmn:outgoing>refund_flow_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="refund_task_return" name="退回已扣款项">
        <bpmn:incoming>refund_flow_2</bpmn:incoming>
        <bpmn:outgoing>refund_flow_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="refund_end" name="退款完成">
        <bpmn:incoming>refund_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="refund_flow_1" sourceRef="refund_start" targetRef="refund_task_freeze" />
      <bpmn:sequenceFlow id="refund_flow_2" sourceRef="refund_task_freeze" targetRef="refund_task_return" />
      <bpmn:sequenceFlow id="refund_flow_3" sourceRef="refund_task_return" targetRef="refund_end" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="task_notify_customer" name="通知客户">
      <bpmn:incoming>handler_flow_3</bpmn:incoming>
      <bpmn:outgoing>handler_flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_failure" name="订单关闭">
      <bpmn:incoming>handler_flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="main_flow_1" sourceRef="start_main" targetRef="sub_payment" />
    <bpmn:sequenceFlow id="main_flow_2" sourceRef="sub_payment" targetRef="task_ship" />
    <bpmn:sequenceFlow id="main_flow_3" sourceRef="task_ship" targetRef="end_main" />
    <bpmn:sequenceFlow id="handler_flow_1" sourceRef="boundary_payment_error" targetRef="task_log_failure" />
    <bpmn:sequenceFlow id="handler_flow_2" sourceRef="task_log_failure" targetRef="sub_refund" />
    <bpmn:sequenceFlow id="handler_flow_3" sourceRef="sub_refund" targetRef="task_notify_customer" />
    <bpmn:sequenceFlow id="handler_flow_4" sourceRef="task_notify_customer" targetRef="end_failure" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_boundary_handler_with_subprocess" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_boundary_handler_with_subprocess" bpmnElement="process_order_payment">
      <bpmndi:BPMNShape id="process_order_payment_di" bpmnElement="process_order_payment">
        <dc:Bounds x="0" y="0" width="1130" height="512" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_main_di" bpmnElement="start_main">
        <dc:Bounds x="62" y="96" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="30" y="136" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_payment_di" bpmnElement="sub_payment" isExpanded="true">
        <dc:Bounds x="178" y="32" width="636" height="164" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payment_start_di" bpmnElement="payment_start">
        <dc:Bounds x="210" y="106" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="178" y="146" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payment_task_deduct_di" bpmnElement="payment_task_deduct">
        <dc:Bounds x="346" y="84" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payment_task_verify_di" bpmnElement="payment_task_verify">
        <dc:Bounds x="546" y="84" width="100" height="80" />
