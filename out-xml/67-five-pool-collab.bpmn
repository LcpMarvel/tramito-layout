<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_five_pool_collab" targetNamespace="http://example.com/test-five-pool-collab" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="五方供应链协作">
    <bpmn:participant id="pool_customer" name="客户" processRef="process_customer" />
    <bpmn:participant id="pool_store" name="门店" processRef="process_store" />
    <bpmn:participant id="pool_region" name="区域中心" processRef="process_region" />
    <bpmn:participant id="pool_hq" name="总部" processRef="process_hq" />
    <bpmn:participant id="pool_logistics" name="物流公司" processRef="process_logistics" />
    <bpmn:messageFlow id="msgflow_order" name="订单" sourceRef="task_place_order" targetRef="start_store" />
    <bpmn:messageFlow id="msgflow_transfer" name="调拨单" sourceRef="task_store_forward" targetRef="start_region" />
    <bpmn:messageFlow id="msgflow_report" name="调拨上报" sourceRef="task_region_report" targetRef="start_hq" />
    <bpmn:messageFlow id="msgflow_dispatch" name="运单" sourceRef="task_hq_dispatch" targetRef="start_logistics" />
    <bpmn:messageFlow id="msgflow_deliver" name="送达通知" sourceRef="task_deliver" targetRef="task_receive_goods" />
    <bpmn:messageFlow id="msgflow_hq_notify_customer" name="发货短信" sourceRef="task_hq_dispatch" targetRef="task_receive_goods" />
    <bpmn:messageFlow id="msgflow_store_notify_logistics" name="门店自提信息" sourceRef="task_store_forward" targetRef="task_deliver" />
  </bpmn:collaboration>
  <bpmn:process id="process_customer" name="客户" isExecutable="true">
    <bpmn:startEvent id="start_customer" name="产生需求">
      <bpmn:outgoing>flow_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="task_place_order" name="下单">
      <bpmn:incoming>flow_c1</bpmn:incoming>
      <bpmn:outgoing>flow_c2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="task_receive_goods" name="收货签收">
      <bpmn:incoming>flow_c2</bpmn:incoming>
      <bpmn:outgoing>flow_c3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="end_customer" name="购买完成">
      <bpmn:incoming>flow_c3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_c1" sourceRef="start_customer" targetRef="task_place_order" />
    <bpmn:sequenceFlow id="flow_c2" sourceRef="task_place_order" targetRef="task_receive_goods" />
    <bpmn:sequenceFlow id="flow_c3" sourceRef="task_receive_goods" targetRef="end_customer" />
  </bpmn:process>
  <bpmn:process id="process_store" name="门店" isExecutable="true">
    <bpmn:startEvent id="start_store" name="收到订单">
      <bpmn:outgoing>flow_s1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="task_store_forward" name="转交区域中心">
      <bpmn:incoming>flow_s1</bpmn:incoming>
      <bpmn:outgoing>flow_s2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_store" name="门店处理完">
      <bpmn:incoming>flow_s2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_s1" sourceRef="start_store" targetRef="task_store_forward" />
    <bpmn:sequenceFlow id="flow_s2" sourceRef="task_store_forward" targetRef="end_store" />
  </bpmn:process>
  <bpmn:process id="process_region" name="区域中心" isExecutable="true">
    <bpmn:startEvent id="start_region" name="收到调拨单">
      <bpmn:outgoing>flow_r1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="task_region_alloc" name="库存调拨">
      <bpmn:incoming>flow_r1</bpmn:incoming>
      <bpmn:outgoing>flow_r2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="task_region_report" name="上报总部">
      <bpmn:incoming>flow_r2</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="flow_r1" sourceRef="start_region" targetRef="task_region_alloc" />
    <bpmn:sequenceFlow id="flow_r2" sourceRef="task_region_alloc" targetRef="task_region_report" />
  </bpmn:process>
  <bpmn:process id="process_hq" name="总部" isExecutable="true">
    <bpmn:startEvent id="start_hq" name="收到上报">
      <bpmn:outgoing>flow_h1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="task_hq_dispatch" name="派发物流指令">
      <bpmn:incoming>flow_h1</bpmn:incoming>
      <bpmn:outgoing>flow_h2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_hq" name="指令下发完">
      <bpmn:incoming>flow_h2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_h1" sourceRef="start_hq" targetRef="task_hq_dispatch" />
    <bpmn:sequenceFlow id="flow_h2" sourceRef="task_hq_dispatch" targetRef="end_hq" />
  </bpmn:process>
  <bpmn:process id="process_logistics" name="物流公司" isExecutable="true">
    <bpmn:startEvent id="start_logistics" name="收到运单">
      <bpmn:outgoing>flow_l1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:sendTask id="task_deliver" name="配送上门">
      <bpmn:incoming>flow_l1</bpmn:incoming>
      <bpmn:outgoing>flow_l2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_logistics" name="配送完成">
      <bpmn:incoming>flow_l2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_l1" sourceRef="start_logistics" targetRef="task_deliver" />
    <bpmn:sequenceFlow id="flow_l2" sourceRef="task_deliver" targetRef="end_logistics" />
  </bpmn:process>
