<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_approval_reject_merge" targetNamespace="http://example.com/approval-reject-merge" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:collaboration id="collaboration_1" name="审批驳回归一">
    <bpmn:participant id="pool_company" name="公司" processRef="process_company" />
  </bpmn:collaboration>
  <bpmn:process id="process_company" name="公司" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_applicant" name="申请人">
        <bpmn:flowNodeRef>start_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_dept" name="部门主管">
        <bpmn:flowNodeRef>task_dept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_dept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_manager" name="经理">
        <bpmn:flowNodeRef>task_mgr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_mgr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_finance" name="财务">
        <bpmn:flowNodeRef>task_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_gm" name="总经理">
        <bpmn:flowNodeRef>task_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_apply" name="发起申请">
      <bpmn:outgoing>f_start_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit" name="提交申请单">
      <bpmn:incoming>f_start_submit</bpmn:incoming>
      <bpmn:incoming>f_dept_reject</bpmn:incoming>
      <bpmn:incoming>f_mgr_reject</bpmn:incoming>
      <bpmn:incoming>f_fin_reject</bpmn:incoming>
      <bpmn:incoming>f_gm_reject</bpmn:incoming>
      <bpmn:outgoing>f_submit_dept</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_dept" name="部门审核">
      <bpmn:incoming>f_submit_dept</bpmn:incoming>
      <bpmn:outgoing>f_dept_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_dept" name="审核通过">
      <bpmn:incoming>f_dept_gw</bpmn:incoming>
      <bpmn:outgoing>f_dept_pass</bpmn:outgoing>
      <bpmn:outgoing>f_dept_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_mgr" name="经理复核">
      <bpmn:incoming>f_dept_pass</bpmn:incoming>
      <bpmn:outgoing>f_mgr_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_mgr" name="审核通过">
      <bpmn:incoming>f_mgr_gw</bpmn:incoming>
      <bpmn:outgoing>f_mgr_pass</bpmn:outgoing>
      <bpmn:outgoing>f_mgr_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_fin" name="财务审核">
      <bpmn:incoming>f_mgr_pass</bpmn:incoming>
      <bpmn:outgoing>f_fin_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_fin" name="审核通过">
      <bpmn:incoming>f_fin_gw</bpmn:incoming>
      <bpmn:outgoing>f_fin_pass</bpmn:outgoing>
      <bpmn:outgoing>f_fin_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_gm" name="总经理审批">
      <bpmn:incoming>f_fin_pass</bpmn:incoming>
      <bpmn:outgoing>f_gm_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_gm" name="审批通过">
      <bpmn:incoming>f_gm_gw</bpmn:incoming>
      <bpmn:outgoing>f_gm_pass</bpmn:outgoing>
      <bpmn:outgoing>f_gm_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_archive" name="归档">
      <bpmn:incoming>f_gm_pass</bpmn:incoming>
      <bpmn:outgoing>f_archive_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_done" name="结束">
      <bpmn:incoming>f_archive_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_submit" sourceRef="start_apply" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_submit_dept" sourceRef="task_submit" targetRef="task_dept" />
    <bpmn:sequenceFlow id="f_dept_gw" sourceRef="task_dept" targetRef="gw_dept" />
    <bpmn:sequenceFlow id="f_dept_pass" name="通过" sourceRef="gw_dept" targetRef="task_mgr" />
    <bpmn:sequenceFlow id="f_dept_reject" name="驳回" sourceRef="gw_dept" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_mgr_gw" sourceRef="task_mgr" targetRef="gw_mgr" />
    <bpmn:sequenceFlow id="f_mgr_pass" name="通过" sourceRef="gw_mgr" targetRef="task_fin" />
    <bpmn:sequenceFlow id="f_mgr_reject" name="驳回" sourceRef="gw_mgr" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_fin_gw" sourceRef="task_fin" targetRef="gw_fin" />
    <bpmn:sequenceFlow id="f_fin_pass" name="通过" sourceRef="gw_fin" targetRef="task_gm" />
    <bpmn:sequenceFlow id="f_fin_reject" name="驳回" sourceRef="gw_fin" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_gm_gw" sourceRef="task_gm" targetRef="gw_gm" />
    <bpmn:sequenceFlow id="f_gm_pass" name="通过" sourceRef="gw_gm" targetRef="task_archive" />
    <bpmn:sequenceFlow id="f_gm_reject" name="驳回" sourceRef="gw_gm" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f_archive_end" sourceRef="task_archive" targetRef="end_done" />
  </bpmn:process>
