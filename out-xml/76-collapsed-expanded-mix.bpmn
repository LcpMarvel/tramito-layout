<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_collapsed_expanded_mix" targetNamespace="http://example.com/test-collapsed-expanded-mix" exporter="ELK-BPMN Test Generator" exporterVersion="1.0">
  <bpmn:process id="process_onboarding" name="员工入职（折叠/展开交替）" isExecutable="true">
    <bpmn:startEvent id="start_main" name="录用确认">
      <bpmn:outgoing>main_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="sub_background_check" name="背景调查">
      <bpmn:incoming>main_flow_1</bpmn:incoming>
      <bpmn:outgoing>main_flow_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="sub_profile_entry" name="资料录入">
      <bpmn:incoming>main_flow_2</bpmn:incoming>
      <bpmn:outgoing>main_flow_3</bpmn:outgoing>
      <bpmn:startEvent id="profile_start" name="开始录入">
        <bpmn:outgoing>profile_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="profile_task_collect" name="收集证件资料">
        <bpmn:incoming>profile_flow_1</bpmn:incoming>
        <bpmn:outgoing>profile_flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="profile_task_entry" name="录入人事系统">
        <bpmn:incoming>profile_flow_2</bpmn:incoming>
        <bpmn:outgoing>profile_flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="profile_end" name="录入完成">
        <bpmn:incoming>profile_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="profile_flow_1" sourceRef="profile_start" targetRef="profile_task_collect" />
      <bpmn:sequenceFlow id="profile_flow_2" sourceRef="profile_task_collect" targetRef="profile_task_entry" />
      <bpmn:sequenceFlow id="profile_flow_3" sourceRef="profile_task_entry" targetRef="profile_end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="sub_access_grant" name="权限开通">
      <bpmn:incoming>main_flow_3</bpmn:incoming>
      <bpmn:outgoing>main_flow_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="sub_training" name="入职培训">
      <bpmn:incoming>main_flow_4</bpmn:incoming>
      <bpmn:outgoing>main_flow_5</bpmn:outgoing>
      <bpmn:startEvent id="training_start" name="开始培训">
        <bpmn:outgoing>training_flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="training_task_course" name="学习企业文化课">
        <bpmn:incoming>training_flow_1</bpmn:incoming>
        <bpmn:outgoing>training_flow_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="training_task_exam" name="完成安全考试">
        <bpmn:incoming>training_flow_2</bpmn:incoming>
        <bpmn:outgoing>training_flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="training_end" name="培训完成">
        <bpmn:incoming>training_flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="training_flow_1" sourceRef="training_start" targetRef="training_task_course" />
      <bpmn:sequenceFlow id="training_flow_2" sourceRef="training_task_course" targetRef="training_task_exam" />
      <bpmn:sequenceFlow id="training_flow_3" sourceRef="training_task_exam" targetRef="training_end" />
    </bpmn:subProcess>
    <bpmn:endEvent id="end_main" name="入职完成">
      <bpmn:incoming>main_flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="main_flow_1" sourceRef="start_main" targetRef="sub_background_check" />
    <bpmn:sequenceFlow id="main_flow_2" sourceRef="sub_background_check" targetRef="sub_profile_entry" />
    <bpmn:sequenceFlow id="main_flow_3" sourceRef="sub_profile_entry" targetRef="sub_access_grant" />
    <bpmn:sequenceFlow id="main_flow_4" sourceRef="sub_access_grant" targetRef="sub_training" />
    <bpmn:sequenceFlow id="main_flow_5" sourceRef="sub_training" targetRef="end_main" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_collapsed_expanded_mix" name="BPMNDiagram">
